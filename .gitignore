# ---------------------------------------------------------------------------
# NOTHING FROM THE GAME, THE FIRMWARE OR SONY GOES IN THIS REPOSITORY.
# Everything below is generated locally from the player's own disc.
# ---------------------------------------------------------------------------

# Toolkit checkout (tools/setup_toolkit.sh recreates it)
/ps3recomp/
/.venv/

# Disc images, executables, metadata
*.iso
*.ISO
*.BIN
*.bin
*.elf
*.ELF
*.self
*.SELF
*.sprx
*.SPRX
*.prx
*.PRX
*.SFO
*.sfo
*.psarc
*.PSARC
*.pkg
*.PKG
*.PUP
*.pup
*.edat
*.EDAT
*.sdat
*.SDAT
*.SFB
*.sfb

# Decrypted game files, captured modules, analysis and lifted output
game/
modules/
analysis/
recompiled/
build/
spu_images/
jobmods/
missed/
# The disc, when extracted rather than mounted
PS3_GAME/
PS3_UPDATE/
# Lifted SPU code and the raw SPU bytes it is lifted from are game code:
# regenerate them with tools/rebuild.sh spu, never commit them.
# (port/patches/eboot_<version>.insn.json and .words.h are the few words the
# community FPS/FOV patches touch, as the Resistance: Fall of Man port keeps
# its insn.json; they are generated by tools/r3_survey.py --write-insn.)
port/spu/*/spu_recomp.c
port/spu/*/spu_recomp.h
port/spu/*/image.bin
port/spu/*/functions.json
port/spu/*/lift.json
port/spu/jobmods/
port/spu/relocmods/
port/spu/images/
port/spu/raw_dump/
port/spu/captured/
# Generated beside the lifted code by tools/prepare_r3_*.py and the job-module
# and relocatable-module tools
port/spu/jobmods_register.c
port/spu/jobmods_manifest.json
generated_spu/
ppu_hle_nids.cpp
port/recompiled/

# Firmware and keys
fw/
dev_flash/
dev_flash*/
*.keys
*.KEYS
*.rap
*.RAP
*.rif
*.act.dat
idps*
act.dat

# Saves, installed game data, run directories
saves/
gamedata/
dev_hdd0/
dev_hdd1/
dev_bdvd/
vfs/
out/
runs/
*.cwd/
*.sav
*.SAV
*.done

# Frame dumps, captures and logs
*.ppm
*.wav
*.log
*.sample
*.trace
game.pid
pad

# Launcher build output
launcher/node_modules/
launcher/dist/
launcher/src-tauri/target/
launcher/src-tauri/gen/

# Editor / OS noise
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc

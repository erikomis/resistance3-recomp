+typedef enum {
+    SPU_F_NONE,  /* no immediate: RRR, RR (except stop), LSX, channel ops, .word */
+    SPU_F_I18,  /* ila: full 18-bit immediate */
+    SPU_F_I18LO,  /* other RI18 (hbra/hbrr): low 16 bits of the 18-bit field */
+    SPU_F_LQA,  /* lqa/stqa: absolute 16-byte aligned LS address in tgt */
+    SPU_F_LQR,  /* lqr/stqr: pc-relative 16-byte aligned LS address in tgt */
+    SPU_F_BREL,  /* br/brsl/brz/brnz/brhz/brhnz: pc-relative target in tgt */
+    SPU_F_BABS,  /* bra/brasl: absolute target in tgt */
+    SPU_F_I16S,  /* il: sign-extended 16-bit immediate */
+    SPU_F_I16U,  /* ilh/ilhu/iohl/fsmbi: zero-extended 16-bit immediate */
+    SPU_F_I10,  /* RI10: sign-extended 10-bit immediate */
+    SPU_F_I10Q,  /* lqd/stqd: sign-extended 10-bit immediate scaled by 16 */
+    SPU_F_I8,  /* RI8 float<->int conversions: unsigned 8-bit scale */
+    SPU_F_STOP,  /* stop: 14-bit signal type */
+    SPU_F_I7S,  /* RI7: sign-extended 7-bit immediate */
+    SPU_F_I7U,  /* cbd/chd/cwd/cdd: unsigned 7-bit immediate */
+} spu_decode_form;
 

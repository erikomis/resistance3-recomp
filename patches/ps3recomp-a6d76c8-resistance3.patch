+/* ---- draw accumulation --------------------------------------------------- */
+
+static void dc_reset(void)
+{
+    dc.n_arr = dc.n_idx = dc.n_packets = 0;
+    dc.n_refs = dc.n_source_refs = dc.n_verts = dc.n_cuts = 0;
+    dc.refs_remapped = 0;
+    dc.vbuf = 0;
+    dc.n_streams = 0;
+    dc.stream_map = 0;
+    dc.fetch_ok = 1;
+    dc.inl = NULL;
+    dc.inl_bytes = 0;
+    dc.n_immediate = 0;
+}
+
+static int dc_push_ref(u32 vertex_id, u32 base_index)
+{
+    if (dc.n_refs >= dc.cap_refs) {
+        const u32 next = dc.cap_refs ? dc.cap_refs * 2u : 4096u;
+        rsx_vertex_ref* r = (rsx_vertex_ref*)realloc(dc.refs,
+                                                     (size_t)next * sizeof(*r));
+        if (!r) return 0;
+        dc.refs = r;
+        dc.cap_refs = next;
+    }
+    dc.refs[dc.n_refs].vertex_id = vertex_id;
+    dc.refs[dc.n_refs].base_index = base_index;
+    dc.n_refs++;
+    return 1;
+}
+
+/* Room for `more` references beyond dc.n_refs. */
+static int dc_reserve_refs(u32 more)
+{
+    const u64 need = (u64)dc.n_refs + more;
+    if (need <= dc.cap_refs) return 1;
+    if (need > 0xFFFFFFFFull) return 0;
+    u64 next = dc.cap_refs ? dc.cap_refs : 4096u;
+    while (next < need) next *= 2u;
+    if (next > 0xFFFFFFFFull) next = need;
+    rsx_vertex_ref* r = (rsx_vertex_ref*)realloc(dc.refs, (size_t)next * sizeof(*r));
+    if (!r) return 0;
+    dc.refs = r;
+    dc.cap_refs = (u32)next;
+    return 1;
+}
+
+/* A mapped run of big-endian indices into dc.refs (room already reserved),
+ * restart indices becoming cuts at the reference position they fall on.
+ * Out of line and specialised per width and restart mode, one load and a
+ * byte swap per index: assembling each index byte by byte with the width
+ * tested per index, and growing the reference list one push at a time, was
+ * 11.6% of the RSX thread in inFAMOUS 2 (fork 2b0def4d), and with the vertex
+ * cache it is paid by every draw, hits included. */
+#define DC_DECODE(T, BSWAP, RESTART)                                              \
+    for (u32 i = 0; i < count; i++) {                                             \
+        T raw; memcpy(&raw, run + (size_t)i * sizeof(T), sizeof(T));             \
+        const u32 index = (u32)BSWAP(raw);                                        \
+        if (RESTART && index == restart_val) {                                    \
+            if (!rsx_restart_cut_push(&dc.cuts, &dc.n_cuts, &dc.cap_cuts, n)) {   \
+                dc.n_refs = n; return 0;                                          \
+            }                                                                     \
+            continue;                                                             \
+        }                                                                         \
+        out[n].vertex_id = index;                                                 \
+        out[n].base_index = base_index;                                           \
+        n++;                                                                      \
+    }
+static __attribute__((noinline)) int dc_decode_indices(const u8* run, u32 count, int is_u32,
+                                                       int restart_en, u32 restart_val,
+                                                       u32 base_index)
+{
+    rsx_vertex_ref* const out = dc.refs;
+    u32 n = dc.n_refs;
+    if (is_u32) {
+        if (restart_en) { DC_DECODE(u32, __builtin_bswap32, 1) }
+        else            { DC_DECODE(u32, __builtin_bswap32, 0) }
+    } else {
+        if (restart_en) { DC_DECODE(u16, __builtin_bswap16, 1) }
+        else            { DC_DECODE(u16, __builtin_bswap16, 0) }
+    }
+    dc.n_refs = n;
+    return 1;
+}
+#undef DC_DECODE
+
+static int dc_reserve_verts(u64 bytes)
+{
+    if (bytes <= dc.verts_cap) return 1;
+    u64 next = dc.verts_cap ? dc.verts_cap : (1u << 20);
+    while (next < bytes) next *= 2u;
+    u8* v = (u8*)realloc(dc.verts, (size_t)next);
+    if (!v) return 0;
+    dc.verts = v;
+    dc.verts_cap = next;
+    return 1;
+}
+
+static int dc_reserve_indices(u32 count)
+{
+    if (count <= g.index_cap) return 1;
+    u32 next = g.index_cap ? g.index_cap : 4096u;
+    while (next < count) next *= 2u;
+    u32* p = (u32*)realloc(g.indices, (size_t)next * sizeof(u32));
+    if (!p) return 0;
+    g.indices = p;
+    g.index_cap = next;
+    return 1;
+}
+
+/* ---- vertex cache ---------------------------------------------------------
+ * Most of a frame's fetched vertices are static geometry whose guest bytes do
+ * not change from one frame to the next, yet every draw fetched, decoded and
+ * staged them again: dc_fetch was ~41% of Resistance's RSX thread and the
+ * dedup remap another ~13%. A draw over one consecutive run of vertices
+ * (rsx_vertex_remap_build_range, or a plain DRAW_ARRAYS) whose every enabled
+ * attribute maps one stable guest span is keyed on its layout, attribute
+ * formats and spans, and checked by a hash of those source bytes. When the
+ * same bytes are seen in two different frames the decoded vertices go into a
+ * persistent backend buffer (rsx_draw_backend.vbuf_create), and later draws
+ * with the same key and the same bytes draw from it. The bytes are hashed at
+ * every draw, so geometry the guest rewrites is fetched again, never drawn
+ * stale. A key whose bytes change three times running (skinned or streamed
+ * geometry) is not hashed again for 240 frames.
+ *   PS3RECOMP_ENG_VCACHE=0        off (every draw fetched, as before)
+ *   PS3RECOMP_ENG_VCACHE_PRUNE=0  a full key table starts over instead of
+ *                                 keeping what was drawn recently
+ *   PS3RECOMP_ENG_VCACHE_STATS=1  a counter line every 120 frames
+ * Ported from the inFAMOUS 2 port's toolkit fork. */
+typedef struct {
+    u64 key, content;
+    u32 vbuf, bytes, n, stride;
+    u32 last_frame, seen_frame, skip_until;
+    u64 sparse;             /* PS3RECOMP_ENG_VCACHE_SPARSE: sampled hash of the spans */
+    u32 full_frame;         /* frame the full content hash was last computed */
+    u32 change_frame;       /* PS3RECOMP_ENG_VCACHE_CHURN: frame of the last content change */
+    u32 ring_frame;         /* PS3RECOMP_ENG_VCACHE_FRAMEREUSE: g.frames + 1 of ring_off, else 0 */
+    u32 ring_off, ring_bytes;
+    u8 seen, changes;
+} eng_vc_entry;
+#define ENG_VC_SIZE   65536u
+#define ENG_VC_BUDGET (512ull << 20)
+#define ENG_VC_KEEP   60u     /* frames a key survives a prune undrawn */
+static eng_vc_entry s_vc[ENG_VC_SIZE];
+static eng_vc_entry s_vc_tmp[ENG_VC_SIZE];
+static u32 s_vc_cursor, s_vc_used;
+static u64 s_vc_bytes;
+static int s_vc_enabled = -1;    /* -1: not read yet */
+static int s_vc_prune_on = -1;
+static int s_vc_stats_on = -1;
+static int s_vc_split_enabled = -1;
+static u64 s_vc_hit, s_vc_miss, s_vc_skip, s_vc_new, s_vc_hashed;
+/* PS3RECOMP_ENG_VCACHE_STATS: why a probed key missed (whole draws and split
+ * streams together): never seen, bytes changed since the last sighting, seen
+ * already this frame (before it could be promoted), the same bytes in a later
+ * frame (promotion follows unless the budget or a churn count stops it),
+ * anything else (resident with another count or stride). */
+static u64 s_vcm_first, s_vcm_changed, s_vcm_same_frame, s_vcm_repeat, s_vcm_other;
+static u64 s_vc_reused;
+
+/* PS3RECOMP_ENG_VCACHE_FRAMEREUSE (default 1; =0 off): a key fetched
+ * in this frame and drawn again in the same frame with the same bytes draws
+ * the vertices decoded the first time. Resistance 2's SPU-built geometry
+ * lands at new addresses every frame and each piece is drawn about twice
+ * (the misses: ~55% keys never seen, ~45% the same key again in its frame,
+ * ~1% changed bytes), so the cache never holds it and the second draw paid
+ * the whole decode again. The first fetch is copied into a per-frame ring
+ * (64 MB, reused from the start each frame; the backend copies a draw's
+ * vertices when the draw is recorded), the second points the draw at it.
+ * A/B in iceland gameplay: ~670 draws a frame from the ring, RSX-thread
+ * samples in dc_fetch 153 -> 104, frame p95 48.8 -> 42.2 ms, frames
+ * >= 100 ms 9 -> 5 a minute (the median sits on the 30 FPS cap). */
+#define ENG_VC_RING_BYTES (64u << 20)
+static u8* s_vc_ring;
+static u32 s_vc_ring_used, s_vc_ring_frame;
+static int eng_vc_reuse_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("PS3RECOMP_ENG_VCACHE_FRAMEREUSE");
+        on = e ? atoi(e) != 0 : 1;
+        if (on && !s_vc_ring) s_vc_ring = (u8*)malloc(ENG_VC_RING_BYTES);
+        if (!s_vc_ring) on = 0;
+    }
+    return on;
+}
+static void eng_vc_ring_frame(void)
+{
+    if (s_vc_ring_frame != g.frames) { s_vc_ring_frame = g.frames; s_vc_ring_used = 0; }
+}
+/* The vertices this key decoded earlier in this frame, if its bytes are the
+ * same (the content hash was just taken), else NULL. */
+static const u8* eng_vc_ring_get(const eng_vc_entry* e, u64 content, u64 bytes)
+{
+    if (!eng_vc_reuse_on()) return NULL;
+    eng_vc_ring_frame();
+    if (e->ring_frame != g.frames + 1u || !e->seen || e->seen_frame != g.frames ||
+        e->content != content || (u64)e->ring_bytes != bytes)
+        return NULL;
+    s_vc_reused++;
+    return s_vc_ring + e->ring_off;
+}
+static void eng_vc_ring_put(eng_vc_entry* e, const u8* data, u64 bytes)
+{
+    if (!eng_vc_reuse_on() || !data || !bytes || e->vbuf) return;
+    eng_vc_ring_frame();
+    if (bytes > ENG_VC_RING_BYTES - s_vc_ring_used) return;
+    memcpy(s_vc_ring + s_vc_ring_used, data, (size_t)bytes);
+    e->ring_off = s_vc_ring_used;
+    e->ring_bytes = (u32)bytes;
+    e->ring_frame = g.frames + 1u;
+    s_vc_ring_used += (u32)((bytes + 15u) & ~(u64)15u);
+}
+static void eng_vc_note_miss(const eng_vc_entry* e, u64 content)
+{
+    if (!e->seen) s_vcm_first++;
+    else if (e->content != content) s_vcm_changed++;
+    else if (e->seen_frame == g.frames) s_vcm_same_frame++;
+    else if (!e->vbuf) s_vcm_repeat++;
+    else s_vcm_other++;
+}
+static u64 s_vc_split, s_vc_stream_hit, s_vc_stream_miss;
+/* Bumped whenever the table is rebuilt or emptied: an entry pointer taken
+ * before that no longer names its key, and a handle from it may be gone. */
+static u32 s_vc_epoch;
+
+static int eng_vc_on(void)
+{
+    if (s_vc_enabled < 0) {
+        const char* e = getenv("PS3RECOMP_ENG_VCACHE");
+        s_vc_enabled = !(e && *e && atoi(e) == 0);
+    }
+    return s_vc_enabled && g.be->vbuf_create && g.be->draw_vbuf && g.be->vbuf_release;
+}
+
+/* Eight independent FNV-style lanes, as the texture content hash: one serial
+ * multiply chain caps a hash at ~2 bytes a cycle. */
+static u64 eng_hash_span(const u8* src, u64 n, u64 seed)
+{
+    u64 h[8];
+    for (int k = 0; k < 8; k++) h[k] = seed ^ (0x9E3779B97F4A7C15ull * (u64)(k + 1));
+    u64 i = 0;
+    for (; i + 64 <= n; i += 64) {
+        u64 w[8]; memcpy(w, src + i, sizeof w);
+        for (int k = 0; k < 8; k++) h[k] = (h[k] ^ w[k]) * 1099511628211ull;
+    }
+    u64 r = n;
+    for (int k = 0; k < 8; k++) r ^= h[k] * (u64)(2 * k + 1);
+    for (; i < n; i++) { r ^= src[i]; r *= 1099511628211ull; }
+    return r;
+}
+
+/* The same hash over a sample of the span: its first and last 64-byte
+ * blocks and every eighth block between (a short span is hashed whole).
+ * Geometry the guest rewrites (skinning, particles, UI) changes blocks all
+ * over the span, so the sample sees it; the full hash still runs every
+ * PS3RECOMP_ENG_VCACHE_SPARSE frames to catch anything else. */
+static u64 eng_hash_span_sparse(const u8* src, u64 n, u64 seed)
+{
+    if (n <= 1024) return eng_hash_span(src, n, seed);
+    u64 h[8];
+    for (int k = 0; k < 8; k++) h[k] = seed ^ (0x9E3779B97F4A7C15ull * (u64)(k + 1));
+    const u64 last = (n - 64) & ~(u64)63;
+    u64 i = 0, blocks = 0;
+    for (;;) {
+        u64 w[8]; memcpy(w, src + i, sizeof w);
+        for (int k = 0; k < 8; k++) h[k] = (h[k] ^ w[k]) * 1099511628211ull;
+        blocks++;
+        if (i >= last) break;
+        i += 512;
+        if (i > last) i = last;
+    }
+    u64 r = n ^ (blocks << 48);
+    for (int k = 0; k < 8; k++) r ^= h[k] * (u64)(2 * k + 1);
+    return r;
+}
+
+/* Word-at-a-time mix for the cache key. */
+static inline u64 eng_vc_mix(u64 h, u64 v)
+{
+    h ^= v * 0x9E3779B97F4A7C15ull;
+    h = (h << 27) | (h >> 37);
+    return h * 0xBF58476D1CE4E5B9ull + 0x94D049BB133111EBull;
+}
+
+static void eng_vc_drop(eng_vc_entry* e)
+{
+    if (e->vbuf) { g.be->vbuf_release(g.be->user, e->vbuf); s_vc_bytes -= e->bytes; }
+    e->vbuf = 0; e->bytes = 0;
+}
+
+static void eng_vc_clear(void)
+{
+    if (g.be && g.be->vbuf_release)
+        for (u32 i = 0; i < ENG_VC_SIZE; i++) eng_vc_drop(&s_vc[i]);
+    memset(s_vc, 0, sizeof s_vc);
+    s_vc_used = 0; s_vc_bytes = 0; s_vc_cursor = 0;
+    s_vc_epoch++;
+}
+
+/* The table full: keep what was drawn recently, forget the rest. Skinned and
+ * streamed geometry lands at a new address every frame and adds keys that are
+ * never seen again; dropping the whole table would take the static geometry's
+ * buffers with it, which the next two frames then fetch, decode and stage
+ * again. The entries not drawn in the last ENG_VC_KEEP frames are dropped and
+ * the rest re-inserted; only when that frees too little does the cache start
+ * over. PS3RECOMP_ENG_VCACHE_PRUNE=0 = start over every time. Returns
+ * non-zero when the prune left enough room. */
+static u32 eng_vc_prune_pass(u32 keep)
+{
+    s_vc_epoch++;
+    u32 kept = 0;
+    memcpy(s_vc_tmp, s_vc, sizeof s_vc);
+    memset(s_vc, 0, sizeof s_vc);
+    for (u32 i = 0; i < ENG_VC_SIZE; i++) {
+        eng_vc_entry* o = &s_vc_tmp[i];
+        if (!o->key) continue;
+        if (o->last_frame + keep < g.frames && o->skip_until <= g.frames) {
+            eng_vc_drop(o);
+            continue;
+        }
+        u32 p = (u32)(o->key ^ (o->key >> 32)) & (ENG_VC_SIZE - 1u);
+        while (s_vc[p].key) p = (p + 1) & (ENG_VC_SIZE - 1u);
+        s_vc[p] = *o;
+        kept++;
+    }
+    s_vc_used = kept;
+    return kept;
+}
+
+static int eng_vc_prune(void)
+{
+    if (s_vc_prune_on < 0) {
+        const char* e = getenv("PS3RECOMP_ENG_VCACHE_PRUNE");
+        s_vc_prune_on = !(e && *e && atoi(e) == 0);
+    }
+    if (!s_vc_prune_on) return 0;
+    u32 keep = ENG_VC_KEEP;
+    u32 kept = eng_vc_prune_pass(keep);
+    /* Resistance 2 draws several hundred streamed spans a frame at addresses
+     * never seen again, so sixty frames of them alone fill half the table and
+     * the cache started over every ~13 s of gameplay (49k keys, 50-105 MB of
+     * static geometry dropped and fetched, decoded and staged again). Before
+     * giving up, keep only what the last few frames drew, then only this
+     * frame's: the world geometry in view survives, the one-shot keys go.
+     * PS3RECOMP_ENG_VCACHE_KEEP2=<frames> is the second window (default 8:
+     * in iceland gameplay the start-overs went from 16-28 a run to none and
+     * 57-77 MB of static geometry stayed resident instead of 9-20 MB);
+     * 0 = the old behaviour. */
+    static int s_keep2 = -1;
+    if (s_keep2 < 0) {
+        const char* e = getenv("PS3RECOMP_ENG_VCACHE_KEEP2");
+        s_keep2 = (e && *e) ? atoi(e) : 8;
+        if (s_keep2 < 0 || (u32)s_keep2 >= ENG_VC_KEEP) s_keep2 = 0;
+    }
+    if (kept > ENG_VC_SIZE / 2u && s_keep2 > 0) {
+        keep = (u32)s_keep2;
+        kept = eng_vc_prune_pass(keep);
+        if (kept > ENG_VC_SIZE / 2u) { keep = 1u; kept = eng_vc_prune_pass(keep); }
+    }
+    { static int n = 0; if (PS3_LOG_FIRST(n, 16))
+        fprintf(stderr, "[rsx engine] vertex cache full: kept %u keys drawn in the last %u frames (%.0f MB resident), frame %u\n",
+                kept, keep, s_vc_bytes / 1e6, g.frames); }
+    return kept <= ENG_VC_SIZE / 2u;
+}
+
+/* The entry for `key`, made if new. NULL when the probe run is full or the
+ * table had to be pruned or emptied first (s_vc_epoch moves then). */
+static eng_vc_entry* eng_vc_find(u64 key)
+{
+    if (!key) key = 1;
+    u32 p = (u32)(key ^ (key >> 32)) & (ENG_VC_SIZE - 1u);
+    for (u32 probe = 0; probe < 32; probe++, p = (p + 1) & (ENG_VC_SIZE - 1u)) {
+        if (s_vc[p].key == key) return &s_vc[p];
+        if (!s_vc[p].key) {
+            if (s_vc_used >= ENG_VC_SIZE / 4u * 3u) {   /* full: prune, else start over */
+                if (eng_vc_prune()) return NULL;
+                { static int n = 0; if (PS3_LOG_FIRST(n, 64))
+                    fprintf(stderr, "[rsx engine] vertex cache: %u keys, %.0f MB resident -> start over (frame %u)\n",
+                            s_vc_used, s_vc_bytes / 1e6, g.frames); }
+                eng_vc_clear();
+                return NULL;
+            }

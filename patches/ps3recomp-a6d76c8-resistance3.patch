+{
+    static const char wpos_read[] = "(input.position).";
+    static const char grid_line[] = "    input.position.xy = floor(";
+    static const char* const entries[] = { "main(PSInput input) : SV_TARGET {\n",
+                                           "main(PSInput input) {\n" };

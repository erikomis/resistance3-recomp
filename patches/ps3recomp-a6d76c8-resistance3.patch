+/* AppKit events -> ps3_host_input (host_input_cocoa.h) -> cellPad: what the
+ * window host records in the control page and the game's pad reads back.
+ *   - keys are recorded and swallowed; Cmd shortcuts pass to AppKit;
+ *   - Shift/Control/Option come from flag changes, left and right apart;
+ *   - Esc releases a captured mouse and still reaches the pad (START);
+ *   - motion, buttons and the wheel count only when the game asks for the
+ *     mouse and the cursor is captured (no window here: nothing counts);
+ *   - the window lets go when the game no longer wants the mouse, and of
+ *     everything when focus goes elsewhere;
+ *   - a block in a page shared like the control page reads the same in cellPad.
+ *
+ *   clang -fobjc-arc -std=gnu17 -I include $(sdl2-config --cflags) -I "$(sdl2-config --prefix)/include" \
+ *         libs/input/tests/test_host_input_cocoa.m libs/input/tests/test_host_input_cocoa_pad.c \
+ *         $(sdl2-config --libs) -framework AppKit -o /tmp/test_host_input_cocoa && /tmp/test_host_input_cocoa
+ * (No window is opened and the cursor is never captured or moved.)
+ */
+#include "../host_input_cocoa.h"
+#include "../../video/rsx_host_surface.h"
+#include <assert.h>
+#include <unistd.h>
+
+/* cellPad (test_host_input_cocoa_pad.c) */
+void ps3_pad_host_input_attach(ps3_host_input* in);
+void test_pad_poll(unsigned* buttons, int* lx, int* ly, int* rx, int* ry);
+void test_pad_reload_mouse(void);
+#define CTRL_L3     0x0002u
+#define CTRL_START  0x0008u
+#define CTRL_CROSS  0x4000u
+static unsigned s_btn; static int s_lx, s_ly, s_rx, s_ry;
+static void poll(void) { test_pad_poll(&s_btn, &s_lx, &s_ly, &s_rx, &s_ry); }
+
+static NSEvent* key(NSEventType t, unsigned short vk, NSEventModifierFlags mods)
+{
+    return [NSEvent keyEventWithType:t location:NSZeroPoint modifierFlags:mods timestamp:0
+                        windowNumber:0 context:nil characters:@"x" charactersIgnoringModifiers:@"x"
+                           isARepeat:NO keyCode:vk];
+}
+
+static NSEvent* flags(unsigned short vk, NSEventModifierFlags mods)
+{
+    return [NSEvent keyEventWithType:NSEventTypeFlagsChanged location:NSZeroPoint modifierFlags:mods
+                           timestamp:0 windowNumber:0 context:nil characters:@"" charactersIgnoringModifiers:@""
+                           isARepeat:NO keyCode:vk];
+}
+
+static NSEvent* mouse(CGEventType type, int dx, int dy)
+{
+    CGEventRef e = CGEventCreateMouseEvent(NULL, type, CGPointMake(100, 100), kCGMouseButtonLeft);
+    CGEventSetIntegerValueField(e, kCGMouseEventDeltaX, dx);
+    CGEventSetIntegerValueField(e, kCGMouseEventDeltaY, dy);
+    NSEvent* ev = [NSEvent eventWithCGEvent:e];
+    CFRelease(e);
+    return ev;
+}
+
+static int held(const ps3_host_input* in, unsigned vk)
+{
+    return (atomic_load(&in->keys[vk >> 5]) >> (vk & 31)) & 1;
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        [NSApplication sharedApplication];
+        unsetenv("PS3_INPUT_MAP");
+        unsetenv("PS3_MOUSE");
+        unsetenv("PS3_MOUSE_CAPTURE");
+        unsetenv("PS3_INPUT_MODE");
+
+        /* A control page as the window host makes one, shared with the game
+         * through a memory entry: the game's mapping sees the window's writes. */
+        vm_address_t win_addr = 0, game_addr = 0;
+        assert(vm_allocate(mach_task_self(), &win_addr, RSX_HOST_CONTROL_BYTES, VM_FLAGS_ANYWHERE) == KERN_SUCCESS);
+        memory_object_size_t size = RSX_HOST_CONTROL_BYTES;
+        mach_port_t entry = MACH_PORT_NULL;
+        assert(mach_make_memory_entry_64(mach_task_self(), &size, win_addr, VM_PROT_READ | VM_PROT_WRITE,
+                                         &entry, MACH_PORT_NULL) == KERN_SUCCESS);
+        assert(vm_map(mach_task_self(), &game_addr, RSX_HOST_CONTROL_BYTES, 0, VM_FLAGS_ANYWHERE, entry, 0, FALSE,
+                      VM_PROT_READ | VM_PROT_WRITE, VM_PROT_READ | VM_PROT_WRITE, VM_INHERIT_NONE) == KERN_SUCCESS);
+        assert(win_addr != game_addr);
+        rsx_host_control* win_ctl = (rsx_host_control*)win_addr;
+        rsx_host_control* game_ctl = (rsx_host_control*)game_addr;
+        HostInputCocoa hic = { .in = &win_ctl->input };
+        ps3_pad_host_input_attach(&game_ctl->input);
+
+        /* keys: recorded, swallowed, and the game's pad sees them */
+        assert(hic_event(&hic, key(NSEventTypeKeyDown, 0x0D, 0), nil) == 1);        /* W */
+        assert(hic_event(&hic, key(NSEventTypeKeyDown, 0x31, 0), nil) == 1);        /* Space */
+        assert(held(&win_ctl->input, 0x0D) && held(&game_ctl->input, 0x31));
+        poll();
+        assert(s_ly == 0 && s_btn == CTRL_CROSS);
+        assert(hic_event(&hic, key(NSEventTypeKeyUp, 0x0D, 0), nil) == 1);
+        assert(hic_event(&hic, key(NSEventTypeKeyUp, 0x31, 0), nil) == 1);
+        poll();
+        assert(s_ly == 128 && s_btn == 0);
+
+        /* the game told the window what it wants of the mouse */
+        assert(atomic_load(&win_ctl->input.game_flags) ==
+               (PS3_HOST_INPUT_ACTIVE | PS3_HOST_INPUT_MOUSE_CAMERA | PS3_HOST_INPUT_CAPTURE));
+
+        /* Cmd+Q is the menu's: not swallowed, not recorded */
+        assert(hic_event(&hic, key(NSEventTypeKeyDown, 0x0C, NSEventModifierFlagCommand), nil) == 0);
+        assert(!held(&win_ctl->input, 0x0C));
+
+        /* Shift and right Option from flag changes */
+        assert(hic_event(&hic, flags(0x38, NSEventModifierFlagShift | 0x02), nil) == 0);
+        assert(held(&win_ctl->input, 0x38) && !held(&win_ctl->input, 0x3C));
+        poll();
+        assert(s_btn == CTRL_L3);
+        assert(hic_event(&hic, flags(0x3D, NSEventModifierFlagShift | 0x02 | NSEventModifierFlagOption | 0x40), nil) == 0);
+        assert(held(&win_ctl->input, 0x3D) && held(&win_ctl->input, 0x38));
+        assert(hic_event(&hic, flags(0x38, NSEventModifierFlagOption | 0x40), nil) == 0);
+        assert(!held(&win_ctl->input, 0x38) && held(&win_ctl->input, 0x3D));
+        assert(hic_event(&hic, flags(0x3D, 0), nil) == 0);
+        assert(!held(&win_ctl->input, 0x3D));
+
+        /* Esc: releases the cursor and pauses (START) */
+        hic.captured = 1;                    /* as if a click had captured it */
+        atomic_store(&win_ctl->input.captured, 1);
+        assert(hic_event(&hic, key(NSEventTypeKeyDown, 0x35, 0), nil) == 1);
+        assert(!hic.captured && atomic_load(&win_ctl->input.captured) == 0);
+        poll();
+        assert(s_btn == CTRL_START);
+        hic_event(&hic, key(NSEventTypeKeyUp, 0x35, 0), nil);
+
+        /* motion: not the game's while the cursor is free ... */
+        assert(hic_event(&hic, mouse(kCGEventMouseMoved, 7, 3), nil) == 0);
+        assert(atomic_load(&win_ctl->input.mouse_dx) == 0);
+        /* ... and the game's once captured, in 1/16 px */
+        hic.captured = 1; hic.cap_since = 0;
+        assert(hic_event(&hic, mouse(kCGEventMouseMoved, 7, -3), nil) == 0);
+        assert(atomic_load(&game_ctl->input.mouse_dx) == 7 * 16);
+        assert(atomic_load(&game_ctl->input.mouse_dy) == -3 * 16);
+        usleep(16 * 1000);
+        poll();
+        assert(s_rx > 128 && s_ry < 128);
+        assert(atomic_load(&win_ctl->input.mouse_dx) == 0);    /* the game drained it */
+        /* a button press while captured (no window: it is not ours) */
+        assert(hic_event(&hic, mouse(kCGEventLeftMouseDown, 0, 0), nil) == 0);
+        assert(atomic_load(&win_ctl->input.mouse_buttons) == 0);
+        atomic_store(&win_ctl->input.mouse_buttons, 1);        /* as a capture-time press */
+        assert(hic_event(&hic, mouse(kCGEventLeftMouseUp, 0, 0), nil) == 0);
+        assert(atomic_load(&win_ctl->input.mouse_buttons) == 0);   /* a release always counts */
+
+        /* the game switches its mouse camera off: the window lets go */
+        setenv("PS3_MOUSE", "0", 1);
+        test_pad_reload_mouse();
+        poll();
+        assert(atomic_load(&win_ctl->input.game_flags) == PS3_HOST_INPUT_ACTIVE);
+        hic_tick(&hic);
+        assert(!hic.captured);
+        unsetenv("PS3_MOUSE");
+        test_pad_reload_mouse();
+
+        /* focus elsewhere: nothing stays held */
+        hic_event(&hic, key(NSEventTypeKeyDown, 0x00, 0), nil);
+        atomic_store(&win_ctl->input.mouse_buttons, 2);
+        atomic_store(&win_ctl->input.wheel, 32);
+        hic_focus_lost(&hic);
+        for (int i = 0; i < 4; i++) assert(atomic_load(&game_ctl->input.keys[i]) == 0);
+        assert(atomic_load(&game_ctl->input.mouse_buttons) == 0 && atomic_load(&game_ctl->input.wheel) == 0);
+        /* (the app is not active here: a tick lets go of everything too) */
+        hic_event(&hic, key(NSEventTypeKeyDown, 0x02, 0), nil);
+        hic_tick(&hic);
+        assert(!held(&game_ctl->input, 0x02));
+
+        ps3_pad_host_input_attach(NULL);
+        printf("test_host_input_cocoa: ok\n");
+    }
+    return 0;
+}
diff --git a/libs/input/tests/test_host_input_cocoa_pad.c b/libs/input/tests/test_host_input_cocoa_pad.c
new file mode 100644
index 0000000..155c6af
--- /dev/null
+++ b/libs/input/tests/test_host_input_cocoa_pad.c
@@ -0,0 +1,25 @@
+/* cellPad's side of test_host_input_cocoa.m, built as C: cellPad.c's
+ * win32_compat.h and AppKit cannot share one translation unit (BOOL). */
+#include "../cellPad.c"
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+u32 cellGcm_flip_request_count(void) { return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+/* One keyboard/mouse poll of port 0. */
+void test_pad_poll(unsigned* buttons, int* lx, int* ly, int* rx, int* ry)
+{
+    pad_poll_keys(0);
+    const PadHostState* hs = &s_host_state[0];
+    *buttons = hs->buttons;
+    *lx = hs->analog_lx; *ly = hs->analog_ly; *rx = hs->analog_rx; *ry = hs->analog_ry;
+}
+/* Read the mouse settings from the environment again. */
+void test_pad_reload_mouse(void) { s_mouse_on = -1; }
diff --git a/libs/input/tests/test_pad_adaptive.c b/libs/input/tests/test_pad_adaptive.c
new file mode 100644
index 0000000..0b37b22
--- /dev/null
+++ b/libs/input/tests/test_pad_adaptive.c
@@ -0,0 +1,254 @@
+/* cellPad's DualSense adaptive triggers: a DualSense gets a gun click on the
+ * right trigger (pressed only past the break) and a light resistance on the
+ * left; firing with the motors running makes the right trigger buzz, and it
+ * clicks again afterwards; closing the controller frees both triggers. A
+ * controller that refuses effects, and PS3_PAD_ADAPTIVE=0, keep free
+ * triggers pressed past 3000 as before.
+ *
+ *   cc -std=gnu17 -I include -isystem /opt/homebrew/include \
+ *      -isystem /opt/homebrew/include/SDL2 libs/input/tests/test_pad_adaptive.c \
+ *      -o /tmp/test_pad_adaptive && /tmp/test_pad_adaptive
+ *
+ * Nothing links SDL: the test defines every SDL call the backend makes.
+ */
+#include "../cellPad.c"
+#include <assert.h>
+#include <sys/mman.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+u32 cellGcm_flip_request_count(void) { return 0; }
+
+/* ---- the fake SDL: one controller ------------------------------------------ */
+static struct {
+    int present, closed, ps5, refuse;
+    Sint16 lt, rt;
+    int effects;                 /* SendEffect calls */
+    uint8_t last[47];            /* the last effect report */
+} s_pad = { .present = 1, .ps5 = 1 };
+
+int SDL_NumJoysticks(void) { return s_pad.present; }
+SDL_bool SDL_IsGameController(int idx) { return idx == 0 && s_pad.present ? SDL_TRUE : SDL_FALSE; }
+SDL_JoystickID SDL_JoystickGetDeviceInstanceID(int idx) { return idx == 0 ? 1 : -1; }
+SDL_JoystickGUID SDL_JoystickGetDeviceGUID(int idx) { SDL_JoystickGUID g; memset(&g, 0, sizeof g); g.data[0] = (Uint8)idx; return g; }
+const char* SDL_JoystickNameForIndex(int idx) { (void)idx; return "Fake DualSense"; }
+SDL_GameController* SDL_GameControllerOpen(int idx) { (void)idx; s_pad.closed = 0; return (SDL_GameController*)&s_pad; }
+void SDL_GameControllerClose(SDL_GameController* gc) { (void)gc; s_pad.closed = 1; }
+SDL_bool SDL_GameControllerGetAttached(SDL_GameController* gc) { (void)gc; return s_pad.present ? SDL_TRUE : SDL_FALSE; }
+const char* SDL_GameControllerName(SDL_GameController* gc) { (void)gc; return "Fake DualSense"; }
+SDL_GameControllerType SDL_GameControllerGetType(SDL_GameController* gc)
+{
+    (void)gc; return s_pad.ps5 ? SDL_CONTROLLER_TYPE_PS5 : SDL_CONTROLLER_TYPE_XBOXONE;
+}
+SDL_bool SDL_GameControllerHasRumble(SDL_GameController* gc) { (void)gc; return SDL_TRUE; }
+int SDL_GameControllerRumble(SDL_GameController* gc, Uint16 lo, Uint16 hi, Uint32 ms) { (void)gc; (void)lo; (void)hi; (void)ms; return 0; }
+int SDL_GameControllerSendEffect(SDL_GameController* gc, const void* data, int size)
+{
+    (void)gc;
+    assert(!s_pad.closed && size == 47);
+    if (s_pad.refuse) return -1;
+    memcpy(s_pad.last, data, 47);
+    s_pad.effects++;
+    return 0;
+}
+static uint32_t s_buttons;   /* SDL buttons held, by bit */
+Uint8 SDL_GameControllerGetButton(SDL_GameController* gc, SDL_GameControllerButton b) { (void)gc; return (s_buttons >> b) & 1u; }
+static SDL_JoystickPowerLevel s_power = SDL_JOYSTICK_POWER_FULL;
+SDL_Joystick* SDL_GameControllerGetJoystick(SDL_GameController* gc) { return (SDL_Joystick*)gc; }
+SDL_JoystickPowerLevel SDL_JoystickCurrentPowerLevel(SDL_Joystick* j) { (void)j; return s_power; }
+Sint16 SDL_GameControllerGetAxis(SDL_GameController* gc, SDL_GameControllerAxis a)
+{
+    (void)gc;
+    return a == SDL_CONTROLLER_AXIS_TRIGGERLEFT ? s_pad.lt : a == SDL_CONTROLLER_AXIS_TRIGGERRIGHT ? s_pad.rt : 0;
+}
+void SDL_GameControllerUpdate(void) {}
+int SDL_PeepEvents(SDL_Event* ev, int n, SDL_eventaction action, Uint32 lo, Uint32 hi) { (void)ev; (void)n; (void)action; (void)lo; (void)hi; return 0; }
+Uint32 SDL_WasInit(Uint32 flags) { return flags; }
+int SDL_InitSubSystem(Uint32 flags) { (void)flags; return 0; }
+SDL_bool SDL_SetHint(const char* name, const char* value) { (void)name; (void)value; return SDL_TRUE; }
+const char* SDL_GetError(void) { return "fake"; }
+/* The DualSense extras: the light bar's colour and the gyro, recorded. */
+static struct { int player; int leds; Uint8 rgb[3]; int gyro_on; float gyro[3]; } s_x;
+void SDL_GameControllerSetPlayerIndex(SDL_GameController* gc, int i) { (void)gc; s_x.player = i + 1; }
+SDL_bool SDL_GameControllerHasLED(SDL_GameController* gc) { (void)gc; return s_pad.ps5 ? SDL_TRUE : SDL_FALSE; }
+int SDL_GameControllerSetLED(SDL_GameController* gc, Uint8 r, Uint8 g, Uint8 b)
+{ (void)gc; s_x.rgb[0] = r; s_x.rgb[1] = g; s_x.rgb[2] = b; s_x.leds++; return 0; }
+SDL_bool SDL_GameControllerHasSensor(SDL_GameController* gc, SDL_SensorType t) { (void)gc; return t == SDL_SENSOR_GYRO ? SDL_TRUE : SDL_FALSE; }
+int SDL_GameControllerSetSensorEnabled(SDL_GameController* gc, SDL_SensorType t, SDL_bool on) { (void)gc; (void)t; s_x.gyro_on = on; return 0; }
+int SDL_GameControllerGetSensorData(SDL_GameController* gc, SDL_SensorType t, float* d, int n)
+{ (void)gc; (void)t; for (int i = 0; i < n && i < 3; i++) d[i] = s_x.gyro[i]; return 0; }
+
+/* ---- helpers ---------------------------------------------------------------- */
+static void poll_wait(int ms)
+{
+    usleep((unsigned)ms * 1000);
+    cellPad_poll();
+}
+/* R2 as the title reads it: bit 0x02 of DIGITAL2. */
+static int r2_down(void)
+{
+    const uint32_t ea = 0x2000;
+    usleep((PAD_POLL_INTERVAL_MS + 2) * 1000);
+    assert(cellPadGetData(0, (CellPadData*)(uintptr_t)ea) == CELL_OK);
+    const uint8_t* b = vm_base + ea + 4 + CELL_PAD_BTN_OFFSET_DIGITAL2 * 2;
+    return ((unsigned)b[0] << 8 | b[1]) & 0x02u ? 1 : 0;
+}
+static int right_mode(void) { return s_pad.last[10]; }
+static int left_mode(void)  { return s_pad.last[21]; }
+static void rumble(int large)
+{
+    CellPadActParam* act = (CellPadActParam*)(vm_base + 0x3000);
+    act->motor[CELL_PAD_ACTUATOR_PARAM_SMALL] = 0;
+    act->motor[CELL_PAD_ACTUATOR_PARAM_LARGE] = (u8)large;
+    assert(cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)0x3000) == CELL_OK);
+}
+
+int main(void)
+{
+    unsetenv("PS3_PAD_SDL"); unsetenv("PS3_INPUT_MAP"); unsetenv("PS3_INPUT_MODE");
+    unsetenv("PS3_RUMBLE"); unsetenv("PS3_RUMBLE_STRENGTH");
+    unsetenv("PS3_PAD_ADAPTIVE"); unsetenv("PS3_PAD_FIRE_AT");
+    setenv("PS3_PAD_LIGHT", "102030", 1); unsetenv("PS3_PAD_LIGHT_HIT");
+    setenv("PS3_PAD_GYRO", "100", 1); unsetenv("PS3_PAD_GYRO_MODE"); unsetenv("PS3_PAD_GYRO_INVERT_Y"); unsetenv("PS3_PAD_GYRO_DZ");
+    vm_base = mmap(NULL, 0x10000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(vm_base != MAP_FAILED);
+
+    /* A DualSense: the gun click on the right, light resistance on the left. */
+    assert(cellPadInit(4) == CELL_OK);
+    assert(s_adapt[0].on && s_pad.effects == 1);
+    assert(s_pad.last[0] == (0x04 | 0x08));
+    assert(s_pad.last[1] == 0x02 && s_pad.last[9] == 0);    /* the first one clears the power-save bits */
+    /* Player 1's light, the port's light-bar colour, the gyro on. */
+    assert(s_x.player == 1 && s_x.leds == 1 && s_x.rgb[0] == 0x10 && s_x.rgb[1] == 0x20 && s_x.rgb[2] == 0x30);
+    assert(s_x.gyro_on);
+    assert(right_mode() == 0x25 && left_mode() == 0x21);
+    assert(s_pad.last[11] == ((1 << 2) | (1 << 5)) && s_pad.last[12] == 0 && s_pad.last[13] == 5);
+
+    /* Pressed only past the break (half way), not at the first touch. */
+    s_pad.rt = 6000;
+    assert(!r2_down());
+    s_pad.rt = 20000;
+    assert(r2_down());
+
+    /* Firing with the motors running: the right trigger buzzes ... */
+    rumble(255);
+    poll_wait(PAD_ADAPT_MIN_GAP_MS + 5);
+    assert(right_mode() == 0x26 && left_mode() == 0x21);
+    assert(s_pad.last[13] == 0xFF && s_pad.last[16] == 0x3F && s_pad.last[19] == 30);   /* amplitude 8 in all ten zones, 30 Hz */
+    const int after_buzz = s_pad.effects;
+    poll_wait(PAD_ADAPT_MIN_GAP_MS + 5);
+    assert(s_pad.effects == after_buzz);                     /* unchanged: nothing re-sent */
+    /* ... and clicks again when the shooting stops. */
+    rumble(0);
+    poll_wait(PAD_ADAPT_MIN_GAP_MS + 5);
+    assert(right_mode() == 0x25);
+    /* Motors running but the trigger let go (a hit, an explosion): a click. */
+    rumble(255);
+    s_pad.rt = 0;
+    poll_wait(PAD_ADAPT_MIN_GAP_MS + 5);
+    assert(right_mode() == 0x25);
+    rumble(0);
+
+    assert(s_pad.last[1] == 0);                               /* later ones leave them */
+
+    /* The motors pull the light bar towards red. */
+    rumble(255);
+    poll_wait(60);
+    assert(s_x.rgb[0] > 0x80 && s_x.rgb[1] < 0x20 && s_x.rgb[2] < 0x30);
+    rumble(0);
+    poll_wait(60);
+    assert(s_x.rgb[0] == 0x10 && s_x.rgb[1] == 0x20 && s_x.rgb[2] == 0x30);
+
+    /* Gyro aim: nothing while the left trigger is up; turning left with it
+     * held pushes the right stick left (past the dead zone), tilting the top
+     * back pushes it up. */
+    s_x.gyro[1] = 1.0f;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(s_host_state[0].analog_rx == 127 || s_host_state[0].analog_rx == 128);
+    s_pad.lt = 20000;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(s_host_state[0].analog_rx < 128 - 40);
+    s_x.gyro[1] = 0.0f; s_x.gyro[0] = 1.0f;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(s_host_state[0].analog_ry < 128 - 40 && (s_host_state[0].analog_rx == 127 || s_host_state[0].analog_rx == 128));
+    s_x.gyro[0] = 0.001f;                                     /* resting jitter: nothing */
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(s_host_state[0].analog_ry == 127 || s_host_state[0].analog_ry == 128);
+    s_pad.lt = 0; s_x.gyro[0] = 0.0f;
+
+    /* A port that reports its game's aim (a toggled zoom): the gyro follows
+     * that, not the left trigger. */
+    s_x.gyro[1] = 1.0f;
+    cellPad_host_set_aiming(1);
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(s_host_state[0].analog_rx < 128 - 40);            /* aiming, trigger up */
+    cellPad_host_set_aiming(0); s_pad.lt = 20000;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(s_host_state[0].analog_rx == 127 || s_host_state[0].analog_rx == 128);   /* trigger held, not aiming */
+    s_pad.lt = 0; s_x.gyro[1] = 0.0f;
+
+    /* The mute button (misc1): the game's sound off with the button's light
+     * on, a notice; again: back on, light off. Held, it does nothing more. */
+    assert(!cellAudio_host_muted());
+    s_buttons = 1u << SDL_CONTROLLER_BUTTON_MISC1;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(cellAudio_host_muted() == 1);
+    assert(s_pad.last[1] == 0x01 && s_pad.last[8] == 1);
+    assert(strstr(s_pad_last_notice, "off"));
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(cellAudio_host_muted() == 1);
+    s_buttons = 0; poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    s_buttons = 1u << SDL_CONTROLLER_BUTTON_MISC1; poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(cellAudio_host_muted() == 0 && s_pad.last[1] == 0x01 && s_pad.last[8] == 0);
+    s_buttons = 0; poll_wait(PAD_POLL_INTERVAL_MS + 2);
+
+    /* A touchpad click opens the in-game menu, once per click. */
+    const uint32_t t0 = g_pad_overlay_toggle;
+    s_buttons = 1u << SDL_CONTROLLER_BUTTON_TOUCHPAD;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2); poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(g_pad_overlay_toggle == t0 + 1);
+    s_buttons = 0; poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(g_pad_overlay_toggle == t0 + 1);
+
+    /* The battery going low is said once, not again while it stays low. */
+    s_pad_last_notice[0] = 0;
+    s_power = SDL_JOYSTICK_POWER_LOW; s_pad_batt_next[0] = 0;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(strstr(s_pad_last_notice, "battery low"));
+    s_pad_last_notice[0] = 0; s_pad_batt_next[0] = 0;
+    poll_wait(PAD_POLL_INTERVAL_MS + 2);
+    assert(s_pad_last_notice[0] == 0);
+    s_power = SDL_JOYSTICK_POWER_FULL;
+
+    /* Closing frees both triggers. */
+    const int before_end = s_pad.effects;
+    assert(cellPadEnd() == CELL_OK);
+    assert(s_pad.closed && s_pad.effects == before_end + 1);
+    assert(right_mode() == 0x05 && left_mode() == 0x05);
+
+    /* Not a DualSense: no effects, the usual press point. */
+    s_pad.ps5 = 0;
+    const int before_xbox = s_pad.effects;
+    assert(cellPadInit(4) == CELL_OK);
+    assert(!s_adapt[0].on && s_pad.effects == before_xbox);
+    s_pad.rt = 6000;
+    assert(r2_down());
+    assert(cellPadEnd() == CELL_OK && s_pad.effects == before_xbox);
+
+    /* A DualSense that refuses the effect: the same. */
+    s_pad.ps5 = 1; s_pad.refuse = 1;
+    assert(cellPadInit(4) == CELL_OK);
+    assert(!s_adapt[0].on);
+    assert(r2_down());
+    assert(cellPadEnd() == CELL_OK);
+
+    printf("test_pad_adaptive: all passed\n");
+    return 0;
+}
diff --git a/libs/input/tests/test_pad_hotplug.c b/libs/input/tests/test_pad_hotplug.c
new file mode 100644
index 0000000..99fbc8b
--- /dev/null
+++ b/libs/input/tests/test_pad_hotplug.c
@@ -0,0 +1,283 @@
+/* cellPad's SDL controller hot-plug: a controller switched off and on again
+ * (a DualSense over Bluetooth comes back with a new instance id) is opened
+ * again without a restart, into the port it had; a new one goes into a free
+ * port; the ports report it (CELL_PAD_STATUS_ASSIGN_CHANGES once), no rumble
+ * is left over, and the input map and input mode apply to it.
+ *
+ *   cc -std=gnu17 -I include -isystem /opt/homebrew/include \
+ *      -isystem /opt/homebrew/include/SDL2 libs/input/tests/test_pad_hotplug.c \
+ *      -o /tmp/test_pad_hotplug && /tmp/test_pad_hotplug
+ *
+ * Nothing links SDL: the test defines every SDL call the backend makes, over
+ * a fake device list that behaves like Homebrew's SDL2 (sdl2-compat on SDL3):
+ * a device index resolves through a list refreshed only by SDL_NumJoysticks,
+ * so code that never calls it keeps seeing the switched-off controller.
+ */
+#include "../cellPad.c"
+
+/* The DualSense extras (light bar, player lights, gyro): not exercised here. */
+void SDL_GameControllerSetPlayerIndex(SDL_GameController* gc, int i) { (void)gc; (void)i; }
+SDL_bool SDL_GameControllerHasLED(SDL_GameController* gc) { (void)gc; return SDL_FALSE; }
+int SDL_GameControllerSetLED(SDL_GameController* gc, Uint8 r, Uint8 g, Uint8 b) { (void)gc; (void)r; (void)g; (void)b; return 0; }
+SDL_bool SDL_GameControllerHasSensor(SDL_GameController* gc, SDL_SensorType t) { (void)gc; (void)t; return SDL_FALSE; }
+int SDL_GameControllerSetSensorEnabled(SDL_GameController* gc, SDL_SensorType t, SDL_bool on) { (void)gc; (void)t; (void)on; return -1; }
+int SDL_GameControllerGetSensorData(SDL_GameController* gc, SDL_SensorType t, float* d, int n) { (void)gc; (void)t; (void)d; (void)n; return -1; }
+SDL_Joystick* SDL_GameControllerGetJoystick(SDL_GameController* gc) { return (SDL_Joystick*)gc; }
+SDL_JoystickPowerLevel SDL_JoystickCurrentPowerLevel(SDL_Joystick* j) { (void)j; return SDL_JOYSTICK_POWER_WIRED; }
+#include <assert.h>
+#include <sys/mman.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+u32 cellGcm_flip_request_count(void) { return 0; }
+
+/* ---- the fake SDL ----------------------------------------------------------- */
+typedef struct {
+    int      id;           /* SDL instance id; a reconnect gets a new one */
+    int      guid;         /* which physical pad */
+    int      present;      /* in the system's device list */
+    uint32_t buttons;      /* SDL_GameControllerButton bits */
+    int      opens;        /* times SDL_GameControllerOpen returned it */
+    int      closed;       /* its handle was closed */
+    unsigned rumble_lo, rumble_hi, rumble_calls;
+} FakePad;
+static FakePad s_fp[8];
+static int s_nfp;
+static int s_cached[8], s_ncached;   /* sdl2-compat's index list */
+static Uint32 s_events[64];
+static int s_nevents;
+
+static FakePad* fake_new(int id, int guid)
+{
+    FakePad* p = &s_fp[s_nfp++];
+    memset(p, 0, sizeof *p);
+    p->id = id; p->guid = guid; p->present = 1;
+    return p;
+}
+static void fake_event(Uint32 type) { s_events[s_nevents++] = type; }
+static FakePad* fake_by_id(int id)
+{
+    for (int i = 0; i < s_nfp; i++) if (s_fp[i].id == id) return &s_fp[i];
+    return NULL;
+}
+
+int SDL_NumJoysticks(void)
+{
+    s_ncached = 0;
+    for (int i = 0; i < s_nfp; i++) if (s_fp[i].present) s_cached[s_ncached++] = s_fp[i].id;
+    return s_ncached;
+}
+static FakePad* fake_at(int idx) { return idx >= 0 && idx < s_ncached ? fake_by_id(s_cached[idx]) : NULL; }
+SDL_bool SDL_IsGameController(int idx) { FakePad* p = fake_at(idx); return p && p->present ? SDL_TRUE : SDL_FALSE; }
+SDL_JoystickID SDL_JoystickGetDeviceInstanceID(int idx) { FakePad* p = fake_at(idx); return p ? p->id : -1; }
+SDL_JoystickGUID SDL_JoystickGetDeviceGUID(int idx)
+{
+    SDL_JoystickGUID g; memset(&g, 0, sizeof g);
+    FakePad* p = fake_at(idx);
+    if (p) g.data[0] = (Uint8)p->guid;
+    return g;
+}
+const char* SDL_JoystickNameForIndex(int idx) { (void)idx; return "Fake DualSense"; }
+SDL_GameController* SDL_GameControllerOpen(int idx)
+{
+    FakePad* p = fake_at(idx);
+    if (!p || !p->present) return NULL;
+    p->opens++; p->closed = 0;
+    return (SDL_GameController*)p;
+}
+void SDL_GameControllerClose(SDL_GameController* gc) { ((FakePad*)gc)->closed = 1; }
+SDL_bool SDL_GameControllerGetAttached(SDL_GameController* gc) { return ((FakePad*)gc)->present ? SDL_TRUE : SDL_FALSE; }
+const char* SDL_GameControllerName(SDL_GameController* gc) { (void)gc; return "Fake DualSense"; }
+SDL_GameControllerType SDL_GameControllerGetType(SDL_GameController* gc) { (void)gc; return SDL_CONTROLLER_TYPE_PS5; }
+SDL_bool SDL_GameControllerHasRumble(SDL_GameController* gc) { (void)gc; return SDL_TRUE; }
+int SDL_GameControllerRumble(SDL_GameController* gc, Uint16 lo, Uint16 hi, Uint32 ms)
+{
+    (void)ms;
+    FakePad* p = (FakePad*)gc;
+    assert(!p->closed);
+    p->rumble_lo = lo; p->rumble_hi = hi; p->rumble_calls++;
+    return 0;
+}
+int SDL_GameControllerSendEffect(SDL_GameController* gc, const void* data, int size) { (void)gc; (void)data; (void)size; return 0; }
+Uint8 SDL_GameControllerGetButton(SDL_GameController* gc, SDL_GameControllerButton b)
+{
+    return (Uint8)((((FakePad*)gc)->buttons >> b) & 1u);
+}
+Sint16 SDL_GameControllerGetAxis(SDL_GameController* gc, SDL_GameControllerAxis a) { (void)gc; (void)a; return 0; }
+void SDL_GameControllerUpdate(void) {}
+int SDL_PeepEvents(SDL_Event* ev, int n, SDL_eventaction action, Uint32 lo, Uint32 hi)
+{
+    assert(action == SDL_GETEVENT);
+    int got = 0, keep = 0;
+    for (int i = 0; i < s_nevents; i++) {
+        if (got < n && s_events[i] >= lo && s_events[i] <= hi) {
+            memset(&ev[got], 0, sizeof ev[got]);
+            ev[got++].type = s_events[i];
+        } else {
+            s_events[keep++] = s_events[i];
+        }
+    }
+    s_nevents = keep;
+    return got;
+}
+Uint32 SDL_WasInit(Uint32 flags) { (void)flags; return flags; }
+int SDL_InitSubSystem(Uint32 flags) { (void)flags; return 0; }
+SDL_bool SDL_SetHint(const char* name, const char* value) { (void)name; (void)value; return SDL_TRUE; }
+const char* SDL_GetError(void) { return "fake"; }
+
+/* ---- helpers ---------------------------------------------------------------- */
+static void poll_once(void)
+{
+    usleep((PAD_POLL_INTERVAL_MS + 2) * 1000);
+    cellPad_poll();
+}
+/* port_status[port] from cellPadGetInfo2 (guest big-endian). */
+static u32 info_status(u32 port)
+{
+    const uint32_t ea = 0x1000;
+    assert(cellPadGetInfo2((CellPadInfo2*)(uintptr_t)ea) == CELL_OK);
+    const uint8_t* b = vm_base + ea + 12 + port * 4;
+    return (u32)b[0] << 24 | (u32)b[1] << 16 | (u32)b[2] << 8 | b[3];
+}
+/* DIGITAL2 of cellPadGetData(port) (0 if it reported nothing new). */
+static unsigned data_digital2(u32 port)
+{
+    const uint32_t ea = 0x2000;
+    usleep((PAD_POLL_INTERVAL_MS + 2) * 1000);
+    assert(cellPadGetData(port, (CellPadData*)(uintptr_t)ea) == CELL_OK);
+    const uint8_t* b = vm_base + ea + 4 + CELL_PAD_BTN_OFFSET_DIGITAL2 * 2;
+    return (unsigned)b[0] << 8 | b[1];
+}
+static unsigned data_digital1(u32 port)
+{
+    const uint32_t ea = 0x2000;
+    usleep((PAD_POLL_INTERVAL_MS + 2) * 1000);
+    assert(cellPadGetData(port, (CellPadData*)(uintptr_t)ea) == CELL_OK);
+    const uint8_t* b = vm_base + ea + 4 + CELL_PAD_BTN_OFFSET_DIGITAL1 * 2;
+    return (unsigned)b[0] << 8 | b[1];
+}
+#define CROSS_BIT  0x40u   /* in DIGITAL2 */
+#define CIRCLE_BIT 0x20u
+
+/* ---- the tests -------------------------------------------------------------- */
+int main(void)
+{
+    unsetenv("PS3_PAD_SDL");
+    unsetenv("PS3_INPUT_MAP");
+    unsetenv("PS3_INPUT_MODE");
+    unsetenv("PS3_RUMBLE");
+    unsetenv("PS3_RUMBLE_STRENGTH");
+    vm_base = mmap(NULL, 0x10000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    assert(vm_base != MAP_FAILED);
+
+    /* A DualSense is on at start: port 0. */
+    FakePad* a = fake_new(1, 0xA5);
+    assert(cellPadInit(4) == CELL_OK);
+    assert(a->opens == 1 && s_sdl_controllers[0] == (SDL_GameController*)a);
+    assert(info_status(0) == CELL_PAD_STATUS_CONNECTED);   /* what is there at start: no change flag */
+    a->buttons = 1u << SDL_CONTROLLER_BUTTON_A;
+    assert(data_digital2(0) & CROSS_BIT);
+    a->buttons = 0;
+
+    /* The title asks for rumble: it reaches the controller. */
+    CellPadActParam* act = (CellPadActParam*)(vm_base + 0x3000);
+    act->motor[CELL_PAD_ACTUATOR_PARAM_SMALL] = 1;
+    act->motor[CELL_PAD_ACTUATOR_PARAM_LARGE] = 255;
+    assert(cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)0x3000) == CELL_OK);
+    assert(a->rumble_lo == 65535 && a->rumble_hi == 65535);
+
+    /* Switched off: SDL drops it (and says so with an event). */
+    a->present = 0;
+    fake_event(SDL_CONTROLLERDEVICEREMOVED);
+    fake_event(SDL_JOYDEVICEREMOVED);
+    poll_once();
+    assert(a->closed && s_sdl_controllers[0] == NULL && s_sdl_ids[0] == -1);
+    assert(s_rumble[0].lo == 0 && s_rumble[0].hi == 0 && s_rumble[0].sent_ms == 0);
+    assert(info_status(0) == CELL_PAD_STATUS_CONNECTED);   /* port 0 is the virtual pad: still there */
+    assert(s_nevents == 0);                                 /* the events were drained */
+
+    /* Switched on again: the same pad, a new instance id. Port 0 again, motors
+     * off, nothing of the old rumble renewed. */
+    FakePad* a2 = fake_new(7, 0xA5);
+    fake_event(SDL_JOYDEVICEADDED);
+    fake_event(SDL_CONTROLLERDEVICEADDED);
+    poll_once();
+    assert(a2->opens == 1 && s_sdl_controllers[0] == (SDL_GameController*)a2 && s_sdl_ids[0] == 7);
+    assert(a2->rumble_calls == 1 && a2->rumble_lo == 0 && a2->rumble_hi == 0);
+    a2->buttons = 1u << SDL_CONTROLLER_BUTTON_A;
+    assert(data_digital2(0) & CROSS_BIT);                   /* it plays again */
+    a2->buttons = 0;
+    usleep((PAD_RUMBLE_RENEW_MS + 50) * 1000);
+    poll_once();
+    assert(a2->rumble_calls == 1);                          /* no old rumble came back */
+
+    /* A second controller with no event (someone else drained the queue):
+     * found by the periodic rescan, on port 1, flagged once. */
+    FakePad* b = fake_new(9, 0xB6);
+    poll_once();
+    if (!s_sdl_controllers[1]) { usleep((PAD_SDL_RESCAN_MS + 50) * 1000); poll_once(); }
+    assert(b->opens == 1 && s_sdl_controllers[1] == (SDL_GameController*)b);
+    assert(a2->opens == 1);                                 /* the open one is not opened twice */
+    assert(info_status(1) == (CELL_PAD_STATUS_CONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES));
+    assert(info_status(1) == CELL_PAD_STATUS_CONNECTED);
+    b->buttons = 1u << SDL_CONTROLLER_BUTTON_B;
+    assert(data_digital2(1) & CIRCLE_BIT);
+    b->buttons = 0;
+
+    /* Both go off; the second one comes back first: it gets port 1 back, the
+     * port its GUID had, not the lowest free one. */
+    a2->present = 0; b->present = 0;
+    fake_event(SDL_CONTROLLERDEVICEREMOVED);
+    poll_once();
+    assert(!s_sdl_controllers[0] && !s_sdl_controllers[1]);
+    assert(info_status(1) == (CELL_PAD_STATUS_DISCONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES));
+    assert(info_status(1) == CELL_PAD_STATUS_DISCONNECTED);
+    FakePad* b2 = fake_new(11, 0xB6);
+    fake_event(SDL_CONTROLLERDEVICEADDED);
+    poll_once();
+    assert(s_sdl_controllers[1] == (SDL_GameController*)b2 && !s_sdl_controllers[0]);
+    FakePad* a3 = fake_new(12, 0xA5);
+    fake_event(SDL_CONTROLLERDEVICEADDED);
+    poll_once();
+    assert(s_sdl_controllers[0] == (SDL_GameController*)a3);
+
+    /* A new pad with no history takes the lowest free port. */
+    FakePad* c = fake_new(13, 0xC7);
+    fake_event(SDL_CONTROLLERDEVICEADDED);
+    poll_once();
+    assert(s_sdl_controllers[2] == (SDL_GameController*)c);
+
+    /* The map ([controller] in PS3_INPUT_MAP) applies to the reconnected
+     * pad: Circle (SDL "b") bound to Cross. */
+    pim_rebind(&s_map, PIM_SEC_CONTROLLER, PIM_CROSS, 1);
+    a3->buttons = 1u << SDL_CONTROLLER_BUTTON_B;
+    { const unsigned d2 = data_digital2(0);
+      assert((d2 & CROSS_BIT) && !(d2 & CIRCLE_BIT)); }      /* b left circle: it was moved */
+    pim_defaults(&s_map);
+
+    /* Input mode: keyboard and mouse only hides the controllers from the
+     * title; controller only hides the keys. */
+    s_input_mode = PAD_MODE_KEYBOARD;
+    a3->buttons = 1u << SDL_CONTROLLER_BUTTON_A;
+    assert(!(data_digital2(0) & CROSS_BIT));
+    s_input_mode = PAD_MODE_CONTROLLER;
+    a3->buttons = 0;
+    ps3_host_input_key(ps3_pad_host_input(), 0x31, 1);     /* Space: Cross on the keyboard */
+    assert(!(data_digital2(0) & CROSS_BIT));
+    s_input_mode = PAD_MODE_BOTH;
+    assert(data_digital2(0) & CROSS_BIT);
+    ps3_host_input_release_all(ps3_pad_host_input());
+    (void)data_digital1;
+
+    assert(cellPadEnd() == CELL_OK);
+    assert(a3->closed && b2->closed && c->closed);
+    printf("test_pad_hotplug: ok\n");
+    return 0;
+}
diff --git a/libs/input/tests/test_pad_input_map.c b/libs/input/tests/test_pad_input_map.c
new file mode 100644
index 0000000..4eef8a5
--- /dev/null
+++ b/libs/input/tests/test_pad_input_map.c
@@ -0,0 +1,352 @@
+/* The PS3_INPUT_MAP parser (pad_input_map.h): defaults, rebinding, the value
+ * forms, the [mouse] settings and unknown names.
+ *
+ *   cc -std=gnu17 -Wall -Wextra libs/input/tests/test_pad_input_map.c \
+ *      -o /tmp/test_pad_input_map && /tmp/test_pad_input_map
+ */
+#include "../pad_input_map.h"
+#include <assert.h>
+#include <unistd.h>
+
+static int key_of(const PadInputMap* m, int ctl, unsigned vk)
+{
+    return (m->key[ctl][vk >> 5] >> (vk & 31)) & 1;
+}
+
+static int n_keys(const PadInputMap* m, int ctl)
+{
+    int n = 0;
+    for (unsigned vk = 0; vk < 128; vk++) n += key_of(m, ctl, vk);
+    return n;
+}
+
+/* The built-in layout: a first-person shooter on keyboard and mouse. */
+static void test_defaults(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    static const struct { int ctl; unsigned vk; } fps[] = {
+        {PIM_UP, 0x7E}, {PIM_DOWN, 0x7D}, {PIM_LEFT, 0x7B}, {PIM_RIGHT, 0x7C},
+        {PIM_CROSS, 0x31},                                       /* Space: jump */
+        {PIM_CIRCLE, 0x08}, {PIM_CIRCLE, 0x3B}, {PIM_CIRCLE, 0x33},   /* C, Control, Backspace: crouch/back */
+        {PIM_SQUARE, 0x0F}, {PIM_SQUARE, 0x0E},                  /* R, E: reload/use */
+        {PIM_TRIANGLE, 0x0C},                                    /* Q: switch weapon */
+        {PIM_L1, 0x06}, {PIM_R1, 0x07}, {PIM_L2, 0x05}, {PIM_R2, 0x12},   /* Z X G 1 */
+        {PIM_L3, 0x38}, {PIM_R3, 0x09},                          /* Shift, V */
+        {PIM_START, 0x24}, {PIM_START, 0x4C}, {PIM_START, 0x35}, {PIM_START, 0x23},
+        {PIM_SELECT, 0x30}, {PIM_SELECT, 0x2E},
+        {PIM_LS_RIGHT, 0x02}, {PIM_LS_LEFT, 0x00}, {PIM_LS_DOWN, 0x01}, {PIM_LS_UP, 0x0D},
+        {PIM_RS_RIGHT, 0x25}, {PIM_RS_LEFT, 0x26}, {PIM_RS_DOWN, 0x28}, {PIM_RS_UP, 0x22},
+    };
+    int total = 0;
+    for (unsigned i = 0; i < sizeof fps / sizeof fps[0]; i++) assert(key_of(&m, fps[i].ctl, fps[i].vk));
+    for (int c = 0; c < PIM_N_CONTROLS; c++) total += n_keys(&m, c);
+    assert(total == (int)(sizeof fps / sizeof fps[0]));   /* nothing else bound ... */
+    for (unsigned vk = 0; vk < 128; vk++) {              /* ... and no key on two controls */
+        int on = 0;
+        for (int c = 0; c < PIM_N_CONTROLS; c++) on += key_of(&m, c, vk);
+        assert(on <= 1);
+    }
+    assert(m.mouse[PIM_R1] == 1 && m.mouse[PIM_L1] == 2 && m.mouse[PIM_R2] == 4);   /* fire, aim, weapon select */
+    assert(m.mouse[PIM_L2] == 8 && m.mouse[PIM_SQUARE] == 16);                     /* side buttons */
+    assert(m.mouse[PIM_TRIANGLE] == (PIM_MOUSE_WHEEL_UP | PIM_MOUSE_WHEEL_DOWN));
+    for (int c = 0; c < PIM_N_CONTROLS; c++)
+        if (c != PIM_R1 && c != PIM_R2 && c != PIM_L1 && c != PIM_L2 && c != PIM_SQUARE && c != PIM_TRIANGLE)
+            assert(m.mouse[c] == 0);
+    /* controller: each SDL button its namesake, triggers L2/R2, sticks unbound */
+    assert(m.pad[PIM_CROSS] == 1u << 0 && m.pad[PIM_CIRCLE] == 1u << 1);
+    assert(m.pad[PIM_SQUARE] == 1u << 2 && m.pad[PIM_TRIANGLE] == 1u << 3);
+    assert(m.pad[PIM_SELECT] == 1u << 4 && m.pad[PIM_START] == 1u << 6);
+    assert(m.pad[PIM_L3] == 1u << 7 && m.pad[PIM_R3] == 1u << 8);
+    assert(m.pad[PIM_L1] == 1u << 9 && m.pad[PIM_R1] == 1u << 10);
+    assert(m.pad[PIM_UP] == 1u << 11 && m.pad[PIM_DOWN] == 1u << 12);
+    assert(m.pad[PIM_LEFT] == 1u << 13 && m.pad[PIM_RIGHT] == 1u << 14);
+    assert(m.pad[PIM_L2] == 1u << PIM_PAD_TRIGGER_LEFT && m.pad[PIM_R2] == 1u << PIM_PAD_TRIGGER_RIGHT);
+    for (int c = PIM_LS_UP; c < PIM_N_CONTROLS; c++) assert(m.pad[c] == 0);
+    assert(m.mouse_camera == -1 && m.mouse_sens == 0.0f && m.mouse_deadzone == -1);
+    assert(m.n_set == 0 && m.n_warnings == 0);
+}
+
+static void test_empty_and_comments(void)
+{
+    PadInputMap a, b;
+    pim_defaults(&a);
+    pim_defaults(&b);
+    assert(pim_parse(&b, "", NULL, "t") == 0);
+    assert(pim_parse(&b, "# only a comment\n\n   ; another\n[keyboard]\n", NULL, "t") == 0);
+    assert(!memcmp(&a, &b, sizeof a));
+}
+
+static void test_rebind(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    const char* text =
+        "# a remap\r\n"
+        "[Keyboard]\r\n"
+        "cross = \"F\"            # one key\r\n"
+        "start = 'Return, Escape'\r\n"
+        "select = [\"Tab\", \"backspace\"]\r\n"
+        "L3 = \"\"\r\n"
+        "r3 = none\r\n"
+        "ls_up = Up\r\n"
+        "circle = \"Shift, RightOption, 0x0A\"\r\n"
+        "[mouse_buttons]\n"
+        "r1 = \"Right\"\n"
+        "r2 = \"Left\"\n"
+        "up = \"WheelUp\"\n"
+        "down = \"wheeldown, Button4\"\n"
+        "l1 = \"\"\n"
+        "[controller]\n"
+        "cross = \"b\"\n"
+        "circle = \"cross\"\n"
+        "select = \"touchpad, back\"\n"
+        "r1 = \"righttrigger\"\n"
+        "r2 = \"rightshoulder\"\n"
+        "rs_up = \"paddle1\"\n";
+    assert(pim_parse(&m, text, stderr, "rebind") == 0);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x03));
+    assert(n_keys(&m, PIM_START) == 2 && key_of(&m, PIM_START, 0x24) && key_of(&m, PIM_START, 0x35));
+    assert(n_keys(&m, PIM_SELECT) == 2 && key_of(&m, PIM_SELECT, 0x30) && key_of(&m, PIM_SELECT, 0x33));
+    assert(n_keys(&m, PIM_L3) == 0 && n_keys(&m, PIM_R3) == 0);
+    assert(n_keys(&m, PIM_LS_UP) == 1 && key_of(&m, PIM_LS_UP, 0x7E));
+    assert(n_keys(&m, PIM_UP) == 0);                     /* Up left the D-pad, which the file does not mention */
+    assert(n_keys(&m, PIM_CIRCLE) == 3 && key_of(&m, PIM_CIRCLE, 0x38) &&
+           key_of(&m, PIM_CIRCLE, 0x3D) && key_of(&m, PIM_CIRCLE, 0x0A));
+    assert(key_of(&m, PIM_SQUARE, 0x0E));                /* untouched controls keep their defaults */
+    assert(m.mouse[PIM_R1] == 2 && m.mouse[PIM_R2] == 1 && m.mouse[PIM_L1] == 0);
+    assert(m.mouse[PIM_UP] == PIM_MOUSE_WHEEL_UP);
+    assert(m.mouse[PIM_DOWN] == (PIM_MOUSE_WHEEL_DOWN | 8u));
+    assert(m.pad[PIM_CROSS] == 1u << 1 && m.pad[PIM_CIRCLE] == 1u << 0);
+    assert(m.pad[PIM_SELECT] == ((1u << 20) | (1u << 4)));
+    assert(m.pad[PIM_R1] == 1u << PIM_PAD_TRIGGER_RIGHT && m.pad[PIM_R2] == 1u << 10);
+    assert(m.pad[PIM_RS_UP] == 1u << 16);
+    assert(m.pad[PIM_SQUARE] == 1u << 2);
+    assert(m.n_set == 18);
+}
+
+/* Bound here = gone from the controls the text does not mention; listed
+ * twice = kept twice. */
+static void test_steal_and_overlap(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[keyboard]\ncross = \"Q\"\n[mouse_buttons]\nr2 = \"Button4\"\n", NULL, "s") == 0);
+    assert(key_of(&m, PIM_CROSS, 0x0C) && n_keys(&m, PIM_TRIANGLE) == 0);
+    assert(m.mouse[PIM_R2] == 8 && m.mouse[PIM_L2] == 0 && m.mouse[PIM_L1] == 2);
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[keyboard]\ncross = \"Q\"\ncircle = \"Q\"\n", NULL, "o") == 0);
+    assert(key_of(&m, PIM_CROSS, 0x0C) && key_of(&m, PIM_CIRCLE, 0x0C));
+}
+
+static void test_mouse_settings(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[mouse]\ncamera = false\nsensitivity = 1.75\ninvert_x = yes\n"
+                         "invert_y = true\ndeadzone = 500\ncapture = off\n", stderr, "mouse") == 0);
+    assert(m.mouse_camera == 0 && m.mouse_invert_x == 1 && m.mouse_invert_y == 1);
+    assert(m.mouse_sens > 1.74f && m.mouse_sens < 1.76f);
+    assert(m.mouse_deadzone == 120);                     /* clamped */
+    assert(m.mouse_capture == 0);
+    /* bad values leave the setting alone */
+    pim_defaults(&m);
+    assert(pim_parse(&m, "[mouse]\nsensitivity = fast\ndeadzone = -4\ninvert_y = maybe\n", NULL, "m") == 2);
+    assert(m.mouse_sens == 0.0f && m.mouse_deadzone == 0 && m.mouse_invert_y == -1);
+}
+
+static void test_unknown_names(void)
+{
+    PadInputMap m, d;
+    pim_defaults(&m);
+    pim_defaults(&d);
+    FILE* err = tmpfile();
+    assert(err);
+    const int n = pim_parse(&m,
+        "stray = 1\n"
+        "[keyboard]\n"
+        "cross = \"Space, Hyper\"\n"      /* Hyper unknown: Space still bound */
+        "jump = \"J\"\n"                  /* not a PS3 control */
+        "[joystick]\n"                    /* unknown section: its lines are skipped */
+        "cross = \"q\"\n"
+        "[mouse_buttons]\n"
+        "r1 = \"Button9\"\n"
+        "[controller]\n"
+        "cross = \"south\"\n"
+        "[mouse]\n"
+        "speed = 3\n"
+        "[keyboard]\n"
+        "this line has no equals sign\n",
+        err, "bad.toml");
+    assert(n == 8);
+    assert(m.n_warnings == 8);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x31));
+    assert(m.mouse[PIM_R1] == 0);                        /* the line still rebinds, to nothing known */
+    assert(m.pad[PIM_CROSS] == 0);
+    assert(n_keys(&m, PIM_CIRCLE) == n_keys(&d, PIM_CIRCLE));
+    rewind(err);
+    char buf[2048]; size_t r = fread(buf, 1, sizeof buf - 1, err); buf[r] = 0;
+    fclose(err);
+    assert(strstr(buf, "bad.toml:1: unknown setting outside a section 'stray'"));
+    assert(strstr(buf, "bad.toml:3: unknown key 'hyper'"));
+    assert(strstr(buf, "bad.toml:4: unknown PS3 control 'jump'"));
+    assert(strstr(buf, "bad.toml:5: unknown section 'joystick'"));
+    assert(strstr(buf, "bad.toml:8: unknown mouse button 'button9'"));
+    assert(strstr(buf, "bad.toml:10: unknown controller input 'south'"));
+    assert(strstr(buf, "bad.toml:12: unknown mouse setting 'speed'"));
+    assert(strstr(buf, "bad.toml:14: unknown line"));
+}
+
+static void test_load_file(void)
+{
+    PadInputMap m;
+    assert(pim_load_file(&m, "/nonexistent/input.toml", NULL) == 0);
+    PadInputMap d;
+    pim_defaults(&d);
+    assert(!memcmp(&m, &d, sizeof m));                   /* missing file = defaults */
+
+    char path[] = "/tmp/pim_testXXXXXX";
+    int fd = mkstemp(path);
+    assert(fd >= 0);
+    FILE* f = fdopen(fd, "w");
+    /* a long file: the reader grows its buffer past the first 4 KB */
+    for (int i = 0; i < 300; i++) fprintf(f, "# padding line %03d ...........................\n", i);
+    fprintf(f, "[keyboard]\ncross = \"Z\"\n");
+    fclose(f);
+    assert(pim_load_file(&m, path, stderr) == 1);
+    remove(path);
+    assert(n_keys(&m, PIM_CROSS) == 1 && key_of(&m, PIM_CROSS, 0x06));
+}
+
+static void test_keys_hit(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    uint32_t keys[4] = {0, 0, 0, 0};
+    keys[0x4C >> 5] |= 1u << (0x4C & 31);                /* keypad Enter */
+    assert(pim_keys_hit(&m, PIM_START, keys));
+    assert(!pim_keys_hit(&m, PIM_SELECT, keys));
+}
+
+/* Writing (pim_save_file): every canonical name reads back as itself,
+ * a written map reads back the same, the other sections stay, and saving
+ * again changes nothing. */
+static int maps_equal(const PadInputMap* a, const PadInputMap* b)
+{
+    return !memcmp(a->key, b->key, sizeof a->key) && !memcmp(a->mouse, b->mouse, sizeof a->mouse) &&
+           !memcmp(a->pad, b->pad, sizeof a->pad);
+}
+
+static void test_names_round_trip(void)
+{
+    char tmp[8], low[32];
+    for (unsigned vk = 0; vk < 128; vk++) {
+        const char* n = pim_key_label(vk, tmp, sizeof tmp);
+        snprintf(low, sizeof low, "%s", n);
+        pim_lower(low);
+        assert(pim_parse_key_name(low) == (int)vk);
+    }
+    for (int b = 0; b < 32; b++) {
+        const char* n = pim_mouse_label(1u << b);
+        if (!n) continue;
+        snprintf(low, sizeof low, "%s", n); pim_lower(low);
+        assert(pim_lookup(pim_mouse_buttons, PIM_COUNT(pim_mouse_buttons), low) == (int)(1u << b));
+    }
+    for (int b = 0; b <= PIM_PAD_TRIGGER_RIGHT; b++) {
+        const char* n = pim_pad_label(b);
+        assert(n);
+        assert(pim_lookup(pim_pad_inputs, PIM_COUNT(pim_pad_inputs), n) == b);
+    }
+    /* the launcher's spelling */
+    assert(!strcmp(pim_key_label(0x31, tmp, sizeof tmp), "Space"));
+    assert(!strcmp(pim_key_label(0x4C, tmp, sizeof tmp), "KeypadEnter"));
+    assert(!strcmp(pim_key_label(0x34, tmp, sizeof tmp), "0x34"));   /* no name */
+    assert(!strcmp(pim_pad_label(PIM_PAD_TRIGGER_LEFT), "lefttrigger"));
+}
+
+static void test_render_round_trip(void)
+{
+    PadInputMap m;
+    pim_defaults(&m);
+    char list[256];
+    pim_inputs_text(&m, PIM_SEC_KEYBOARD, PIM_START, list, sizeof list);
+    assert(!strcmp(list, "P, Return, Escape, KeypadEnter"));
+    pim_inputs_text(&m, PIM_SEC_MOUSE_BUTTONS, PIM_L1, list, sizeof list);
+    assert(!strcmp(list, "Right"));
+    pim_inputs_text(&m, PIM_SEC_MOUSE_BUTTONS, PIM_TRIANGLE, list, sizeof list);
+    assert(!strcmp(list, "WheelUp, WheelDown"));
+    pim_inputs_text(&m, PIM_SEC_CONTROLLER, PIM_CROSS, list, sizeof list);
+    assert(!strcmp(list, "a"));
+    pim_inputs_text(&m, PIM_SEC_CONTROLLER, PIM_LS_UP, list, sizeof list);
+    assert(!strcmp(list, ""));
+
+    /* a Controls screen moves Q from Triangle to Cross and puts R2 on the wheel */
+    assert(pim_rebind(&m, PIM_SEC_KEYBOARD, PIM_CROSS, 0x0C) == 1u << PIM_TRIANGLE);
+    assert(key_of(&m, PIM_CROSS, 0x0C) && n_keys(&m, PIM_CROSS) == 1 && n_keys(&m, PIM_TRIANGLE) == 0);
+    assert(pim_rebind(&m, PIM_SEC_MOUSE_BUTTONS, PIM_R2, PIM_MOUSE_WHEEL_DOWN) == 1u << PIM_TRIANGLE);
+    assert(m.mouse[PIM_R2] == PIM_MOUSE_WHEEL_DOWN);
+    assert(pim_rebind(&m, PIM_SEC_CONTROLLER, PIM_R1, PIM_PAD_TRIGGER_RIGHT) == 1u << PIM_R2);
+    pim_unbind(&m, PIM_SEC_CONTROLLER, PIM_SELECT);
+
+    const char* old =
+        "# hand-written\n"
+        "[keyboard]\n"
+        "cross = \"F\"\n"
+        "\n"
+        "[mouse]\n"
+        "sensitivity = 1.5   # fast\n"
+        "invert_y = true\n"
+        "\n"
+        "[controller]\n"
+        "cross = \"b\"\n"
+        "[future]\n"
+        "x = 1\n";
+    char* text = pim_render(&m, old);
+    assert(text);
+    assert(strstr(text, "\n[keyboard]\ncross    = \"Q\"\ncircle   = \"C, Backspace, Control\"\n"));
+    assert(strstr(text, "triangle = \"\"\n"));
+    assert(strstr(text, "start    = \"P, Return, Escape, KeypadEnter\"\n"));
+    assert(strstr(text, "\n[mouse]\nsensitivity = 1.5   # fast\ninvert_y = true\n"));
+    assert(strstr(text, "\n[future]\nx = 1\n"));
+    assert(!strstr(text, "hand-written"));          /* the preamble is the writer's own */
+    assert(!strstr(text, "cross = \"b\""));         /* the old bindings are gone */
+    PadInputMap back;
+    pim_defaults(&back);
+    assert(pim_parse(&back, text, NULL, "rendered") == 1);   /* [future]: unknown to the game too */
+    assert(maps_equal(&m, &back));
+    assert(back.mouse_sens == 1.5f && back.mouse_invert_y == 1);
+    /* saving again changes nothing */
+    char* again = pim_render(&back, text);
+    assert(again && !strcmp(again, text));
+    free(again);
+    free(text);
+
+    /* through a file, into a folder that does not exist yet */
+    char dir[] = "/tmp/pim_save_XXXXXX";
+    assert(mkdtemp(dir));
+    char path[256];
+    snprintf(path, sizeof path, "%s/sub/input.toml", dir);
+    assert(pim_save_file(&m, path));
+    PadInputMap loaded;
+    assert(pim_load_file(&loaded, path, stderr));
+    assert(maps_equal(&m, &loaded) && loaded.n_warnings == 0);
+    remove(path);
+    snprintf(path, sizeof path, "%s/sub", dir); rmdir(path);
+    rmdir(dir);
+}
+
+int main(void)
+{
+    test_defaults();
+    test_empty_and_comments();
+    test_rebind();
+    test_steal_and_overlap();
+    test_mouse_settings();
+    test_unknown_names();
+    test_load_file();
+    test_keys_hit();
+    test_names_round_trip();
+    test_render_round_trip();
+    printf("test_pad_input_map: ok\n");
+    return 0;
+}
diff --git a/libs/input/tests/test_pad_keymap.c b/libs/input/tests/test_pad_keymap.c
new file mode 100644
index 0000000..2754b62
--- /dev/null
+++ b/libs/input/tests/test_pad_keymap.c
@@ -0,0 +1,303 @@
+/* cellPad's keyboard/mouse pad: the window's ps3_host_input block -> port 0
+ * through the built-in FPS layout or PS3_INPUT_MAP; the mouse camera on the
+ * right stick; wheel notches as presses; what the game tells the window
+ * (game_flags); PS3_INPUT_MODE; a controller on port 0 merged with the keys.
+ *
+ *   clang -std=gnu17 -I include $(sdl2-config --cflags) -I "$(sdl2-config --prefix)/include" \
+ *         libs/input/tests/test_pad_keymap.c $(sdl2-config --libs) -o /tmp/test_pad_keymap && /tmp/test_pad_keymap
+ */
+#include "../cellPad.c"
+#include <assert.h>
+#include <unistd.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+u32 cellGcm_flip_request_count(void) { return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+/* The window's block: the shared one, as the window host hands it over. */
+static ps3_host_input s_win;
+
+static void press_only(const unsigned* vks, int n)
+{
+    for (int i = 0; i < 4; i++) atomic_store(&s_win.keys[i], 0);
+    for (int i = 0; i < n; i++) ps3_host_input_key(&s_win, vks[i], 1);
+}
+
+static u16 buttons_for(unsigned vk)
+{
+    press_only(&vk, 1);
+    pad_poll_keys(0);
+    return s_host_state[0].buttons;
+}
+
+static void reload_settings(void)
+{
+    s_map_state = 0;
+    pad_map_load();
+    s_mouse_on = -1;
+    s_input_mode = -1;
+}
+
+static void test_fps_layout(void)
+{
+    unsetenv("PS3_INPUT_MAP");
+    reload_settings();
+    static const struct { unsigned vk; u16 btn; } k[] = {
+        {0x31, CELL_PAD_CTRL_CROSS},                                  /* Space: jump */
+        {0x08, CELL_PAD_CTRL_CIRCLE}, {0x3B, CELL_PAD_CTRL_CIRCLE},   /* C, Control: crouch */
+        {0x33, CELL_PAD_CTRL_CIRCLE},                                 /* Backspace: back in menus */
+        {0x0F, CELL_PAD_CTRL_SQUARE}, {0x0E, CELL_PAD_CTRL_SQUARE},   /* R, E: reload/use */
+        {0x0C, CELL_PAD_CTRL_TRIANGLE},                               /* Q: switch weapon */
+        {0x05, CELL_PAD_CTRL_L2}, {0x12, CELL_PAD_CTRL_R2},           /* G grenade, 1 weapon select */
+        {0x06, CELL_PAD_CTRL_L1}, {0x07, CELL_PAD_CTRL_R1},           /* Z aim, X fire */
+        {0x38, CELL_PAD_CTRL_L3}, {0x09, CELL_PAD_CTRL_R3},           /* Shift, V */
+        {0x24, CELL_PAD_CTRL_START}, {0x4C, CELL_PAD_CTRL_START},
+        {0x35, CELL_PAD_CTRL_START}, {0x23, CELL_PAD_CTRL_START},     /* Return, Enter, Esc, P */
+        {0x30, CELL_PAD_CTRL_SELECT}, {0x2E, CELL_PAD_CTRL_SELECT},   /* Tab, M: map */
+        {0x7E, CELL_PAD_CTRL_UP}, {0x7D, CELL_PAD_CTRL_DOWN},
+        {0x7B, CELL_PAD_CTRL_LEFT}, {0x7C, CELL_PAD_CTRL_RIGHT},
+    };
+    for (unsigned i = 0; i < sizeof k / sizeof k[0]; i++) {
+        assert(buttons_for(k[i].vk) == k[i].btn);
+        const PadHostState* hs = &s_host_state[0];
+        assert(hs->connected && hs->analog_lx == 128 && hs->analog_ly == 128);
+        assert(hs->trigger_l2 == ((k[i].btn & CELL_PAD_CTRL_L2) ? 255 : 0));
+        assert(hs->trigger_r2 == ((k[i].btn & CELL_PAD_CTRL_R2) ? 255 : 0));
+    }
+    /* WASD walks, IJKL looks */
+    unsigned wd[2] = {0x0D, 0x02};
+    press_only(wd, 2); pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0 && s_host_state[0].analog_ly == 0 && s_host_state[0].analog_lx == 255);
+    unsigned as[2] = {0x00, 0x01};
+    press_only(as, 2); pad_poll_keys(0);
+    assert(s_host_state[0].analog_lx == 0 && s_host_state[0].analog_ly == 255);
+    unsigned ad[2] = {0x00, 0x02};                 /* opposite keys: 127, as always */
+    press_only(ad, 2); pad_poll_keys(0);
+    assert(s_host_state[0].analog_lx == 127);
+    unsigned jk[2] = {0x26, 0x28};
+    press_only(jk, 2); pad_poll_keys(0);
+    assert(s_host_state[0].analog_rx == 0 && s_host_state[0].analog_ry == 255);
+    /* nothing held: centred, nothing pressed (not 0,0 = up-left) */
+    press_only(NULL, 0); pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0);
+    assert(s_host_state[0].analog_lx == 128 && s_host_state[0].analog_ly == 128);
+    assert(s_host_state[0].analog_rx == 128 && s_host_state[0].analog_ry == 128);
+    /* unbound keys do nothing */
+    assert(buttons_for(0x11) == 0 && buttons_for(0x7A) == 0);   /* T, F1 */
+
+    /* mouse buttons: left fire, right aim, middle weapon select, side buttons */
+    press_only(NULL, 0);
+    static const struct { uint32_t b; u16 btn; } mb[] = {
+        {1, CELL_PAD_CTRL_R1}, {2, CELL_PAD_CTRL_L1}, {4, CELL_PAD_CTRL_R2},
+        {8, CELL_PAD_CTRL_L2}, {16, CELL_PAD_CTRL_SQUARE}, {32, 0},
+        {1 | 2, CELL_PAD_CTRL_R1 | CELL_PAD_CTRL_L1},
+    };
+    for (unsigned i = 0; i < sizeof mb / sizeof mb[0]; i++) {
+        atomic_store(&s_win.mouse_buttons, mb[i].b);
+        pad_poll_keys(0);
+        assert(s_host_state[0].buttons == mb[i].btn);
+    }
+    atomic_store(&s_win.mouse_buttons, 0);
+    pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0);
+
+    /* two wheel notches (either way): two separate presses of Triangle */
+    usleep(150 * 1000);
+    atomic_store(&s_win.wheel, -32);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_TRIANGLE);
+    usleep(85 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    usleep(50 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_TRIANGLE);
+    usleep(130 * 1000);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    assert(atomic_load(&s_win.wheel) == 0);       /* drained */
+
+    /* the game tells the window to capture the mouse on a click */
+    assert(atomic_load(&s_win.game_flags) ==
+           (PS3_HOST_INPUT_ACTIVE | PS3_HOST_INPUT_MOUSE_CAMERA | PS3_HOST_INPUT_CAPTURE));
+}
+
+static void test_mouse_camera(void)
+{
+    unsetenv("PS3_INPUT_MAP");
+    unsetenv("PS3_MOUSE_SENS");
+    unsetenv("PS3_MOUSE_INVERT_Y");
+    reload_settings();
+    press_only(NULL, 0);
+    pad_poll_keys(0);
+    usleep(16 * 1000);
+    /* a move right and up: the right stick goes right and up, past the dead zone */
+    atomic_store(&s_win.mouse_dx, 10 * 16);
+    atomic_store(&s_win.mouse_dy, -10 * 16);
+    pad_poll_keys(0);
+    const int rx = s_host_state[0].analog_rx, ry = s_host_state[0].analog_ry;
+    assert(rx > 128 + 30 && ry < 128 - 30);
+    assert(atomic_load(&s_win.mouse_dx) == 0 && atomic_load(&s_win.mouse_dy) == 0);   /* drained */
+    /* the stick eases back once the mouse stops */
+    for (int i = 0; i < 30; i++) { usleep(5 * 1000); pad_poll_keys(0); }
+    assert(s_host_state[0].analog_rx == 128 && s_host_state[0].analog_ry == 128);
+
+    /* PS3_MOUSE_INVERT_Y=1: up looks down */
+    setenv("PS3_MOUSE_INVERT_Y", "1", 1);
+    s_mouse_on = -1;
+    usleep(16 * 1000);
+    atomic_store(&s_win.mouse_dy, -10 * 16);
+    pad_poll_keys(0);
+    assert(s_host_state[0].analog_ry > 128 + 30);
+    unsetenv("PS3_MOUSE_INVERT_Y");
+    for (int i = 0; i < 30; i++) { usleep(5 * 1000); pad_poll_keys(0); }
+
+    /* PS3_MOUSE=0: no camera, no buttons, no capture -- and the motion is
+     * still drained, so nothing jumps when it comes back */
+    setenv("PS3_MOUSE", "0", 1);
+    s_mouse_on = -1;
+    atomic_store(&s_win.mouse_dx, 50 * 16);
+    atomic_store(&s_win.mouse_buttons, 1);
+    pad_poll_keys(0);
+    assert(s_host_state[0].analog_rx == 128 && s_host_state[0].buttons == 0);
+    assert(atomic_load(&s_win.mouse_dx) == 0);
+    assert(atomic_load(&s_win.game_flags) == PS3_HOST_INPUT_ACTIVE);
+    atomic_store(&s_win.mouse_buttons, 0);
+    unsetenv("PS3_MOUSE");
+
+    /* PS3_MOUSE_CAPTURE=0: the camera stays, the window does not capture */
+    setenv("PS3_MOUSE_CAPTURE", "0", 1);
+    s_mouse_on = -1;
+    pad_poll_keys(0);
+    assert(atomic_load(&s_win.game_flags) == (PS3_HOST_INPUT_ACTIVE | PS3_HOST_INPUT_MOUSE_CAMERA));
+    unsetenv("PS3_MOUSE_CAPTURE");
+    s_mouse_on = -1;
+}
+
+static void test_mapped_layout(void)
+{
+    char path[] = "/tmp/pad_keymap_XXXXXX";
+    int fd = mkstemp(path);
+    FILE* f = fdopen(fd, "w");
+    fputs("[keyboard]\n"
+          "cross  = \"F, Shift\"\n"     /* Shift leaves L3 */
+          "circle = \"\"\n"             /* C, Control, Backspace do nothing now */
+          "ls_up  = \"Up\"\n"           /* the arrow walks forward ... */
+          "up     = \"T\"\n"            /* ... and the D-pad up moved to T */
+          "[mouse_buttons]\n"
+          "r1 = \"Button4\"\n"          /* Button4 leaves L2 */
+          "up = \"WheelUp\"\n"          /* WheelUp leaves Triangle */
+          "[mouse]\n"
+          "capture = false\n"
+          "sensitivity = 2.0\n", f);
+    fclose(f);
+    setenv("PS3_INPUT_MAP", path, 1);
+    reload_settings();
+    remove(path);
+
+    assert(buttons_for(0x03) == CELL_PAD_CTRL_CROSS);
+    assert(buttons_for(0x38) == CELL_PAD_CTRL_CROSS);
+    assert(buttons_for(0x31) == 0);                     /* cross is F and Shift only now */
+    assert(buttons_for(0x08) == 0 && buttons_for(0x3B) == 0);
+    unsigned k = 0x7E; press_only(&k, 1); pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0 && s_host_state[0].analog_ly == 0);
+    assert(buttons_for(0x11) == CELL_PAD_CTRL_UP);
+    assert(buttons_for(0x0E) == CELL_PAD_CTRL_SQUARE);   /* untouched */
+    press_only(NULL, 0);
+    atomic_store(&s_win.mouse_buttons, 1); pad_poll_keys(0); assert(s_host_state[0].buttons == 0);
+    atomic_store(&s_win.mouse_buttons, 8); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_R1);
+    atomic_store(&s_win.mouse_buttons, 2); pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_L1);
+    atomic_store(&s_win.mouse_buttons, 0);
+    usleep(150 * 1000);
+    atomic_store(&s_win.wheel, 16);
+    pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_UP);
+    usleep(150 * 1000);
+    pad_poll_keys(0);
+    atomic_store(&s_win.wheel, -16);                     /* down: still Triangle */
+    pad_poll_keys(0); assert(s_host_state[0].buttons == CELL_PAD_CTRL_TRIANGLE);
+    usleep(150 * 1000);
+    pad_poll_keys(0);
+    assert(s_mouse_sens == 2.0f);
+    /* capture: the file says no, the variable wins */
+    assert(atomic_load(&s_win.game_flags) == (PS3_HOST_INPUT_ACTIVE | PS3_HOST_INPUT_MOUSE_CAMERA));
+    setenv("PS3_MOUSE_CAPTURE", "1", 1);
+    s_mouse_on = -1;
+    pad_poll_keys(0);
+    assert(atomic_load(&s_win.game_flags) & PS3_HOST_INPUT_CAPTURE);
+    unsetenv("PS3_MOUSE_CAPTURE");
+    unsetenv("PS3_INPUT_MAP");
+    reload_settings();
+}
+
+static void test_input_mode_and_merge(void)
+{
+    press_only(NULL, 0);
+    /* a controller on port 0 holding Cross and the left stick right; the
+     * keyboard adds Square and moves the right stick */
+    PadHostState* hs = &s_host_state[0];
+    const unsigned keys[2] = {0x0F, 0x25};   /* R, L */
+    press_only(keys, 2);
+    memset(hs, 0, sizeof *hs);
+    hs->connected = 1; hs->buttons = CELL_PAD_CTRL_CROSS;
+    hs->analog_lx = 255; hs->analog_ly = hs->analog_rx = hs->analog_ry = 128;
+    hs->trigger_l2 = 90;
+    pad_poll_keys(1);
+    assert(hs->buttons == (CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_SQUARE));
+    assert(hs->analog_lx == 255 && hs->analog_rx == 255 && hs->analog_ly == 128);
+    assert(hs->trigger_l2 == 90);            /* an analog trigger keeps its own value */
+
+    /* PS3_INPUT_MODE=controller: the keys do nothing, the mouse does not ask
+     * for the cursor */
+    setenv("PS3_INPUT_MODE", "controller", 1);
+    s_input_mode = -1;
+    hs->buttons = CELL_PAD_CTRL_CROSS; hs->analog_rx = 128;
+    pad_poll_keys(1);
+    assert(hs->buttons == CELL_PAD_CTRL_CROSS && hs->analog_rx == 128);
+    assert(atomic_load(&s_win.game_flags) == PS3_HOST_INPUT_ACTIVE);
+    assert(pad_input_mode_from("Gamepad") == PAD_MODE_CONTROLLER);
+    assert(pad_input_mode_from("KBM") == PAD_MODE_KEYBOARD);
+    assert(pad_input_mode_from("nonsense") == PAD_MODE_BOTH);
+    assert(pad_input_mode_from(NULL) == PAD_MODE_BOTH);
+    unsetenv("PS3_INPUT_MODE");
+    s_input_mode = -1;
+    press_only(NULL, 0);
+}
+
+static void test_attach(void)
+{
+    /* Until the backend attaches the window host's block, the local one is
+     * read (the backend's own window fills it); detaching goes back to it. */
+    ps3_pad_host_input_attach(NULL);
+    assert(ps3_pad_host_input() == &s_input_local);
+    unsigned k = 0x31;
+    press_only(&k, 1);                       /* in the window host's block */
+    pad_poll_keys(0);
+    assert(s_host_state[0].buttons == 0);
+    ps3_host_input_key(&s_input_local, 0x31, 1);
+    pad_poll_keys(0);
+    assert(s_host_state[0].buttons == CELL_PAD_CTRL_CROSS);
+    ps3_host_input_release_all(&s_input_local);
+    ps3_pad_host_input_attach(&s_win);
+    assert(ps3_pad_host_input() == &s_win);
+    pad_poll_keys(0);
+    assert(s_host_state[0].buttons == CELL_PAD_CTRL_CROSS);
+    press_only(NULL, 0);
+}
+
+int main(void)
+{
+    unsetenv("PS3_MOUSE");
+    unsetenv("PS3_MOUSE_CAPTURE");
+    unsetenv("PS3_INPUT_MODE");
+    ps3_pad_host_input_attach(&s_win);
+    test_fps_layout();
+    test_mouse_camera();
+    test_mapped_layout();
+    test_input_mode_and_merge();
+    test_attach();
+    printf("test_pad_keymap: ok\n");
+    return 0;
+}

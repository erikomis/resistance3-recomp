+/* Signed in with no psnr server: PS3_NP_SIGNIN=1 together with
+ * PS3_NET_ONLINE=1. For community servers that take the player's name from
+ * the ticket and do not check Sony's signature (the Medius servers revival
+ * projects run, PS Rewired's for Resistance among them); the ticket is made
+ * here (np_local_ticket). Read every time: the tests flip it. */
+static int np_local_signin(void)
+{
+    const char* s = getenv("PS3_NP_SIGNIN");
+    const char* o = getenv("PS3_NET_ONLINE");
+    return s && *s && s[0] != '0' && o && *o && o[0] != '0';
+}
+
+static int np_signed_in(void)
+{
+    return np_psnr_enabled() || np_local_signin();
+}

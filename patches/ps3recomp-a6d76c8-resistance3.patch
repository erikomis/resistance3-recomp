+    const rsx_vertex_ref orig[6] = { {7, 1}, {5, 1}, {6, 1}, {7, 1}, {5, 1}, {6, 1} };
+    int maps = 1;
+    for (u32 i = 0; i < 6; i++)
+        maps &= refs[rsx_vertex_remap_index(&remap, i)].vertex_id == orig[i].vertex_id;
+    CHECK(maps, "every occurrence maps back to its own vertex");

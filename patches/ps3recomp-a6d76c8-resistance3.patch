+/* ---- coherence around copy-engine (NV0039) transfers --------------------- */
+
+/* Whether [offset, offset + bytes) and [base, base + len) share a byte. */
+static int eng_ranges_overlap(u32 offset, u32 bytes, u32 base, u32 len)
+{
+    return bytes && len && offset < base + len && base < offset + bytes;
+}
+
+static int eng_m2mf_coherence_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3RECOMP_ENG_M2MF_COH"); on = e ? atoi(e) : 1; }
+    return on;
+}
+
+/* The bytes a surface or a zeta occupies in guest memory: its rows at its
+ * pitch, or the Morton block of a swizzled zeta. */
+static u32 eng_surface_guest_bytes(const eng_surface* s)
+{
+    const u32 bpp = eng_transfer_bpp(s->fmt) ? eng_transfer_bpp(s->fmt) : 4u;
+    return (s->pitch ? s->pitch : s->w * bpp) * s->h;
+}
+
+/* The engine's own stores into guest memory (a zeta or a target read back)
+ * are not "the guest wrote it": a surface a GPU blit filled keeps a hash of
+ * its guest bytes to notice real guest writes, and the engine writing those
+ * bytes itself falsely retired it. Re-take the hash after such a store. */
+static void eng_blit_hash_resync(u32 location, u32 offset, u32 bytes)
+{
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        eng_surface* s = &g.surfaces[i];
+        /* likewise a small target's evict_hash (PS3RECOMP_ENG_EVICT_STORE_SMALL) */
+        if (s->handle && s->evict_bytes && s->location == location &&
+            eng_ranges_overlap(offset, bytes, s->offset, s->evict_bytes)) {
+            int readable = 0;
+            const u64 h = eng_texture_content_hash(s->location, s->offset, s->evict_bytes, &readable);
+            if (readable) s->evict_hash = h; else s->evict_bytes = 0;
+        }
+        if (!s->handle || !s->blit_serial || s->location != location ||
+            !eng_ranges_overlap(offset, bytes, s->offset, eng_surface_guest_bytes(s)))
+            continue;
+        int readable = 0;
+        const u64 h = eng_texture_sparse_hash(s->location, s->offset,
+                                              eng_surface_guest_bytes(s), &readable);
+        if (readable) s->blit_guest_hash = h;
+    }
+}
+
+static u32 eng_zdepth_guest_bytes(const eng_zdepth* z)
+{
+    const u32 bpp = (z->zfmt == 1u) ? 2u : 4u;
+    const u32 w = z->used_w && z->used_w < z->w ? z->used_w : z->w;
+    const u32 h = z->used_h && z->used_h < z->h ? z->used_h : z->h;
+    return z->swizzled ? w * h * bpp : z->pitch * h;
+}
+
+void rsx_draw_engine_m2mf_read(u32 location, u32 offset, u32 bytes)
+{
+    if (!g.ready || !bytes || !eng_m2mf_coherence_on()) return;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        eng_surface* s = &g.surfaces[i];
+        if (!s->handle || s->location != location || !s->guest_dirty ||
+            !eng_ranges_overlap(offset, bytes, s->offset, eng_surface_guest_bytes(s)))
+            continue;

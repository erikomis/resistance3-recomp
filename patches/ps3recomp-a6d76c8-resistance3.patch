+/* ---- the archive (every function here runs on s_pc_io) ----
+ * An MTLBinaryArchive is written ONCE: a fresh one takes a batch of
+ * descriptors, is serialized and dropped. Adding to an archive that was
+ * loaded from a file, or serializing one a second time, is what the first
+ * version did and it does not work when pipelines share functions (they all
+ * do): the second serializeToURL fails with "missing 'vertex' stage in
+ * pipeline no. N" / "expecting 'fragment' stage", and the next one succeeds
+ * but holds only the additions since -- 37 of 617 pipelines survived a
+ * session, and one such save was 95.7 MB. (Reproduced outside the game with
+ * the recorded pipelines: one archive, 741 additions, one serialize is
+ * 16.7 MB and 741 hits; the same in steps of 64 fails every second save.)
+ * So the archive on disk is a set of chunk files,
+ * pipelines-<os and gpu>-<n>.metalarchive, all of them given to
+ * descriptor.binaryArchives; a save writes the pipelines waiting in
+ * s_pa_pend as a new chunk; and when there are more than
+ * PS3_PIPELINE_ARCHIVE_CHUNKS (6) of them the boot prewarm writes everything
+ * it rebuilds into one chunk and removes the others. Past
+ * PS3_PIPELINE_ARCHIVE_MAX_MB (192) nothing more is written. */
+static NSMutableArray<MTLRenderPipelineDescriptor*>* s_pa_pend;
+static NSMutableArray<NSNumber*>* s_pa_pend_key;
+static NSMutableArray<NSString*>* s_pa_files;   /* this OS and GPU's chunks on disk */
+static char s_pa_prefix[64];
+static u32 s_pa_seq;                            /* the next chunk's number */
+static uint64_t s_pa_bytes, s_pa_max_bytes = 192ull << 20;
+static u32 s_pa_max_chunks = 6;
+
+static uint64_t pa_file_size(const char* path)
+{
+    struct stat st;
+    return stat(path, &st) == 0 ? (uint64_t)st.st_size : 0;
+}
 
+/* descs[lo, hi) as one chunk file. 1 when everything was written into a
+ * single file; 0 when it was split, something was dropped, or it failed. A
+ * batch that does not serialize is halved until the descriptor at fault is
+ * alone, which is named and left out. */
+static int pa_write_chunk(NSArray<MTLRenderPipelineDescriptor*>* descs, NSArray<NSNumber*>* keys,
+                          NSUInteger lo, NSUInteger hi, u32* written) API_AVAILABLE(macos(11.0))
+{
+    if (hi <= lo) return 1;
     NSError* err = nil;
-    id<MTLRenderPipelineState> pso =
-        [s_dev newRenderPipelineStateWithDescriptor:pd error:&err];
-    if (!pso) {
-        fprintf(stderr, "[rsx engine/metal] pipeline state failed: %s\n",
-                [[err localizedDescription] UTF8String]);
+    int whole = 1;
+    u32 n = 0;
+    BOOL ok = NO;
+    char path[1500], tmp[1560];
+    snprintf(path, sizeof path, "%s/%s-%04u.metalarchive", s_sc_dir, s_pa_prefix, s_pa_seq);
+    snprintf(tmp, sizeof tmp, "%s.%d.tmp", path, (int)getpid());
+    @autoreleasepool {
+        id<MTLBinaryArchive> ar = [s_dev newBinaryArchiveWithDescriptor:[MTLBinaryArchiveDescriptor new] error:&err];
+        if (!ar) {
+            fprintf(stderr, "[pipeline cache] no archive: %s\n", [[err localizedDescription] UTF8String]);
+            return 0;
+        }
+        for (NSUInteger i = lo; i < hi; i++) {
+            /* A descriptor with a stage missing is what the packer chokes on. */
+            MTLRenderPipelineDescriptor* d = descs[i];
+            NSError* e = nil;
+            if (d.vertexFunction && d.fragmentFunction &&
+                [ar addRenderPipelineFunctionsWithDescriptor:d error:&e]) { n++; continue; }
+            whole = 0;
+            static int logged;
+            if (logged++ < 8)
+                fprintf(stderr, "[pipeline cache] archive: pipeline %016llx left out (%s)\n",
+                        [keys[i] unsignedLongLongValue],
+                        e ? [[e localizedDescription] UTF8String] : "a stage is missing");
+        }
+        if (!n) return 0;
+        ok = [ar serializeToURL:[NSURL fileURLWithPath:[NSString stringWithUTF8String:tmp]] error:&err];
+        if (ok && rename(tmp, path) != 0) ok = NO;
+        if (!ok) unlink(tmp);
+    }
+    if (ok) {
+        s_pa_seq++;
+        s_pa_bytes += pa_file_size(path);
+        [s_pa_files addObject:[NSString stringWithUTF8String:path]];
+        *written += n;
+        return whole;
+    }
+    static int logged;
+    if (hi - lo == 1) {
+        if (logged++ < 8)
+            fprintf(stderr, "[pipeline cache] archive: pipeline %016llx cannot be serialized, left out\n",
+                    [keys[lo] unsignedLongLongValue]);
+        return 0;
+    }
+    if (logged++ < 8) {
+        NSString* why = [err localizedDescription];
+        if (why.length > 120) why = [why substringFromIndex:why.length - 120];
+        fprintf(stderr, "[pipeline cache] archive: a save of %u failed (...%s); retried in halves\n",
+                (unsigned)(hi - lo), why ? [why UTF8String] : "?");
+    }
+    const NSUInteger mid = lo + (hi - lo) / 2;
+    pa_write_chunk(descs, keys, lo, mid, written);
+    pa_write_chunk(descs, keys, mid, hi, written);
+    return 0;
+}

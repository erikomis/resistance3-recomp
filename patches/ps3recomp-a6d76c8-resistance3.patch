--- a/libs/network/sceNp.c
+++ b/libs/network/sceNp.c
@@ -9,6 +9,8 @@
 #include <stdio.h>
 #include <string.h>
 #include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
 #include "np_psnr.h"
 #include "../system/cellSysutil.h"
@@ -225,6 +227,23 @@ s32 sceNpGetMyLanguages(SceNpMyLanguages* langs)

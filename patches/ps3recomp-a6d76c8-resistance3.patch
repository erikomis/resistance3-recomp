+/* Walk the shadow to put. Decodes exactly what the walker's loop treats as
+ * control flow, in the same order. Caller holds s_sh_lock.
+ *
+ * To the put in the register NOW, never to one a caller read earlier. The
+ * walker reads put at the top of its pass and gets here microseconds later;
+ * if the watcher has already followed a newer put, walking "to" the old one
+ * meant walking on from the new list's end -- over the stale JUMP standing
+ * there, into last round's copy of the other list -- and filing that as a
+ * fetched list. The walker then executed it: Resistance 3's frame label came
+ * back with the previous round's value (SEMA-REL 3, 5, 3 at boot instead of
+ * 3, 5, 7), its end-of-frame wait ran out both 2.5 s timeouts, and when the
+ * stale copy stayed one round behind every frame did (boot111: 200 s on the
+ * logo at one frame per 5 s). */
+static void gcm_sh_advance(void)
+{
+    const u32 put = vm_read32(GCM_CONTROL_GUEST_ADDR + 0);
+    atomic_thread_fence(memory_order_acquire);   /* commands, fence, then put */
+    s_sh_put = put;
+    if (!s_sh_valid) return;
+    int budget = 1 << 18;
+    while (s_sh_pos != put && budget-- > 0) {
+        const u32 ea = gcm_io2ea(s_sh_pos);
+        if (!ea) { s_sh_valid = 0; break; }
+        const u32 w = vm_read32(ea);
+        if ((w & 0xFFFF0000u) == 0xFEAD0000u) {
+            gcm_sl_push(s_sh_pos, 0xFEADu, w, w);
+            s_sh_pos += 4;
+            continue;
+        }
+        if ((w >> 29) == 1u) {
+            const u32 tgt = w & 0x1FFFFFFCu;
+            if (!gcm_io2ea(tgt)) { s_sh_valid = 0; break; }
+            if (tgt == s_sh_pos) break;                     /* parked */
+            gcm_sh_extend();
+            { gcm_sh_rec* r = gcm_sh_lookup(s_sh_cur);      /* the JUMP out */
+              if (r && !r->dead && !s_sh_call && s_sh_pos == r->start + r->len) {
+                  memcpy(r->data + r->len, vm_base + ea, 4);
+                  r->exit_known = 1;
+              }
+              if (r) r->open = 0; }
+            s_sh_pos = tgt;
+            { gcm_sh_rec* r = &s_sh_rec[s_sh_nrec % GCM_SH_RECS];
+              if (!r->data) r->data = (u8*)malloc(GCM_SH_CAP + 8u);
+              r->start = tgt; r->len = 0; r->seq = ++s_sh_nrec;
+              r->open = 1; r->exit_known = 0; r->dead = r->data ? 0 : 1;
+              s_sh_cur = r->seq; }
+            continue;
+        }
+        if ((w & 3u) == 2u) {
+            const u32 tgt = w & 0x1FFFFFFCu;
+            if (!gcm_io2ea(tgt)) { s_sh_valid = 0; break; }
+            gcm_sh_extend();
+            s_sh_call = s_sh_pos + 4;
+            s_sh_pos = tgt;
+            continue;
+        }
+        if (w == 0x00020000u) {
+            if (!s_sh_call) { s_sh_valid = 0; break; }
+            s_sh_pos = s_sh_call; s_sh_call = 0;
+            continue;
+        }
+        if ((w >> 29) == 0u || (w >> 29) == 2u) {
+            const u32 count = (w >> 18) & 0x7FFu, method = w & 0x1FFCu;

+{
+    u8 pal[4][4];
+    const u32 c[2] = { (u32)b[0] | ((u32)b[1] << 8), (u32)b[2] | ((u32)b[3] << 8) };
+    for (int k = 0; k < 2; k++) {
+        pal[k][0] = (u8)(((c[k] >> 11) & 31u) * 255u / 31u);
+        pal[k][1] = (u8)(((c[k] >> 5) & 63u) * 255u / 63u);
+        pal[k][2] = (u8)((c[k] & 31u) * 255u / 31u);
+        pal[k][3] = 255;
+    }
+    for (int ch = 0; ch < 3; ch++) {
+        if (!punch || c[0] > c[1]) {
+            pal[2][ch] = (u8)((2 * pal[0][ch] + pal[1][ch] + 1) / 3);
+            pal[3][ch] = (u8)((pal[0][ch] + 2 * pal[1][ch] + 1) / 3);
+        } else {
+            pal[2][ch] = (u8)((pal[0][ch] + pal[1][ch] + 1) / 2);
+            pal[3][ch] = 0;
+        }
+    }
+    pal[2][3] = 255;
+    pal[3][3] = (!punch || c[0] > c[1]) ? 255 : 0;
+    const u32 idx = (u32)b[4] | ((u32)b[5] << 8) | ((u32)b[6] << 16) | ((u32)b[7] << 24);
+    for (int i = 0; i < 16; i++) memcpy(out[i], pal[(idx >> (2 * i)) & 3u], 4);
+}
+static void eng_bc_decode(const u8* blocks, u32 row_bytes, u32 w, u32 h, rsx_texfmt f, u8* rgba)
+{
+    const u32 bb = f == RSX_TEXFMT_BC1 ? 8u : 16u;
+    for (u32 by = 0; by * 4 < h; by++)
+        for (u32 bx = 0; bx * 4 < w; bx++) {
+            const u8* b = blocks + (size_t)by * row_bytes + (size_t)bx * bb;
+            u8 t[16][4];
+            eng_bc_color(f == RSX_TEXFMT_BC1 ? b : b + 8, t, f == RSX_TEXFMT_BC1);
+            if (f == RSX_TEXFMT_BC2) {
+                for (int i = 0; i < 16; i++) t[i][3] = (u8)(((b[i / 2] >> ((i & 1) * 4)) & 15u) * 17u);
+            } else if (f == RSX_TEXFMT_BC3) {
+                u8 a[8]; a[0] = b[0]; a[1] = b[1];
+                if (a[0] > a[1]) for (int k = 1; k < 7; k++) a[k + 1] = (u8)(((7 - k) * a[0] + k * a[1] + 3) / 7);
+                else { for (int k = 1; k < 5; k++) a[k + 1] = (u8)(((5 - k) * a[0] + k * a[1] + 2) / 5);
+                       a[6] = 0; a[7] = 255; }
+                u64 bits = 0;
+                for (int k = 0; k < 6; k++) bits |= (u64)b[2 + k] << (8 * k);
+                for (int i = 0; i < 16; i++) t[i][3] = a[(bits >> (3 * i)) & 7u];
+            }
+            for (u32 i = 0; i < 16; i++) {
+                const u32 x = bx * 4 + (i & 3), y = by * 4 + (i >> 2);
+                if (x < w && y < h) memcpy(rgba + ((size_t)y * w + x) * 4, t[i], 4);
+            }
+        }
+}
+
+/* PS3_MODS_DUMP: level 0 of the texture with this key, decoded (in
+ * g.tex_staging, laid out as `tl` says), as <dir>/<key>.png -- once a key. */
+static void eng_texmod_dump(u64 key, u32 location, u32 offset, u32 fmt, u32 w, u32 h,
+                            const rsx_tex_layout* tl)
+{
+    if (!s_mods.dump_dir[0] || !key) return;
+    if (s_mods.dumped_n * 2u + 2u > s_mods.dumped_size) {
+        if (s_mods.dumped_size >= (1u << 20)) return;          /* a million: enough */
+        const u32 size = s_mods.dumped_size ? s_mods.dumped_size * 2u : 4096u;
+        u64* nd = (u64*)calloc(size, sizeof *nd);
+        if (!nd) return;
+        for (u32 i = 0; i < s_mods.dumped_size; i++)
+            if (s_mods.dumped[i]) {
+                u32 p = (u32)(s_mods.dumped[i] ^ (s_mods.dumped[i] >> 32)) & (size - 1u);
+                while (nd[p]) p = (p + 1) & (size - 1u);
+                nd[p] = s_mods.dumped[i];
+            }
+        free(s_mods.dumped); s_mods.dumped = nd; s_mods.dumped_size = size;
+    }
+    u32 p = (u32)(key ^ (key >> 32)) & (s_mods.dumped_size - 1u);
+    for (; s_mods.dumped[p]; p = (p + 1) & (s_mods.dumped_size - 1u))
+        if (s_mods.dumped[p] == key) return;
+    s_mods.dumped[p] = key;
+    s_mods.dumped_n++;
+    char path[640];
+    snprintf(path, sizeof path, "%s/%016llx.png", s_mods.dump_dir, (unsigned long long)key);
+    int ok = 0;
+    if (tl->fmt == RSX_TEXFMT_R8G8B8A8) {
+        ok = g.be->image_save(g.be->user, path, g.tex_staging, w, h, tl->dst_row_bytes);
+    } else {
+        u8* rgba = (u8*)calloc((size_t)w * h, 4);
+        if (!rgba) return;
+        eng_bc_decode(g.tex_staging, tl->dst_row_bytes, w, h, tl->fmt, rgba);
+        ok = g.be->image_save(g.be->user, path, rgba, w, h, w * 4u);
+        free(rgba);
+    }
+    if (!ok) return;
+    static const char* const fname[] = { "R8", "R8G8", "RGBA8", "DXT1", "DXT3", "DXT5" };
+    snprintf(path, sizeof path, "%s/textures.txt", s_mods.dump_dir);
+    FILE* ix = fopen(path, "a");
+    if (ix) {
+        fprintf(ix, "%016llx %4ux%-4u %-5s fmt 0x%02X loc %u off 0x%08X frame %u\n", (unsigned long long)key,
+                w, h, (unsigned)tl->fmt < 6u ? fname[tl->fmt] : "?", fmt, location, offset, g.frames);
+        fclose(ix);
+    }
+}
+
+/* RSX_TEX_MIPDUMP=<existing dir>: every level of the first RSX_TEX_MIPDUMP_MAX
+ * (default 48) 2D textures with at least RSX_TEX_MIPDUMP_LEVELS (default 4)
+ * levels, skipping the first RSX_TEX_MIPDUMP_AFTER (default 0) such uploads,
+ * decoded, as <dir>/<loc>_<offset>_f<fmt>_<w>x<h>_L<level>.ppm -- the
+ * question when a distant or grazing surface comes out in the wrong colours
+ * is whether its small levels decode from guest memory as the image or as
+ * something else. Colour formats only; a level in a 16- or 32-bit format is
+ * skipped. */
+static struct { int init; const char* dir; u32 min_levels, max, after, seen, written; } s_mipdump;
+
+static int eng_mipdump_wanted(u32 nlv, int cube)
+{
+    if (!s_mipdump.init) {
+        s_mipdump.init = 1;
+        s_mipdump.dir = getenv("RSX_TEX_MIPDUMP");
+        const char* e = getenv("RSX_TEX_MIPDUMP_LEVELS");
+        s_mipdump.min_levels = e ? (u32)atoi(e) : 4u;
+        e = getenv("RSX_TEX_MIPDUMP_MAX");
+        s_mipdump.max = e ? (u32)atoi(e) : 48u;
+        e = getenv("RSX_TEX_MIPDUMP_AFTER");
+        s_mipdump.after = e ? (u32)atoi(e) : 0u;
+    }
+    if (!s_mipdump.dir || !*s_mipdump.dir || cube || nlv < s_mipdump.min_levels) return 0;
+    if (s_mipdump.written >= s_mipdump.max) return 0;
+    if (s_mipdump.seen++ < s_mipdump.after) return 0;
+    /* RSX_TEX_MIPDUMP_TRIGGER=<file>: only while that file exists, so a driver
+     * script can take the textures a scene streams in rather than the level
+     * load's (RSX_ENGINE_PASS_DUMP_TRIGGER's idea). */
+    {
+        static const char* trig = (const char*)1;
+        if (trig == (const char*)1) trig = getenv("RSX_TEX_MIPDUMP_TRIGGER");
+        if (trig && *trig) {
+            FILE* t = fopen(trig, "rb");
+            if (!t) return 0;
+            fclose(t);
+        }
+    }
+    s_mipdump.written++;
+    return 1;
+}
+
+/* One decoded level (g.tex_staging, laid out as `tl` says) to a PPM. */
+static void eng_mipdump_level(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
+                              u32 level, u32 lw, u32 lh, const rsx_tex_layout* tl)
+{
+    const u8* px = g.tex_staging;
+    u8* rgba = NULL;
+    u32 bpp, stride;
+    if (tl->compressed) {
+        rgba = (u8*)malloc((size_t)lw * lh * 4u);
+        if (!rgba) return;
+        eng_bc_decode(g.tex_staging, tl->dst_row_bytes, lw, lh, tl->fmt, rgba);
+        px = rgba; bpp = 4; stride = lw * 4u;
+    } else if (tl->fmt == RSX_TEXFMT_R8G8B8A8 || tl->fmt == RSX_TEXFMT_R8G8 ||
+               tl->fmt == RSX_TEXFMT_R8) {
+        bpp = tl->dst_bytes_per_texel; stride = tl->dst_row_bytes;
+    } else {
+        return;
+    }
+    char path[1024];
+    snprintf(path, sizeof path, "%s/%u_%08X_f%02X_%ux%u_L%u_%ux%u.ppm", s_mipdump.dir,
+             location, offset, fmt & 0xFFu, w, h, level, lw, lh);
+    FILE* f = fopen(path, "wb");
+    if (f) {
+        fprintf(f, "P6\n%u %u\n255\n", lw, lh);
+        for (u32 y = 0; y < lh; y++)
+            for (u32 x = 0; x < lw; x++) {
+                const u8* p = px + (size_t)y * stride + (size_t)x * bpp;
+                const u8 rgb[3] = { p[0], bpp > 1u ? p[1] : p[0], bpp > 2u ? p[2] : p[0] };
+                fwrite(rgb, 1, 3, f);
+            }
+        fclose(f);
+    }
+    free(rgba);
+}
+
+/* Decode a guest texture out of guest memory and hand every face and level to
+ * the backend. Returns the backend handle, or 0. */
+static u32 eng_texture_upload(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
+                              u32 levels, u32 pitch, int cube, u32 remap, u32 depth)
+{
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    const u32 nlv = rsx_texture_mip_chain(fmt, w, h, levels, pitch, lv);
+    if (!nlv || !lv[0].tl.face_bytes) return 0;
+    /* RSX_TEX_LNMIP_LOG=<n>: the first n linear textures with mip levels and a
+     * pitch -- the ones PS3RECOMP_TEX_LN_PITCH lays out differently (every
+     * level below 0 at least). */
+    {
+        static int left = -1;
+        if (left < 0) { const char* e = getenv("RSX_TEX_LNMIP_LOG"); left = e ? atoi(e) : 0; }
+        const u32 row = lv[0].tl.compressed ? lv[0].tl.dst_row_bytes : w * lv[0].tl.bytes_per_texel;
+        if (left > 0 && nlv > 1 && (fmt & 0x20u) && pitch) {
+            left--;
+            fprintf(stderr, "[rsx texture] linear %ux%u fmt 0x%02X levels %u pitch %u (row %u) at %u:0x%08X\n",
+                    w, h, fmt, nlv, pitch, row, location, offset);
+        }
+    }
+    /* A volume: every slice of every level decoded and uploaded on its own.
+     * inFAMOUS 2's occlusion volumes read an 8x8x8 cone LUT; uploaded as its
+     * first slice and sampled in 2D it darkened whole boxes round every prop. */
+    if (depth > 1 && !cube && g.be->texture_create_3d && g.be->texture_upload_3d &&
+        !lv[0].tl.compressed && lv[0].tl.bytes_per_texel) {
+        const u32 span = eng_texture_span_3d(fmt, w, h, depth, levels, pitch);
+        const u8* src = eng_guest_ptr(NULL, location, offset, span);
+        if (!src) return 0;
+        const u32 handle = g.be->texture_create_3d(g.be->user, eng_texfmt(lv[0].tl.fmt),
+                                                   w, h, depth, nlv, remap, fmt);
+        if (!handle) return 0;
+        const u8* level_src = src;
+        u32 d = depth;
+        for (u32 m = 0; m < nlv; m++) {
+            const rsx_tex_layout* tl = &lv[m].tl;
+            const u32 lin_bytes = tl->swizzled ? tl->row_bytes * tl->rows : 0u;
+            if (!eng_staging_reserve(tl->dst_row_bytes * tl->rows + lin_bytes)) {
+                g.be->texture_release(g.be->user, handle);
+                return 0;
+            }
+            for (u32 z = 0; z < d; z++) {
+                if (tl->swizzled) {
+                    u8* lin = g.tex_staging + tl->dst_row_bytes * tl->rows;
+                    eng_deswizzle_3d_slice(lin, level_src, lv[m].w, lv[m].h, d, z, tl->bytes_per_texel);
+                    rsx_tex_layout ltl = *tl; ltl.swizzled = 0;
+                    rsx_texture_decode(g.tex_staging, tl->dst_row_bytes, lin, lv[m].w, lv[m].h,
+                                       &ltl, rsx_texture_argb_is_rgba());
+                } else {
+                    rsx_texture_decode(g.tex_staging, tl->dst_row_bytes,
+                                       level_src + (size_t)z * tl->face_bytes, lv[m].w, lv[m].h,
+                                       tl, rsx_texture_argb_is_rgba());
+                }
+                g.be->texture_upload_3d(g.be->user, handle, z, m, lv[m].w, lv[m].h,
+                                        g.tex_staging, tl->dst_row_bytes);
+            }
+            level_src += (size_t)tl->face_bytes * d;
+            if (d > 1) d >>= 1;
+        }
+        return handle;
+    }
+    const u32 faces = cube ? 6u : 1u;
+    const u32 face_stride = cube
+        ? rsx_texture_cube_face_stride(fmt, w, h, levels, pitch) : 0u;
+    const u32 span = eng_texture_span(fmt, w, h, levels, pitch, cube);
+    const u8* src = eng_guest_ptr(NULL, location, offset, span);
+    if (!src) return 0;
+
+    /* Texture packs and their dump (PS3_MODS, PS3_MODS_DUMP), by content. */
+    u64 mod_key = 0;
+    if (!cube && eng_mods_wanted()) {
+        const rsx_texfmt tf = lv[0].tl.fmt;
+        if (tf == RSX_TEXFMT_R8G8B8A8 || tf == RSX_TEXFMT_BC1 || tf == RSX_TEXFMT_BC2 || tf == RSX_TEXFMT_BC3) {
+            int readable = 0;
+            const u64 content = eng_texture_content_hash(location, offset, span, &readable);
+            if (readable) mod_key = eng_texmod_key(content, fmt, w, h);
+        }
+        if (mod_key && s_mods.on) {
+            const u32 hnd = eng_texmod_apply(mod_key, fmt, w, h, nlv, remap);
+            if (hnd) {
+                if (s_mods.dump_dir[0] && eng_staging_reserve(lv[0].tl.dst_row_bytes * lv[0].tl.rows)) {
+                    rsx_texture_decode(g.tex_staging, lv[0].tl.dst_row_bytes, src + lv[0].offset,
+                                       lv[0].w, lv[0].h, &lv[0].tl, rsx_texture_argb_is_rgba());
+                    eng_texmod_dump(mod_key, location, offset, fmt, w, h, &lv[0].tl);
+                }
+                return hnd;
+            }
+        }
+    }
+
+    const u32 handle = g.be->texture_create(g.be->user, eng_texfmt(lv[0].tl.fmt),
+                                            w, h, nlv, faces, remap, fmt);
+    if (!handle) return 0;
+
+    const int mipdump = eng_mipdump_wanted(nlv, cube);
+    for (u32 f = 0; f < faces; f++) {
+        const u8* face = src + (size_t)f * face_stride;
+        for (u32 m = 0; m < nlv; m++) {
+            const rsx_tex_layout* tl = &lv[m].tl;
+            if (!eng_staging_reserve(tl->dst_row_bytes * tl->rows)) {
+                g.be->texture_release(g.be->user, handle);
+                return 0;
+            }
+            rsx_texture_decode(g.tex_staging, tl->dst_row_bytes,
+                               face + lv[m].offset, lv[m].w, lv[m].h, tl,
+                               rsx_texture_argb_is_rgba());
+            if (mod_key && f == 0 && m == 0) eng_texmod_dump(mod_key, location, offset, fmt, w, h, tl);
+            if (mipdump && f == 0) eng_mipdump_level(location, offset, fmt, w, h, m, lv[m].w, lv[m].h, tl);
+            g.be->texture_upload(g.be->user, handle, f, m, lv[m].w, lv[m].h,
+                                 g.tex_staging, tl->dst_row_bytes, tl->rows);
+        }
+    }
+    return handle;
+}
+
+/* The cache slot for a texture unit's bytes, keyed on where they are and what
+ * the registers say they are. An already-cached entry is re-hashed at most
+ * once per presented frame and re-decoded when the guest changed it, which is
+ * what makes an animated UI or a video texture update at all. A miss with the
+ * cache full evicts the least recently used entry rather than returning
+ * nothing: returning white "made the recovered orphanage render as flat
+ * green/black geometry" (rsx_live_draw.c:2326-2334). */
+/* Texture cache traffic, printed with the vertex cache stats
+ * (PS3RECOMP_ENG_VCACHE_STATS): entries created, of which evicted another,
+ * and re-uploads because the guest bytes changed. */
+static u64 s_tex_new, s_tex_evicted, s_tex_changed, s_tex_new_bytes, s_tex_changed_bytes;
+static int s_vc_stats_on;   /* defined with the vertex cache below */
+
+/* The chain a texture key belongs to in g.tex_bucket. The level count is
+ * not hashed: it is identity only under PS3RECOMP_ENG_TEXKEY_LEVELS, and the
+ * key comparison decides either way. */
+static u32 eng_texture_key_bucket(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
+                                  u32 pitch, u32 remap, u32 cube, u32 depth)
+{
+    u32 k = offset * 0x9E3779B1u;
+    k ^= (fmt * 0x85EBCA6Bu) ^ (w << 16 | (h & 0xFFFFu)) ^ pitch * 0xC2B2AE35u ^
+         remap * 0x27D4EB2Fu ^ location << 30 ^ cube << 29 ^ depth << 20;
+    k ^= k >> 15; k *= 0x2C1B3C6Du; k ^= k >> 13;
+    return k & (ENG_TEX_BUCKETS - 1u);
+}
+static u32 eng_texture_entry_bucket(const eng_texture* e)
+{
+    return eng_texture_key_bucket(e->location, e->offset, e->format, e->width, e->height,
+                                  e->pitch, e->remap, e->cubemap, e->depth);
+}
+/* g.textures[index] is about to be replaced: take it out of its chain. */
+static void eng_texture_index_remove(u32 index)
+{
+    u16* link = &g.tex_bucket[eng_texture_entry_bucket(&g.textures[index])];
+    while (*link && *link != (u16)(index + 1u)) link = &g.tex_next[*link - 1u];
+    if (*link) *link = g.tex_next[index];
+    g.tex_next[index] = 0;
+}
+/* g.textures[index] was just written: put it at the head of its chain. */
+static void eng_texture_index_insert(u32 index)
+{
+    u16* head = &g.tex_bucket[eng_texture_entry_bucket(&g.textures[index])];
+    g.tex_next[index] = *head;
+    *head = (u16)(index + 1u);
+}
+
+static u32 eng_texture_slot(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
+                            u32 levels, u32 pitch, int cube, u32 remap, u32 depth)
+{
+    if (!w || !h || w > ENG_MAX_TEX_DIM || h > ENG_MAX_TEX_DIM) return 0;
+    if (!depth) depth = 1;
+    /* The span walks the whole mip chain (rsx_texture_mip_chain) on every
+     * bind of every unit, a few thousand times a frame for the same few
+     * hundred textures: that walk was most of this function's own time (7%
+     * of the RSX thread). It is a pure function of these arguments, so the
+     * last answer per key is kept; PS3RECOMP_ENG_TEXSPAN_MEMO=0 turns the
+     * memo off. */
+    static struct { u32 fmt, w, h, levels, pitch, depth, cube, span; } s_span_memo[512];
+    static int s_span_memo_on = -1;
+    if (s_span_memo_on < 0) { const char* v = getenv("PS3RECOMP_ENG_TEXSPAN_MEMO"); s_span_memo_on = v ? atoi(v) != 0 : 1; }
+    u32 span = 0;
+    const u32 si = (fmt * 0x9E37u ^ w * 31u ^ h * 131u ^ levels * 7u ^ (pitch >> 4) ^ depth << 3 ^ (u32)(cube != 0)) & 511u;
+    if (s_span_memo_on && s_span_memo[si].span && s_span_memo[si].fmt == fmt && s_span_memo[si].w == w &&
+        s_span_memo[si].h == h && s_span_memo[si].levels == levels && s_span_memo[si].pitch == pitch &&
+        s_span_memo[si].depth == depth && s_span_memo[si].cube == (u32)(cube != 0)) {
+        span = s_span_memo[si].span;
+    } else {
+        span = depth > 1 ? eng_texture_span_3d(fmt, w, h, depth, levels, pitch)
+                         : eng_texture_span(fmt, w, h, levels, pitch, cube);
+        if (span && s_span_memo_on) {
+            s_span_memo[si].fmt = fmt; s_span_memo[si].w = w; s_span_memo[si].h = h;
+            s_span_memo[si].levels = levels; s_span_memo[si].pitch = pitch;
+            s_span_memo[si].depth = depth; s_span_memo[si].cube = (u32)(cube != 0);
+            s_span_memo[si].span = span;
+        }
+    }
+    if (!span) return 0;
+
+    /* A scene binds the same few hundred textures every frame, and a linear
+     * scan of the whole cache per bind averaged several hundred entries.
+     * Remember where each key was last found; a remembered slot is used only
+     * if its entry still matches, otherwise the scan runs as before. Keys are
+     * unique in the cache, so the result is the same either way. */
+    static u16 s_slot_memo[32768];   /* 8x the texture cache (4096 entries) */
+    const u32 memo = (offset >> 4 ^ offset >> 16 ^ fmt * 0x9E37u ^ w * 31u ^ h ^
+                      location << 11 ^ offset >> 24 << 12) & 32767u;
+    /* PS3RECOMP_ENG_TEXKEY_LEVELS=1: the level count is part of the key too.
+     * The same bytes bound with one level and then with the whole chain are
+     * then two uploads; without it the second binding samples the one-level
+     * image and never minifies. Off until an A/B shows a title needs it. */
+    static int key_levels = -1;
+    if (key_levels < 0) { const char* e = getenv("PS3RECOMP_ENG_TEXKEY_LEVELS"); key_levels = e ? atoi(e) : 0; }
+#define ENG_TEXTURE_KEY_MATCHES(e) ((e)->location == location && (e)->offset == offset && \
+        (e)->format == fmt && (e)->width == w && (e)->height == h && \

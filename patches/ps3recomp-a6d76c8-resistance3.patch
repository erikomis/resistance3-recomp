+/* PS3_AUDIO_LIMITER=1: a peak limiter before the final clip. A movie's 5.1 bed
+ * folds to stereo at up to 2.4x full scale and the clip below was flattening
+ * those peaks. It acts only where a block would pass the ceiling, so normal
+ * levels are untouched and the mix is not attenuated as a whole. The block is
+ * held back one block (5.3 ms) so the gain is already down when a peak arrives,
+ * and it moves in a straight line across a block, so there is no click. */
+static void audio_limit_block(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3_AUDIO_LIMITER"); on = e && e[0] != '0'; }
+    float peak = 0.0f;
+    for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) {
+        const float a = fabsf(s_mix_buffer[i]);
+        if (a > peak) peak = a;
+    }
+    if (peak > s_lim_peak) s_lim_peak = peak;
+    if (!on) return;
+
+    static float held[CELL_AUDIO_BLOCK_SAMPLES * 2];
+    static float gain = 1.0f, held_limit = 1.0f;
+    const float ceiling = 0.98f;
+    const float limit = peak > ceiling ? ceiling / peak : 1.0f;
+    float next = gain + (1.0f - gain) * 0.02f;                /* recovers over ~250 ms */
+    if (next > limit) next = limit;
+    if (next > held_limit) next = held_limit;
+    for (u32 s = 0; s < CELL_AUDIO_BLOCK_SAMPLES; s++) {
+        const float g = gain + (next - gain) * (float)(s + 1) / (float)CELL_AUDIO_BLOCK_SAMPLES;
+        const float l = s_mix_buffer[s * 2], r = s_mix_buffer[s * 2 + 1];
+        s_mix_buffer[s * 2]     = held[s * 2] * g;
+        s_mix_buffer[s * 2 + 1] = held[s * 2 + 1] * g;
+        held[s * 2] = l; held[s * 2 + 1] = r;
+    }
+    gain = next;
+    held_limit = limit;
+    if (gain < s_lim_min_gain) s_lim_min_gain = gain;
+}

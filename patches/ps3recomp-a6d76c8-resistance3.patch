+            rsx_draw_engine_guest_wrote(location, s->offset + r0 * s->pitch, s->pitch,
+                                        s->w, r1 - r0);
+    }
+    for (u32 i = 0; i < g.n_zdepths; i++) {
+        const eng_zdepth* z = &g.zdepths[i];
+        if (!z->handle || z->location != location || !z->depth_serial ||
+            !eng_ranges_overlap(offset, bytes, z->offset, eng_zdepth_guest_bytes(z)))
+            continue;
+        if (eng_texlog())
+            fprintf(stderr, "[rsx engine] copy engine writes %u:0x%08X+0x%X: zeta 0x%08X %ux%u"
+                            " pitch %u (host depth not updated)\n", location, offset, bytes,
+                    z->offset, z->used_w, z->used_h, z->pitch);

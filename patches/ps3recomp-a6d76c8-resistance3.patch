+    (void)tid; (void)ea; (void)lane; return 0;
+}
+uint32_t spurs_vspu_tid_for(uint32_t ea, uint32_t lane) {
+    (void)ea; (void)lane; return 0;
+}
+int spurs_vspu_snr(uint32_t ea, uint32_t lane, uint32_t n, uint32_t* v) {
+    (void)ea; (void)lane; (void)n; (void)v; return 0;
+}
+extern void spu_indirect_branch_mt(spu_context*);
+extern void spu_begin_image(int);
+extern void spu_register_function(uint32_t, void (*)(spu_context*));
+extern void spu_overlay_register_region_reloc(uint32_t, uint32_t, int);
+extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
+static int called;
+static void stale(spu_context* c) { (void)c; called = 1; }
+static void resident(spu_context* c) { (void)c; called = 2; }
+
+int main(void) {
+    static spu_context c;
+    static uint8_t pm[0x200];
+    spu_context_init(&c, 0);
+    c.pc = 0xB00; c.image_id = 77; c.policy_mode = 1;
+    spu_begin_image(77); spu_register_function(0xB00, stale);
+    spu_begin_image(78); spu_register_function(0xB00, resident);
+    c.resident_code[0].lsa = 0x100;
+    c.resident_code[0].size = 0x7000;
+    c.resident_code[0].image_id = 78;
+    spu_indirect_branch_mt(&c);
+    assert(called == 2); /* job, never the overwritten PM */
+
+    /* When streamed bytes have no lift, the stale PM must not execute. */
+    c.resident_code[0].image_id = 0;
+    c.pm_image = pm; c.pm_image_size = sizeof pm;
+    pm[0x100] = 0x40; /* deliberately differs from the stop in live LS */
+    c.ls[0xB02] = 1; c.ls[0xB03] = 0x23; /* stop 0x123 */
+    c.pc = 0xB00; c.status = SPU_STATUS_RUNNING; called = 0;
+    assert(spu_run_with_halt(spu_indirect_branch_mt, &c));
+    assert(called == 0 && c.stop_code == 0x123);
+
+    /* Relative registry addresses must resolve with the current load base. */
+    spu_begin_image(300); spu_register_function(0x30, resident);
+    spu_overlay_register_region_reloc(0x100000, 0x100, 300);
+    c.resident_code[0].lsa = 0x8000;
+    c.resident_code[0].size = 0x100;
+    c.resident_code[0].image_id = 300;
+    c.resident_code[0].reloc = 1;
+    c.pc = 0x8030; c.reloc_floor = 0x8000; called = 0;
+    spu_indirect_branch_mt(&c);
+    assert(called == 2 && c.code_base == 0x8000);
+    c.resident_code[0].image_id = 0;
+    c.pm_image = NULL; c.reloc_floor = 0;
+    c.pc = 0xB00; c.resident_ovl = 0; called = 0;
+    spu_indirect_branch_mt(&c); assert(called == 1);
+    c.resident_ovl = 78; called = 0;
+    spu_indirect_branch_mt(&c); assert(called == 2);
+    puts("SPU musttail dispatch residency: PASS");
+}
+
+/* Link-only boundaries outside this CPU-only fixture. Fail if any is reached. */
+/* spu_workload.c can retain the LV2 runner's publication calls at link time;
+ * this fixture runs its own context directly, without an LV2 SPU thread. */

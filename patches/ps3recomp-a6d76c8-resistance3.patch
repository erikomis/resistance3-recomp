+/* The same patch with the scale read from the PSConstants block instead of
+ * baked as literals: `* fp_unnorm[u].xy` (volumes `.xyz`), and the block
+ * gains `float4 fp_unnorm[16]` after fp_alpha. The engine fills a unit's
+ * entry with (1/w, 1/h, 1/depth) at every draw, so a program that samples a
+ * render target of a changing size (Resistance 2's water and post-process
+ * chain in the SRPA 3 corridors: 320x176, 288x160, 160x88, 128x64 ...) stays
+ * ONE HLSL text, one Metal function and one pipeline per state instead of
+ * one per size -- the user's bay-area session built 37k pipelines and 4.3k
+ * functions in 13 minutes, with 250k draws skipped while they compiled.
+ * Returns the number of call sites patched, -1 when the text does not fit or
+ * has no PSConstants block to extend. */
+int rsx_fp_apply_unnorm_uniform(char* hlsl, u32 hlsl_size, u32 unnorm_mask,

+                            " -> %s 0x%08X %ux%u p%u serial %llu (now %llu) dirty %d, delta %lld\n",
+                    g.frames, unit, t->location, t->offset, t->format & 0xFFu, t->width, t->height,
+                    t->mipmaps, t->pitch, span, pass ? "zeta" : "surface", off, w, h, pitch,
+                    (unsigned long long)serial, (unsigned long long)g.write_serial, dirty,
+                    (long long)t0 - (long long)s0);
+        }
+    }
+}

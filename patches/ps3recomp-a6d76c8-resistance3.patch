diff --git a/runtime/ppu/ppu_lwcond_events.h b/runtime/ppu/ppu_lwcond_events.h
new file mode 100644
index 0000000..fd9b2ae
--- /dev/null
+++ b/runtime/ppu/ppu_lwcond_events.h
@@ -0,0 +1,121 @@
+/* Context-HLE lwcond notification, paired with ppu_sysprx's semaphore mutex.
+ * Included after ppu_context, vm_read/write32, LWM_OWNER/RECUR and lwm_sem.
+ * Registration and releasing the guest mutex share one host lock, so a
+ * signal between release and sleep cannot be lost. Notifications are not
+ * saved for future waiters. Each waiter has its own CV for signal_to. */
+#ifndef PS3RECOMP_PPU_LWCOND_EVENTS_H
+#define PS3RECOMP_PPU_LWCOND_EVENTS_H
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+
+namespace ppu_lwc {
+struct Waiter {
+    uint64_t tid;
+    bool signaled = false;
+    std::condition_variable cv;
+    explicit Waiter(uint64_t id) : tid(id) {}
+};
+struct Queue { std::list<Waiter*> waiters; };
+static std::mutex lock;
+static std::unordered_map<uint32_t, std::shared_ptr<Queue>> queues;
+
+static bool enabled()
+{
+    static const bool on = [] {
+        const char* e = std::getenv("PS3_LWCOND_EVENTS");
+        return e && *e && *e != '0';
+    }();
+    return on;
+}
+static void result(ppu_context* ctx, uint32_t value)
+{
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)value;
+}
+/* lock must be held. The guest queue ID distinguishes reused addresses. */
+static std::shared_ptr<Queue> queue(uint32_t address)
+{
+    if (!address) return {};
+    uint32_t id = vm_read32(address + 4);
+    if (!id) return {};
+    auto& q = queues[id];
+    if (!q) q = std::make_shared<Queue>();
+    return q;
+}
+static void signal(ppu_context* ctx, bool all, bool targeted)
+{
+    std::lock_guard<std::mutex> guard(lock);
+    auto q = queue((uint32_t)ctx->gpr[3]);
+    if (!q) { result(ctx, 0x80010005u); return; } // ESRCH
+    bool found = false;
+    const uint64_t tid = ctx->gpr[4];
+    for (auto it = q->waiters.begin(); it != q->waiters.end();) {
+        Waiter* w = *it;
+        if (targeted && tid != 0xFFFFFFFFu && w->tid != tid) { ++it; continue; }
+        it = q->waiters.erase(it);
+        w->signaled = true;
+        w->cv.notify_one();
+        found = true;
+        if (!all) break;
+    }
+    result(ctx, targeted && !found ? 0x80010002u : 0); // EINVAL: no such waiter
+}
+static void destroy(ppu_context* ctx)
+{
+    const uint32_t address = (uint32_t)ctx->gpr[3];
+    std::lock_guard<std::mutex> guard(lock);
+    const uint32_t id = address ? vm_read32(address + 4) : 0;
+    auto it = queues.find(id);
+    if (!id) { result(ctx, 0x80010005u); return; }
+    if (it != queues.end() && !it->second->waiters.empty()) {
+        result(ctx, 0x8001000Au); return; // EBUSY
+    }
+    if (it != queues.end()) queues.erase(it);
+    vm_write32(address + 4, 0);
+    result(ctx, 0);
+}
+static void wait(ppu_context* ctx)
+{
+    const uint32_t address = (uint32_t)ctx->gpr[3];
+    const uint64_t timeout = ctx->gpr[4]; // microseconds; zero is infinite
+    const uint32_t mutex = address ? vm_read32(address) : 0;
+    HANDLE sem = lwm_sem(mutex);
+    if (!sem) { result(ctx, 0x80010002u); return; }
+    const uint32_t owner = vm_read32(mutex + LWM_OWNER);
+    const uint32_t recursion = vm_read32(mutex + LWM_RECUR);
+    const uint32_t self = ctx->thread_id ? (uint32_t)ctx->thread_id : 0x7FFFFFFEu;
+    if (owner != self) { result(ctx, 0x80010009u); return; } // EPERM
+    Waiter waiter(ctx->thread_id);
+    std::unique_lock<std::mutex> guard(lock);
+    auto q = queue(address);
+    if (!q) { result(ctx, 0x80010005u); return; }
+    q->waiters.push_back(&waiter);
+    vm_write32(mutex + LWM_RECUR, 0);
+    vm_write32(mutex + LWM_OWNER, 0);
+    ReleaseSemaphore(sem, 1, nullptr);
+    if (!timeout) {
+        waiter.cv.wait(guard, [&] { return waiter.signaled; });
+    } else {
+        // Saturate the deadline instead of overflowing on huge guest timeouts.
+        const auto now = std::chrono::steady_clock::now();
+        const auto available = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::time_point::max() - now).count();
+        const auto deadline = timeout >= (uint64_t)available
+            ? std::chrono::steady_clock::time_point::max()
+            : now + std::chrono::microseconds(timeout);
+        waiter.cv.wait_until(guard, deadline, [&] { return waiter.signaled; });
+    }
+    if (!waiter.signaled) q->waiters.remove(&waiter);
+    guard.unlock();
+    // A condition wait always returns holding its paired mutex, even on timeout.
+    WaitForSingleObject(sem, INFINITE);
+    vm_write32(mutex + LWM_OWNER, owner);
+    vm_write32(mutex + LWM_RECUR, recursion);
+    result(ctx, waiter.signaled ? 0 : 0x8001000Bu); // ETIMEDOUT
+}
+} // namespace ppu_lwc
+#endif
diff --git a/runtime/ppu/ppu_sjlj.c b/runtime/ppu/ppu_sjlj.c
new file mode 100644
index 0000000..5a363f3
--- /dev/null
+++ b/runtime/ppu/ppu_sjlj.c
@@ -0,0 +1,250 @@
+/*
+ * ps3recomp - a title's own setjmp/longjmp, carried out on the host stack.
+ * See ppu_sjlj.h for the scheme; this file keeps the host side of it.
+ *
+ * Per host thread there is a small table of slots, one per guest setjmp whose
+ * caller is still running: the guest jmp_buf address it was made with, the
+ * host jmp_buf the rewritten call site setjmp'd into, the host frame of that
+ * caller, and the guest state a longjmp to it must arrive with (the guest
+ * context, r1, the return address). The lifted caller frees its slots on each
+ * exit (ppu_sjlj_leave); a longjmp frees those of the frames it skips. Host
+ * stacks grow down, so a slot whose frame is below the frame now running
+ * belongs to a call that is gone: each new setjmp drops those as well.
+ *
+ * A host longjmp skips every frame between the longjmp and the setjmp site.
+ * Lifted functions own nothing that needs a destructor, but the runtime's
+ * indirect-call dispatcher counts its nesting per thread (the recursion guard
+ * and the vcall stack), and a frame of it that is skipped never takes its
+ * count back down; those counts are restored to their value at the setjmp.
+ * g_trampoline_fn is cleared (a skipped drain loop could have left it set)
+ * and g_active_ctx is put back to what it was at the setjmp.
+ *
+ * A longjmp is only carried out when the slot for its jmp_buf was made on the
+ * same guest context (an HLE -> guest callback runs on a context of its own,
+ * and jumping out of it would skip the HLE code that called it) at the same
+ * HLE call nesting (an HLE handler that runs guest code on the caller's
+ * context has guards a jump would skip), its host frame is above the current
+ * one, and the guest r1/LR the longjmp body just restored are the ones the
+ * setjmp was made with. Anything else returns to the lifted longjmp, as
+ * before this support existed, after a log line.
+ *
+ * Environment:
+ *   PPU_SJLJ=0      never jump (every longjmp returns, as without --sjlj)
+ *   PPU_SJLJ_LOG=1  log every setjmp-site jump (first 64, then every 4096th)
+ */
+#include "ppu_sjlj.h"
+#include "ppu_tls.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* The runtime's own ppu_context: same layout as the one the lifter's
+ * HEADER_PREAMBLE writes into ppu_recomp.h, which this file does not need. */
+#include "ppu_context.h"
+
+extern PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+extern PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
+int* ps3_ppu_dispatch_depth_slot(void);
+int* ps3_ppu_vcall_sp_slot(void);
+int* ps3_hle_depth_slot(void);
+
+#define SJLJ_SLOTS 128
+
+typedef struct sjlj_slot {
+    jmp_buf      jb;
+    uintptr_t    frame;    /* host frame of the function that made the setjmp */
+    ppu_context* ctx;      /* guest context it was made on                     */
+    ppu_context* active;   /* g_active_ctx then                                */
+    uint32_t     buf;      /* guest jmp_buf (r3 at the call)                   */
+    uint32_t     r1;       /* guest r1 at the call                             */
+    uint32_t     ret;      /* guest return address of the call                 */
+    int          depth;    /* indirect-call nesting then                       */
+    int          vsp;      /* vcall stack pointer then                         */
+    int          hle;      /* HLE call nesting then                            */
+    int          used;
+} sjlj_slot;
+
+typedef struct sjlj_thread {
+    sjlj_slot slot[SJLJ_SLOTS];
+    int       top;         /* slots [0, top) may be in use */
+    int       live;
+    jmp_buf   scratch;     /* handed out when no slot is free; never jumped to */
+} sjlj_thread;
+
+static PPU_THREAD_LOCAL sjlj_thread* t_sjlj;
+
+static volatile uint64_t s_enters, s_jumps, s_fallbacks;
+
+static int sjlj_env(const char* name, int dflt)
+{
+    const char* e = getenv(name);
+    return e && *e ? atoi(e) : dflt;
+}
+
+static int sjlj_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) on = sjlj_env("PPU_SJLJ", 1) != 0;
+    return on;
+}
+
+static int sjlj_log_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = sjlj_env("PPU_SJLJ_LOG", 0) != 0;
+    return on;
+}
+
+static sjlj_thread* sjlj_self(void)
+{
+    if (!t_sjlj) t_sjlj = (sjlj_thread*)calloc(1, sizeof(sjlj_thread));
+    return t_sjlj;
+}
+
+static void sjlj_free(sjlj_thread* t, sjlj_slot* s)
+{
+    s->used = 0;
+    t->live--;
+}
+
+static void sjlj_trim(sjlj_thread* t)
+{
+    while (t->top > 0 && !t->slot[t->top - 1].used) t->top--;
+}
+
+/* Drop the slots of frames below `frame` (they have returned, or are being
+ * unwound). */
+static void sjlj_drop_below(sjlj_thread* t, uintptr_t frame)
+{
+    for (int i = 0; i < t->top; i++) {
+        sjlj_slot* s = &t->slot[i];
+        if (s->used && s->frame < frame) sjlj_free(t, s);
+    }
+    sjlj_trim(t);
+}
+
+jmp_buf* ppu_sjlj_enter(struct ppu_context* ctx, uint32_t ret_addr, void* host_frame)
+{
+    sjlj_thread* t = sjlj_self();
+    static jmp_buf s_oom_scratch;   /* calloc failed: shared, never jumped to */
+    if (!t) return &s_oom_scratch;
+    __atomic_fetch_add(&s_enters, 1, __ATOMIC_RELAXED);
+    if (!sjlj_enabled()) return &t->scratch;
+
+    const uintptr_t frame = (uintptr_t)host_frame;
+    const uint32_t buf = (uint32_t)ctx->gpr[3];
+    sjlj_slot* hit = NULL;
+    sjlj_slot* free_slot = NULL;
+    for (int i = 0; i < t->top; i++) {
+        sjlj_slot* s = &t->slot[i];
+        if (s->used && s->frame < frame) sjlj_free(t, s);  /* returned */
+        if (!s->used) { if (!free_slot) free_slot = s; continue; }
+        if (s->buf == buf) hit = s;   /* the guest reuses this jmp_buf */
+    }
+    sjlj_slot* s = hit ? hit : free_slot;
+    if (!s && t->top < SJLJ_SLOTS) s = &t->slot[t->top++];
+    if (!s) {
+        static int n = 0;
+        if (n < 8) {
+            n++;
+            fprintf(stderr, "[sjlj] %d setjmp frames live on this thread; the setjmp "
+                            "returning to 0x%08X (jmp_buf 0x%08X) gets no host context\n",
+                    SJLJ_SLOTS, ret_addr, buf);
+        }
+        return &t->scratch;
+    }
+    if (!s->used) {
+        s->used = 1;
+        t->live++;
+    }
+    s->frame  = frame;
+    s->ctx    = ctx;
+    s->active = g_active_ctx;
+    s->buf    = buf;
+    s->r1     = (uint32_t)ctx->gpr[1];
+    s->ret    = ret_addr;
+    s->depth  = *ps3_ppu_dispatch_depth_slot();
+    s->vsp    = *ps3_ppu_vcall_sp_slot();
+    s->hle    = *ps3_hle_depth_slot();
+    return &s->jb;
+}
+
+void ppu_sjlj_leave(void* host_frame)
+{
+    sjlj_thread* t = t_sjlj;
+    if (!t || !t->live) return;
+    const uintptr_t frame = (uintptr_t)host_frame;
+    for (int i = 0; i < t->top; i++) {
+        sjlj_slot* s = &t->slot[i];
+        if (s->used && s->frame <= frame) sjlj_free(t, s);
+    }
+    sjlj_trim(t);
+}
+
+static void sjlj_fallback(struct ppu_context* ctx, uint32_t buf, const char* why)
+{
+    uint64_t n = __atomic_add_fetch(&s_fallbacks, 1, __ATOMIC_RELAXED);
+    if (n <= 16 || (n & 1023) == 0)
+        fprintf(stderr, "[sjlj] longjmp(jmp_buf 0x%08X) not carried out: %s "
+                        "(r1=0x%08X lr=0x%08X tid=%llu, #%llu); the longjmp returns\n",
+                buf, why, (uint32_t)ctx->gpr[1], (uint32_t)ctx->lr,
+                (unsigned long long)ctx->thread_id, (unsigned long long)n);
+}
+
+void ppu_sjlj_longjmp(struct ppu_context* ctx, uint64_t buf64)
+{
+    const uint32_t buf = (uint32_t)buf64;
+    sjlj_thread* t = t_sjlj;
+    if (!sjlj_enabled()) { sjlj_fallback(ctx, buf, "PPU_SJLJ=0"); return; }
+    sjlj_slot* s = NULL;
+    if (t)
+        for (int i = 0; i < t->top; i++)
+            if (t->slot[i].used && t->slot[i].buf == buf) { s = &t->slot[i]; break; }
+    if (!s) { sjlj_fallback(ctx, buf, "no setjmp made with it on this thread"); return; }
+    if (s->ctx != ctx) {
+        sjlj_fallback(ctx, buf, "its setjmp was made on another guest context "
+                                "(jumping out of an HLE callback)");
+        return;
+    }
+    if (*ps3_hle_depth_slot() != s->hle) {
+        sjlj_fallback(ctx, buf, "it would jump over an HLE call that runs guest code");
+        return;
+    }
+    if ((uintptr_t)PPU_SJLJ_FRAME() >= s->frame) {
+        sjlj_free(t, s);
+        sjlj_trim(t);
+        sjlj_fallback(ctx, buf, "the function that made the setjmp has returned");
+        return;
+    }
+    if ((uint32_t)ctx->gpr[1] != s->r1 || (uint32_t)ctx->lr != s->ret) {
+        char why[160];
+        snprintf(why, sizeof why, "the jmp_buf holds r1=0x%08X lr=0x%08X, its setjmp "
+                                  "was made with r1=0x%08X returning to 0x%08X",
+                 (uint32_t)ctx->gpr[1], (uint32_t)ctx->lr, s->r1, s->ret);
+        sjlj_fallback(ctx, buf, why);
+        return;
+    }
+    sjlj_drop_below(t, s->frame);
+
+    *ps3_ppu_dispatch_depth_slot() = s->depth;
+    *ps3_ppu_vcall_sp_slot() = s->vsp;
+    g_trampoline_fn = 0;
+    g_active_ctx = s->active;
+
+    uint64_t n = __atomic_add_fetch(&s_jumps, 1, __ATOMIC_RELAXED);
+    if (sjlj_log_on() && (n <= 64 || (n & 4095) == 0))
+        fprintf(stderr, "[sjlj] longjmp #%llu: jmp_buf 0x%08X -> setjmp returning to "
+                        "0x%08X, value %lld (r1=0x%08X tid=%llu)\n",
+                (unsigned long long)n, buf, s->ret, (long long)ctx->gpr[3], s->r1,
+                (unsigned long long)ctx->thread_id);
+    PPU_SJLJ_HOST_LONGJMP(s->jb, 1);
+}
+
+void ppu_sjlj_get_stats(ppu_sjlj_stats* out)
+{
+    out->enters = s_enters;
+    out->jumps = s_jumps;
+    out->fallbacks = s_fallbacks;
+    out->live = t_sjlj ? (uint32_t)t_sjlj->live : 0;
+}
diff --git a/runtime/ppu/ppu_sjlj.h b/runtime/ppu/ppu_sjlj.h
new file mode 100644
index 0000000..5372d6d
--- /dev/null
+++ b/runtime/ppu/ppu_sjlj.h
@@ -0,0 +1,101 @@
+/*
+ * ps3recomp - a title's own setjmp/longjmp, carried out on the host stack
+ *
+ * A title that links a libc setjmp/longjmp (newlib's, in a PS3 SDK title)
+ * cannot use it as lifted code: the guest longjmp restores r1, r2, the
+ * non-volatile GPRs/FPRs/VRs, CR and LR from the jmp_buf and "returns" from
+ * the setjmp call a second time -- but a static recompilation runs every guest
+ * function as a host function, so restoring the guest registers unwinds no
+ * host frame. The lifted longjmp just returns to its caller, which carries on
+ * as if the jump had happened. Lua's error handling is the common victim:
+ * luaD_throw longjmps to the luaD_rawrunprotected that pcall made, and when
+ * the longjmp returns it falls into the "no handler" path (panic, exit(1)).
+ *
+ * The lifter's --sjlj option names the title's setjmp and longjmp functions.
+ * Each direct call to the setjmp becomes
+ *
+ *     if (PPU_SJLJ_ENTER(ctx, <return address>) == 0) func_<setjmp>(ctx);
+ *
+ * a HOST setjmp in the caller's own frame, into a host jmp_buf this runtime
+ * keeps per host thread, keyed by the guest jmp_buf address (r3), before the
+ * guest setjmp body saves the guest registers as usual. The longjmp's body
+ * runs as lifted (it restores the guest registers and computes the return
+ * value) and then calls ppu_sjlj_longjmp, which host-longjmps to the matching
+ * setjmp site: the call there "returns" a second time, with the guest state
+ * the jmp_buf held and r3 = the longjmp value. Every exit of a function with
+ * setjmp sites calls ppu_sjlj_leave, so the runtime knows when a setjmp stops
+ * being a valid target. When there is no matching live
+ * site (the setjmp was not one of the rewritten calls, its frame has
+ * returned, it was made on another guest context -- e.g. outside the HLE
+ * callback the longjmp runs in), ppu_sjlj_longjmp logs it and returns, which
+ * is the behaviour without this support.
+ *
+ * Generated code includes this header only where it uses it, so a lift
+ * without --sjlj does not change.
+ */
+#ifndef PS3RECOMP_PPU_SJLJ_H
+#define PS3RECOMP_PPU_SJLJ_H
+
+#include <setjmp.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ppu_context;
+
+/* The host jmp_buf for the guest setjmp the caller is about to make with
+ * jmp_buf = ctx->gpr[3]. ret_addr is the guest return address of the call (the
+ * LR the guest setjmp saves), host_frame the frame address of the lifted
+ * function making the call. Never NULL: without a free slot it is a scratch
+ * buffer no longjmp is ever sent to. */
+jmp_buf* ppu_sjlj_enter(struct ppu_context* ctx, uint32_t ret_addr, void* host_frame);
+
+/* Called on every exit of a lifted function that has setjmp sites (with
+ * PPU_SJLJ_FRAME() of that function): its setjmps, and any made deeper, are
+ * no longer valid targets. */
+void ppu_sjlj_leave(void* host_frame);
+
+/* Called by the lifted guest longjmp after it restored the guest registers
+ * from the jmp_buf at `buf` (r3 on entry). Does not return when the matching
+ * setjmp site is live; returns (after a log line) when it is not. */
+void ppu_sjlj_longjmp(struct ppu_context* ctx, uint64_t buf);
+
+/* Counters for tests and diagnostics. */
+typedef struct ppu_sjlj_stats {
+    uint64_t enters;      /* setjmp sites entered                         */
+    uint64_t jumps;       /* longjmps carried out                         */
+    uint64_t fallbacks;   /* longjmps with no live site (returned instead) */
+    uint32_t live;        /* slots in use on this host thread             */
+} ppu_sjlj_stats;
+void ppu_sjlj_get_stats(ppu_sjlj_stats* out);
+
+#ifdef __cplusplus
+}
+#endif
+
+/* No signal-mask save: the guest does not expect one, and it is a syscall on
+ * macOS. */
+#if defined(_WIN32)
+#  define PPU_SJLJ_HOST_SETJMP(jb)     setjmp(jb)
+#  define PPU_SJLJ_HOST_LONGJMP(jb, v) longjmp((jb), (v))
+#else
+#  define PPU_SJLJ_HOST_SETJMP(jb)     _setjmp(jb)
+#  define PPU_SJLJ_HOST_LONGJMP(jb, v) _longjmp((jb), (v))
+#endif
+
+#if defined(_MSC_VER) && !defined(__clang__)
+#  include <intrin.h>
+#  define PPU_SJLJ_FRAME() ((void*)_AddressOfReturnAddress())
+#else
+#  define PPU_SJLJ_FRAME() __builtin_frame_address(0)
+#endif
+
+/* The setjmp has to be invoked in the frame that later resumes, so this is a
+ * macro used as the whole controlling expression of an `if` (one of the forms
+ * C allows setjmp in): `if (PPU_SJLJ_ENTER(ctx, ret) == 0) <guest setjmp>`. */
+#define PPU_SJLJ_ENTER(ctx, ret) \
+    PPU_SJLJ_HOST_SETJMP(*ppu_sjlj_enter((ctx), (ret), PPU_SJLJ_FRAME()))
+
+#endif /* PS3RECOMP_PPU_SJLJ_H */

diff --git a/libs/codec/tests/gen_adec_media.cmake b/libs/codec/tests/gen_adec_media.cmake
new file mode 100644
index 0000000..7dc1e8c
--- /dev/null
+++ b/libs/codec/tests/gen_adec_media.cmake
@@ -0,0 +1,20 @@
+# Generates the AC3 stream test_adec_decode feeds through cellAdec. Nothing here
+# is committed: it is written to the build tree at test time.
+#
+#   cmake -DFFMPEG=<ffmpeg> -DOUT=<dir> -P gen_adec_media.cmake
+#
+# 3 s of AC3 3/2 + LFE at 448 kb/s (1792-byte frames, what Resistance: Fall of
+# Man's movies carry), one tone per speaker at its own level, so the test can
+# tell the channels apart: L 0.10, R 0.20, C 0.30, LFE 0.40 (60 Hz, inside the
+# LFE band), Ls 0.25, Rs 0.15.
+if(NOT FFMPEG OR NOT OUT)
+    message(FATAL_ERROR "pass -DFFMPEG=<ffmpeg> -DOUT=<dir>")
+endif()
+file(MAKE_DIRECTORY "${OUT}")
+execute_process(COMMAND "${FFMPEG}" -nostdin -hide_banner -loglevel error -y
+    -f lavfi -i "aevalsrc=0.10*sin(2*PI*440*t)|0.20*sin(2*PI*550*t)|0.30*sin(2*PI*660*t)|0.40*sin(2*PI*60*t)|0.25*sin(2*PI*770*t)|0.15*sin(2*PI*880*t):c=5.1:s=48000:d=3"
+    -c:a ac3 -b:a 448k -f ac3 "${OUT}/a.ac3"
+    RESULT_VARIABLE rc)
+if(NOT rc EQUAL 0)
+    message(FATAL_ERROR "ffmpeg failed (${rc})")
+endif()

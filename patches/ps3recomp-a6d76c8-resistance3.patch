+                if (eb < 1) eb = 1;
+                if (eb > 255) eb = 255;
+                a._u32[i] = sa | (ea << 23) | (rnd32() & 0x7FFFFFu);
+                b._u32[i] = sb | ((uint32_t)eb << 23) | (rnd32() & 0x7FFFFFu);
+                const double pd = (double)spu__sf_f(a._u32[i]) * (double)spu__sf_f(b._u32[i]);
+                const float pf = (float)-pd;
+                uint32_t w; memcpy(&w, &pf, 4);
+                c._u32[i] = ((w >> 23) & 0xFFu) && ((w >> 23) & 0xFFu) < 255 && (rnd32() & 1)

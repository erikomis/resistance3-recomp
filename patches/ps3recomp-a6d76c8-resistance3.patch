@@ -0,0 +1,112 @@
+/* PS3_NP_SIGNIN=1 with PS3_NET_ONLINE=1: signed in with no psnr server, for
+ * community Medius servers. The manager reports ONLINE, RequestTicket makes a
+ * version 2.1 ticket and announces it with GOT_TICKET (255, the size as the
+ * result), GetTicket hands it over, and the online ID and service ID sit
+ * where a Medius server reads them (84 and 136 bytes in). Without PS3_NET_ONLINE
+ * nothing changes: offline as before.
+ *
+ *   cc -std=gnu17 -I include -o /tmp/test_np_ticket_local \
+ *      libs/network/tests/test_np_ticket_local.c && /tmp/test_np_ticket_local
+ */
+#include "../sceNp.c"
+#include <assert.h>
+#include <stdlib.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;

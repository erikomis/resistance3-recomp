+/* A built pipeline's binaries for the next save, off the caller's thread.
+ * Nothing is compiled or written here. */
+static void pa_add(MTLRenderPipelineDescriptor* pd, u64 key)
+{
+    if (!s_pc_archive_on || !pd || !pd.vertexFunction || !pd.fragmentFunction) return;
+    MTLRenderPipelineDescriptor* c = [pd copy];
+    if (@available(macOS 11.0, *)) c.binaryArchives = nil;
+    dispatch_async(s_pc_io, ^{
+        if (!s_pa_pend) return;                 /* no archive on this system */
+        [s_pa_pend addObject:c];
+        [s_pa_pend_key addObject:@(key)];
+        if (__atomic_load_n(&s_pa_compact, __ATOMIC_ACQUIRE)) return;   /* one save, at the end of the prewarm */
+        if (s_pa_pend.count >= s_pa_flush_n) { pa_save(0); return; }
+        if (!s_pa_timer) {
+            s_pa_timer = 1;
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 30 * (int64_t)NSEC_PER_SEC), s_pc_io, ^{
+                s_pa_timer = 0;
+                if (!__atomic_load_n(&s_pa_compact, __ATOMIC_ACQUIRE)) pa_save(0);
+            });
+        }
+    });
+}

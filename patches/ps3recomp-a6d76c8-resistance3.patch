+/* The pipeline state of `pd`: from the archive when it is there (*hit), else
+ * compiled (by macOS's cache or from scratch). Any thread. */
+static id<MTLRenderPipelineState> pc_build_pso(MTLRenderPipelineDescriptor* pd, int* hit, NSError** err)
+{
+    *hit = 0;
+    if (@available(macOS 11.0, *)) {
+        if (__atomic_load_n(&s_pa_ready, __ATOMIC_ACQUIRE)) {
+            pd.binaryArchives = s_pa_read;
+            id<MTLRenderPipelineState> pso =
+                [s_dev newRenderPipelineStateWithDescriptor:pd
+                                                    options:MTLPipelineOptionFailOnBinaryArchiveMiss
+                                                 reflection:nil error:nil];
+            if (pso) {
+                *hit = 1;
+                __atomic_add_fetch(&s_pa_hits, 1, __ATOMIC_RELAXED);
+                return pso;
+            }
+        }
+    }
+    return [s_dev newRenderPipelineStateWithDescriptor:pd error:err];
+}

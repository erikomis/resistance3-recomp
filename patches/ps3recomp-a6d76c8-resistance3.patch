+/* s_pc_lock held. */
+static int pc_find_locked(u64 key)
+{
+    u32 p = (u32)(key ^ (key >> 32)) & (PC_INDEX - 1u);
+    while (s_pc_index[p]) {
+        if (s_pc[s_pc_index[p] - 1u].rec.key == key) return (int)(s_pc_index[p] - 1u);
+        p = (p + 1u) & (PC_INDEX - 1u);
+    }
+    return -1;
+}
+static int pc_add_locked(const PcRec* r)
+{
+    if (s_pc_count >= PC_MAX) return -1;
+    const u32 i = s_pc_count++;
+    s_pc[i].rec = *r;
+    s_pc[i].state = PC_NONE;
+    u32 p = (u32)(r->key ^ (r->key >> 32)) & (PC_INDEX - 1u);
+    while (s_pc_index[p]) p = (p + 1u) & (PC_INDEX - 1u);
+    s_pc_index[p] = i + 1u;
+    return (int)i;
+}

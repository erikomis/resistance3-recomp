@@ -110,6 +165,70 @@ int main(void)
         present(in, out, 1, 1.0f);
         assert(!memcmp(out[row + 5], in[row + 5], 4) && !memcmp(out[row + 26], in[row + 26], 4));
 
+        /* ---- the colour filters ---- */
+        /* a dull colour (B 100, G 120, R 140) left half, mid grey right half */
+        for (int y = 0; y < H; y++)
+            for (int x = 0; x < W; x++) {
+                unsigned char* q = in[y * W + x];
+                if (x < W / 2) { q[0] = 100; q[1] = 120; q[2] = 140; q[3] = 0xFF; }
+                else grey(q, 128, 0xFF);

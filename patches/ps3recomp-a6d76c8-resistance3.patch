+                      RSX_TEST_FP_INSRC(1) | RSX_TEST_FP_END,
+                      RSX_TEST_FP_SRC_INPUT | RSX_TEST_FP_SWZ_IDENT);
+    m(0x08E4, (WPOS_FP_OFFSET + 0x100u) | 2u);
+    m(M_SHADER_WINDOW, 720u | (1u << 12));
+    draw_triangle();
+    const u32 col = stub.bound_pipeline;
+    before = stub.n_pipeline_create;
+    m(M_SHADER_WINDOW, 192u | (1u << 12));

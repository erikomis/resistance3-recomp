+/* Diff snapshots for RES_STATESCAN follow-ups: cellPad.c button hook calls
+ * ppu_statescan_diff on each scripted press and the changed words in the FSM
+ * globals region print. First call primes the snapshot silently. */
+extern "C" void ppu_statescan_diff(uint32_t lo, uint32_t hi, const char* tag)
+{
+    enum { MAXN = 1u << 20 };              /* 4 MB region / 4-byte words */
+    static uint32_t* snap = 0;
+    static uint32_t  cap  = 0;
+    uint32_t n = (hi - lo) / 4;
+    if (n > MAXN) n = MAXN;
+    if (!snap || n > cap) {
+        /* static buffer twice the max we allow; avoid malloc in hot hook */
+        static uint32_t buf[MAXN];
+        snap = buf; cap = MAXN;
+    }
+    static uint32_t lo_s = 0;
+    if (lo_s != lo) {
+        for (uint32_t i = 0; i < n; i++) snap[i] = vm_read32(lo + i*4);
+        lo_s = lo;
+        fprintf(stderr, "[STATESCAN-DIFF] primed %08X..%08X (%s) words=%u\n", lo, hi, tag, n);
+        return;
+    }
+    int chg = 0;
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t v = vm_read32(lo + i*4);
+        if (v != snap[i]) {
+            if (chg < 48)
+                fprintf(stderr, "[STATESCAN-DIFF] %s %08X: %08X -> %08X\n",
+                        tag, lo + i*4, snap[i], v);
+            else if (chg == 48)
+                fprintf(stderr, "[STATESCAN-DIFF] %s ... suppressed\n", tag);
+            snap[i] = v;
+            chg++;
+        }
+    }
+    fprintf(stderr, "[STATESCAN-DIFF] %s changes=%d\n", tag, chg);
+    fflush(stderr);
+}

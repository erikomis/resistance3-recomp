+/* Signal notification registers of the virtual SPUs, as the guest wrote them
+ * with sys_spu_thread_write_snr on the ids cellSpursGetInfo hands out. Each
+ * policy-module entry on that lane finds the value pending in its SNR
+ * channel (spurs_vspu_snr, from spu_run_policy_module): a module that reads
+ * SNR1 on entry gets it every time it is dispatched, as one that stays
+ * resident on a real SPU would have it once. */
+static u32 s_vspu_snr[MAX_SPURS_INST][8][2];
+static u8  s_vspu_snr_set[MAX_SPURS_INST][8][2];
+
+int spurs_vspu_write_snr(u32 tid, u32 num, u32 value)
+{
+    if ((tid & 0xFFFF0000u) != SPURS_VSPU_TID(0, 0) || num > 1) return 0;
+    u32 idx = (tid >> 8) & 0xFF, spu = tid & 0xFF;
+    if (idx >= MAX_SPURS_INST || spu >= 8) return 0;
+    __atomic_store_n(&s_vspu_snr[idx][spu][num], value, __ATOMIC_RELEASE);
+    __atomic_store_n(&s_vspu_snr_set[idx][spu][num], 1, __ATOMIC_RELEASE);
+    u32 ea = __atomic_load_n(&s_inst[idx].ea, __ATOMIC_ACQUIRE);
+    if (ea) {
+        extern void spurs_policy_deliver_snr(u32 ea, u32 lane, u32 num, u32 value);
+        spurs_policy_deliver_snr(ea, spu, num, value);
+    }
+    return 1;
+}
+
+/* The synthetic thread id of lane `spu` of the instance at spurs_ea, or 0. */
+u32 spurs_vspu_tid_for(u32 spurs_ea, u32 spu)
+{
+    struct SpursInst* si = spurs_inst_find(spurs_ea);
+    if (!si || spu >= 8) return 0;
+    return SPURS_VSPU_TID((u32)(si - s_inst), spu);
+}
+
+/* tid -> (instance EA, lane), for a synthetic id; 0 if it is not one. */
+int spurs_vspu_lookup(u32 tid, u32* spurs_ea, u32* lane)
+{
+    if ((tid & 0xFFFF0000u) != SPURS_VSPU_TID(0, 0)) return 0;
+    u32 idx = (tid >> 8) & 0xFF, spu = tid & 0xFF;
+    if (idx >= MAX_SPURS_INST || spu >= 8) return 0;
+    u32 ea = __atomic_load_n(&s_inst[idx].ea, __ATOMIC_ACQUIRE);
+    if (!ea) return 0;
+    *spurs_ea = ea; *lane = spu;
+    return 1;
+}
+
+int spurs_vspu_snr(u32 spurs_ea, u32 spu, u32 num, u32* value)
+{
+    struct SpursInst* si = spurs_inst_find(spurs_ea);
+    if (!si || spu >= 8 || num > 1) return 0;
+    int idx = (int)(si - s_inst);
+    if (!__atomic_load_n(&s_vspu_snr_set[idx][spu][num], __ATOMIC_ACQUIRE)) return 0;
+    *value = __atomic_load_n(&s_vspu_snr[idx][spu][num], __ATOMIC_ACQUIRE);
+    return 1;
+}

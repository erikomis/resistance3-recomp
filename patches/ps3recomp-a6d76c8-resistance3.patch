+/* The put watcher (see the walker, "The link out of a list"). Polls only
+ * while the walker rests; one read of put every 100 us otherwise idle. */
+/* ---- shadow fetch ---------------------------------------------------------
+ *
+ * The RSX fetches a command within microseconds of `put` moving past it; this
+ * walker executes it when its thread next runs, and while it builds pipelines
+ * or uploads textures that is tens or hundreds of milliseconds later. A title
+ * may rely on the first and never know: Resistance 3 chains per-frame command
+ * lists that live in its frame allocator (0x0080A100.. every frame, others at
+ * 0x00ABxxxx), links each onward with a JUMP at its end, and hands the memory
+ * back when the frame is over. A walker a frame behind then follows a JUMP
+ * into, or out of, a list that has become strings and pointers. It decodes
+ * them until it meets a JUMP/CALL it cannot take ("CALL to unmapped IO
+ * 0x1EBEBEBC"), circles in them for 20 s, or -- worst -- applies them
+ * (eng_store_extent_ok, rsx_draw_engine.c). Each time the title's end-of-frame
+ * label never arrives and the game stands still for 6 s.
+ *
+ * So the fetch is done on time, by a shadow of the walker that decodes only
+ * control flow and block lengths. gcm_put_watch_main runs it every 100 us and
+ * the walker runs it before it reads anything, both under s_sh_lock. It keeps:
+ *
+ *   - a copy of every list entered by a JUMP, up to GCM_SH_CAP bytes, with the
+ *     JUMP that leaves it once the title has written one. When the walker
+ *     takes the same JUMP it reads that list from the copy (mirrored into
+ *     guest memory at GCM_SH_SCRATCH, because the walker and everything it
+ *     calls read commands by guest address) -- the bytes the RSX fetched,
+ *     whatever the memory holds by now;
+ *
+ *   - a log of the commands on the path that the title can be waiting for:
+ *     semaphore offset/release, back-end labels, SET_REFERENCE, GET_REPORT and
+ *     flip markers. A resync replays the ones the walker never reached
+ *     (gcm_sl_replay) instead of guessing at them.
+ *
+ * Lists longer than the cap -- a ring, the two 5 MB frame lists -- are not
+ * copied and are read in place as before; they are not what gets reclaimed.
+ * GCM_SHADOW_FETCH=0 turns all of it off. */
+#define GCM_SH_CAP     (256u * 1024u)
+#define GCM_SH_RECS    16u
+/* Just past the 16 MB HLE window (codec scratch runs to its end), so it moves
+ * with ppu_hle_inject_base like everything else the title never asked for. */
+#define GCM_SH_SCRATCH (VM_HLE_INJECT_BASE + VM_HLE_INJECT_SIZE)
+#define GCM_SL_N       4096u
+typedef struct { u32 start, len, seq; u8 open, exit_known, dead; u8* data; } gcm_sh_rec;
+typedef struct { u32 off, m, v, hw; } gcm_sl_ent;   /* hw: the block header */
+static gcm_sh_rec s_sh_rec[GCM_SH_RECS];
+static u32 s_sh_nrec;                 /* lists opened so far; seq = 1.. */
+static u32 s_sh_cur;                  /* seq of the list the shadow is in, 0 = none */
+static int s_sh_valid;
+static u32 s_sh_pos, s_sh_call;
+static SRWLOCK s_sh_lock = SRWLOCK_INIT;
+static gcm_sl_ent s_sl[GCM_SL_N];
+static _Atomic u32 s_sl_tail;
+static u32 s_sl_head;                 /* the walker's */
+/* The walker's side: the list it is reading from the copy. */
+/* s_rd_seq is the list the WALKER is in, counted the way the shadow counts
+ * them (one per JUMP taken), whether or not it has a copy; s_rd_known says the
+ * count can be trusted. The two take the same JUMPs in the same order, so the
+ * walker's next list is always s_rd_seq + 1 -- matching a list by its address
+ * is not enough, because the title reuses the same two addresses every other
+ * frame and an older copy of "the list at 0x10B00" is exactly the wrong one. */
+static int s_rd_on, s_rd_known;
+static u32 s_rd_start, s_rd_avail, s_rd_seq;
+static u32 s_sh_put;                  /* the put the shadow last walked to */
+
+static int gcm_sh_on(void)
+{
+    static int on = -1;
+    if (!vm_base) return 0;
+    if (on < 0) {
+        const char* e = getenv("GCM_SHADOW_FETCH");
+        on = !(e && e[0] == '0') &&
+             (ppu_vm_size == 0 || (u64)GCM_SH_SCRATCH + GCM_SH_CAP + 8u <= ppu_vm_size);
+    }
+    return on;
+}
+
+static gcm_sh_rec* gcm_sh_lookup(u32 seq)
+{
+    if (!seq) return NULL;
+    gcm_sh_rec* r = &s_sh_rec[(seq - 1u) % GCM_SH_RECS];
+    return r->seq == seq ? r : NULL;
+}
+
+static int gcm_sh_copy(u8* dst, u32 io, u32 n)
+{
+    while (n) {
+        const u32 ea = gcm_io2ea(io);
+        if (!ea) return 0;
+        u32 chunk = 0x100000u - (io & 0xFFFFFu);
+        if (chunk > n) chunk = n;
+        memcpy(dst, vm_base + ea, chunk);
+        dst += chunk; io += chunk; n -= chunk;
+    }
+    return 1;
+}
+
+/* Bring the open list's copy up to the shadow's position. */
+static void gcm_sh_extend(void)
+{
+    gcm_sh_rec* r = gcm_sh_lookup(s_sh_cur);
+    if (!r || r->dead || s_sh_call) return;         /* inside a CALL: elsewhere */
+    if (s_sh_pos < r->start || s_sh_pos - r->start > GCM_SH_CAP) {
+        r->dead = 1; r->open = 0; s_sh_cur = 0;     /* too long to be a side list */
+        return;
+    }
+    const u32 want = s_sh_pos - r->start;
+    if (want > r->len) {
+        if (!gcm_sh_copy(r->data + r->len, r->start + r->len, want - r->len)) {
+            r->dead = 1; r->open = 0; s_sh_cur = 0; return;
+        }
+        r->len = want;
+    }
+}
+
+static void gcm_sl_push(u32 off, u32 m, u32 v, u32 hw)
+{
+    const u32 t = atomic_load(&s_sl_tail);
+    s_sl[t % GCM_SL_N].off = off; s_sl[t % GCM_SL_N].m = m; s_sl[t % GCM_SL_N].v = v;
+    s_sl[t % GCM_SL_N].hw = hw;
+    atomic_store(&s_sl_tail, t + 1u);

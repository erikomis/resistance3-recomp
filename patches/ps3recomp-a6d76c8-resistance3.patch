+/* Real registry/dispatcher regression, with synthetic code and no game data.
+ * Build/run with tools/test_spu_dispatch_residency.py. */
+#include "../spu_helpers.h"
+#include "../spu_interp.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+/* No SPURS instance is created by this fixture. */

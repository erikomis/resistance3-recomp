+/*
+ * ps3recomp - host window: one window across an executable swap (macOS)
+ *
+ *   host_window [--title T] [--size WxH] [--] <program> [args...]
+ *
+ * Opens the game window, then runs <program> with PS3RECOMP_HOST_SURFACES set
+ * in its environment. The Metal backend in <program> sees it and, instead of
+ * opening a window of its own, renders into IOSurfaces this process shares
+ * with it (rsx_host_surface.h); this process blits the newest finished one
+ * into the window. When the game replaces its executable (exitspawn is an
+ * execv, same pid) the new image attaches again by the same name, and the
+ * window never goes away.
+ *
+ *   window closed / Cmd-Q / SIGINT, SIGTERM, SIGHUP here
+ *       -> `closed` in the control page, SIGTERM to the game, SIGKILL 3 s later
+ *   game exits -> exit with its status (0 after a close asked for here)
+ *
+ * The game process has no window and never touches NSApplication, so it gets
+ * no Dock icon; this process is the app the user sees.
+ *
+ * Keyboard and mouse: their events arrive here, so this process records them
+ * in the control page's input block (libs/input/host_input_cocoa.h) and the
+ * game's cellPad reads it. A left click in the game captures the cursor when
+ * the game asks for that (its mouse camera, PS3_MOUSE / PS3_MOUSE_CAPTURE on
+ * the game's side); Esc, Cmd or leaving the window releases it.
+ *
+ * Environment:
+ *   PS3_TITLE              window title (default: HOST_WINDOW_TITLE, built in)
+ *   PS3_WINDOW_MODE, PS3_WINDOW_SIZE, PS3_DISPLAY, PS3_VSYNC, PS3_UPSCALE,
+ *   PS3_DOWNSCALE, PS3_CAS_AFTER, PS3_DOWNSCALE_LINEAR
+ *                          how the window opens and presents (host_display.h)
+ *   PS3RECOMP_METAL_FPS=1  FPS in the title and [RSX FPS] lines, as the backend's
+ *                          own window does; guest FPS comes from the game.
+ *                          A line ends in hidden=1 while the window is off
+ *                          screen (below)
+ *   PS3RECOMP_HOST_STATS=1 once a second: publish->screen latency, frames
+ *                          copied/dropped, and this process's CPU time
+ *
+ * Off screen: macOS shows nothing of a window that is not on screen: another
+ * app or Space in front (with PS3_WINDOW_MODE=fullscreen the window has a
+ * Space of its own, so bringing any other app to the front hides it),
+ * minimized, or fully covered. Presents go on and are dropped unseen, so the
+ * display rate reads 0 while the guest's goes on, which in a log looks like a
+ * frozen picture. The window logs when it leaves the screen and when it is
+ * back, and shows the newest frame as soon as it is back.
+ *
+ * Screenshot: View > Save Screenshot (Cmd+Shift+S), or SIGUSR1 to this
+ * process, saves the next frame as it is put on the screen -- after the
+ * reduction or MetalFX and the sharpening, at the window's size -- as a PNG in
+ * ~/Pictures/<title>/.
+ *
+ * If the bootstrap service cannot be registered the program is exec'd
+ * directly and opens its own window, as it would without this launcher.
+ */
+#import <AppKit/AppKit.h>
+#import <IOSurface/IOSurface.h>
+#import <Metal/Metal.h>
+#import <QuartzCore/QuartzCore.h>
+#if __has_include(<MetalFX/MetalFX.h>)
+#  import <MetalFX/MetalFX.h>
+#  define HOST_HAVE_METALFX 1
+#endif
+
+#include <dlfcn.h>
+#if __has_include(<MetalPerformanceShaders/MetalPerformanceShaders.h>)
+#  import <MetalPerformanceShaders/MetalPerformanceShaders.h>
+#  define HOST_HAVE_MPS 1
+#endif
+
+#include <errno.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <servers/bootstrap.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "host_display.h"
+#include "metal_frame_rate.h"
+#include "rsx_host_surface.h"
+#include "../../libs/input/host_input_cocoa.h"
+
+#ifndef HOST_WINDOW_TITLE
+#define HOST_WINDOW_TITLE "ps3recomp"
+#endif
+
+extern char** environ;
+
+static struct {
+    /* the shared side */
+    char                 name[128];
+    mach_port_t          service;          /* receive right, bootstrap-registered */
+    rsx_host_control*    ctl;
+    mach_port_t          ctl_entry;        /* memory entry for the control page */
+    IOSurfaceRef         surface[RSX_HOST_SLOTS];
+    id<MTLTexture>       tex[RSX_HOST_SLOTS];
+    u_int32_t            width, height;
+    /* the window */
+    id<MTLDevice>        dev;
+    id<MTLCommandQueue>  queue;
+    CAMetalLayer*        layer;
+    NSWindow*            window;
+    NSString*            title;
+    int                  present_busy;
+    uint64_t             shown_seq;
+    int                  off_screen;       /* see "Off screen" above */
+    double               off_since;
+    HostInputCocoa       input;            /* keys and mouse -> ctl->input */
+    /* display options (host_display.h) */
+    int                  fs_style;         /* what View > Full Screen enters */
+    int                  borderless;
+    NSRect               saved_frame;
+    NSWindowStyleMask    saved_style;
+    int                  upscale_on;       /* PS3_UPSCALE=metalfx, still working */
+    id                   fx_scaler;        /* id<MTLFXSpatialScaler> */
+    id<MTLTexture>       fx_out;
+    int                  down_on;          /* PS3_DOWNSCALE: Lanczos into a smaller window */
+    int                  cas_after;        /* PS3_CAS_AFTER: sharpen reduced frames here */
+    id<MTLRenderPipelineState> cas_pso;    /* the game's CAS, into the drawable */
+    id<MTLSamplerState>  cas_samp;
+    float                cas_logged;
+    id<MTLLibrary>       lib;              /* kCasMSL: the CAS and the filtered copy */
+    id<MTLRenderPipelineState> copy_pso;   /* a linear-filtered scaled copy (the fallback) */
+    id<MTLSamplerState>  lin_samp;
+    int                  down_linear;      /* PS3_DOWNSCALE_LINEAR: the reduction in linear light */
+    id<MTLTexture>       ds_out_raw;       /* ds_out's bytes as plain BGRA8 (linear mode) */
+    int                  direct_checked, direct_ok;   /* drawables a shader may write: reduce into them */
+    int                  gpu_errors, gpu_fail_run; /* failed present command buffers: all, in a row */
+    int                  shot_pending;     /* a screenshot of the next frame shown */
+    id                   ds_kernel;        /* MPSImageLanczosScale */
+    id<MTLTexture>       ds_out;
+    /* the game */
+    pid_t                child;
+    int                  closing;
+    int                  child_status;
+    /* diagnostics */
+    double               tick_to_s;
+    int                  fps_on, stats_on;
+    MetalFrameRate       fps;
+    pthread_mutex_t      fps_lock;
+    uint64_t             last_guest;
+    double               lat_sum, lat_max, copy_sum;
+    unsigned             lat_n, copy_n, copies;
+} g = { .fps_lock = PTHREAD_MUTEX_INITIALIZER };
+
+static void begin_close(const char* why);
+static void keep_drawable(void);
+
+/* ---- surfaces ------------------------------------------------------------ */
+
+static IOSurfaceRef make_surface(u_int32_t w, u_int32_t h)
+{
+    const size_t bpr = IOSurfaceAlignProperty(kIOSurfaceBytesPerRow, (size_t)w * 4);
+    NSDictionary* props = @{
+        (id)kIOSurfaceWidth:           @(w),
+        (id)kIOSurfaceHeight:          @(h),
+        (id)kIOSurfaceBytesPerElement: @4,
+        (id)kIOSurfaceBytesPerRow:     @(bpr),
+        (id)kIOSurfaceAllocSize:       @(bpr * h),
+        (id)kIOSurfacePixelFormat:     @((u_int32_t)'BGRA'),
+    };
+    return IOSurfaceCreate((__bridge CFDictionaryRef)props);
+}
+
+/* (Re)create every surface at w x h. A surface the window is still copying
+ * from stays READING and is freed by that copy's completion; the copy holds
+ * its own reference to the old texture. */
+static int make_surfaces(u_int32_t w, u_int32_t h)
+{
+    IOSurfaceRef sf[RSX_HOST_SLOTS] = { 0 };
+    id<MTLTexture> tex[RSX_HOST_SLOTS] = { nil };
+    MTLTextureDescriptor* td =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                           width:w height:h mipmapped:NO];
+    td.usage       = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget |
+                     (g.down_linear ? MTLTextureUsagePixelFormatView : 0);   /* an sRGB view for PS3_DOWNSCALE_LINEAR */
+    td.storageMode = g.dev.hasUnifiedMemory ? MTLStorageModeShared : MTLStorageModeManaged;
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+        sf[i] = make_surface(w, h);
+        if (sf[i]) tex[i] = [g.dev newTextureWithDescriptor:td iosurface:sf[i] plane:0];
+        if (!tex[i]) {
+            for (int j = 0; j <= i; j++) if (sf[j]) CFRelease(sf[j]);
+            return -1;
+        }
+    }
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+        if (g.surface[i]) CFRelease(g.surface[i]);
+        g.surface[i] = sf[i];
+        g.tex[i] = tex[i];
+        uint32_t s = atomic_load(&g.ctl->state[i]);
+        if (s != RSX_HOST_READING) atomic_store(&g.ctl->state[i], RSX_HOST_FREE);
+        atomic_store(&g.ctl->seq[i], 0);
+    }
+    g.width = w; g.height = h;
+    g.ctl->width = w; g.ctl->height = h;
+    g.ctl->generation++;
+    g.shown_seq = atomic_load(&g.ctl->next_seq);
+    keep_drawable();
+    return 0;
+}
+
+static int make_control(void)
+{
+    vm_address_t addr = 0;
+    if (vm_allocate(mach_task_self(), &addr, RSX_HOST_CONTROL_BYTES, VM_FLAGS_ANYWHERE) != KERN_SUCCESS)
+        return -1;
+    memory_object_size_t size = RSX_HOST_CONTROL_BYTES;
+    if (mach_make_memory_entry_64(mach_task_self(), &size, addr, VM_PROT_READ | VM_PROT_WRITE,
+                                  &g.ctl_entry, MACH_PORT_NULL) != KERN_SUCCESS ||
+        size < RSX_HOST_CONTROL_BYTES)
+        return -1;
+    g.ctl = (rsx_host_control*)addr;
+    g.ctl->magic        = RSX_HOST_MAGIC;
+    g.ctl->version      = RSX_HOST_VERSION;
+    g.ctl->launcher_pid = getpid();
+    g.input.in          = &g.ctl->input;
+    return 0;
+}
+
+/* ---- the game's messages ------------------------------------------------- */
+
+static void reply_surfaces(mach_port_t reply)
+{
+    rsx_host_surfaces_msg m;
+    memset(&m, 0, sizeof m);
+    m.header.msgh_bits        = MACH_MSGH_BITS(MACH_MSG_TYPE_MOVE_SEND_ONCE, 0) | MACH_MSGH_BITS_COMPLEX;
+    m.header.msgh_size        = sizeof m;
+    m.header.msgh_remote_port = reply;
+    m.header.msgh_id          = RSX_HOST_MSG_SURFACES;
+    m.body.msgh_descriptor_count = 1 + RSX_HOST_SLOTS;
+    m.control.name        = g.ctl_entry;
+    m.control.disposition = MACH_MSG_TYPE_COPY_SEND;
+    m.control.type        = MACH_MSG_PORT_DESCRIPTOR;
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+        m.surface[i].name        = IOSurfaceCreateMachPort(g.surface[i]);
+        m.surface[i].disposition = MACH_MSG_TYPE_MOVE_SEND;
+        m.surface[i].type        = MACH_MSG_PORT_DESCRIPTOR;
+    }
+    m.width = g.width; m.height = g.height;
+    m.generation   = g.ctl->generation;
+    m.launcher_pid = getpid();
+    kern_return_t kr = mach_msg(&m.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof m, 0,
+                                MACH_PORT_NULL, 1000, MACH_PORT_NULL);
+    if (kr != KERN_SUCCESS) {
+        fprintf(stderr, "[host window] reply failed: %s\n", mach_error_string(kr));
+        for (int i = 0; i < RSX_HOST_SLOTS; i++)
+            mach_port_deallocate(mach_task_self(), m.surface[i].name);
+        mach_port_deallocate(mach_task_self(), reply);
+    }
+}
+
+static void on_attach(const rsx_host_attach_msg* a)
+{
+    const u_int32_t w = a->width, h = a->height;
+    if (w && h && w <= RSX_HOST_MAX_DIM && h <= RSX_HOST_MAX_DIM && (w != g.width || h != g.height)) {
+        if (make_surfaces(w, h) != 0)
+            fprintf(stderr, "[host window] could not make %ux%u surfaces; keeping %ux%u\n",
+                    w, h, g.width, g.height);
+    } else {
+        rsx_host_reset_rendering(g.ctl);       /* a new image: the old one's frames are gone */
+    }
+    fprintf(stderr, "[host window] pid %d attached: %ux%u, generation %u\n",
+            a->pid, g.width, g.height, g.ctl->generation);
+    reply_surfaces(a->header.msgh_remote_port);
+}
+
+static void try_present(void);
+static void save_screenshot(id<MTLTexture> shot);
+
+static void drain_messages(void)
+{
+    for (;;) {
+        union { rsx_host_attach_msg attach; rsx_host_frame_msg frame; } u;
+        struct { char buf[sizeof u]; mach_msg_trailer_t t; } in;
+        memset(&in, 0, sizeof in);
+        mach_msg_header_t* h = (mach_msg_header_t*)in.buf;
+        kern_return_t kr = mach_msg(h, MACH_RCV_MSG | MACH_RCV_TIMEOUT | MACH_RCV_LARGE, 0,
+                                    sizeof in, g.service, 0, MACH_PORT_NULL);
+        if (kr == MACH_RCV_TOO_LARGE) {             /* not ours: drop it */
+            mach_msg(h, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0, 0, g.service, 0, MACH_PORT_NULL);
+            continue;
+        }
+        if (kr != KERN_SUCCESS) break;
+        if (h->msgh_id == RSX_HOST_MSG_ATTACH && h->msgh_size >= sizeof(rsx_host_attach_msg) &&
+            !(h->msgh_bits & MACH_MSGH_BITS_COMPLEX))
+            on_attach((const rsx_host_attach_msg*)h);
+        else if (h->msgh_id != RSX_HOST_MSG_FRAME)
+            mach_msg_destroy(h);
+    }
+    try_present();
+}
+
+/* ---- presenting ---------------------------------------------------------- */
+
+static void note_presented(double shown, uint64_t published)
+{
+    if (!(shown > 0)) return;
+    pthread_mutex_lock(&g.fps_lock);
+    metal_frame_rate_presented(&g.fps, shown);
+    const double lat = shown - (double)published * g.tick_to_s;
+    if (published && lat >= 0 && lat < 10) {
+        g.lat_sum += lat; g.lat_n++;
+        if (lat > g.lat_max) g.lat_max = lat;
+    }
+    pthread_mutex_unlock(&g.fps_lock);
+}
+
+/* The drawable's size: the surfaces' (the layer letterboxes them to the
+ * window); with PS3_UPSCALE the view's pixel size fitted to their aspect when
+ * that is larger, and with PS3_DOWNSCALE when it is smaller. */
+static void keep_drawable(void)
+{
+    if (!g.layer || !g.width || !g.height) return;
+    unsigned w = g.width, h = g.height;
+    if ((g.upscale_on || g.down_on) && g.window) {
+        NSView* v = g.window.contentView;
+        const NSSize px = v ? [v convertSizeToBacking:v.bounds.size] : NSZeroSize;
+        unsigned fw, fh;
+        hd_fit_any(px.width, px.height, g.width, g.height, &fw, &fh);
+        if (g.upscale_on && fw > g.width && fh > g.height) { w = fw; h = fh; }
+        if (g.down_on && fw < g.width && fh < g.height) { w = fw; h = fh; }
+    }
+    /* the game leaves sharpening to us only while we reduce */
+    if (g.ctl) atomic_store(&g.ctl->reducing, (uint32_t)(g.down_on && w < g.width && h < g.height));
+    const CGSize want = CGSizeMake(w, h);
+    if (!CGSizeEqualToSize(g.layer.drawableSize, want)) g.layer.drawableSize = want;
+}
+
+/* MetalFX gave up: say why once and present at the surfaces' size. */
+static void upscale_fail(const char* why)
+{
+    if (!g.upscale_on) return;
+    g.upscale_on = 0;
+    g.fx_scaler = nil; g.fx_out = nil;
+    fprintf(stderr, "[host window] MetalFX upscaling unavailable (%s); presenting at %ux%u\n",
+            why, g.width, g.height);
+    keep_drawable();
+}
+
+/* PS3_CAS_AFTER: the game's contrast-adaptive sharpening (rsx_metal_backend.m,
+ * eng_present_fs's sharpen block, the same code) for a frame the game handed
+ * over unsharpened: one source texel apart, drawn straight into the drawable
+ * in place of the copy. */
+static NSString* const kCasMSL = @
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"struct VOut { float4 pos [[position]]; float2 uv; };\n"
+"vertex VOut cas_vs(uint i [[vertex_id]]) {\n"
+"    float2 p = float2((i << 1) & 2, i & 2); VOut o;\n"
+"    o.pos = float4(p * 2.0 - 1.0, 0.0, 1.0); o.uv = float2(p.x, 1.0 - p.y); return o; }\n"
+"fragment float4 cas_fs(VOut i [[stage_in]], texture2d<float> src [[texture(0)]],\n"
+"                       sampler s [[sampler(0)]], constant float3& p [[buffer(0)]]) {\n"
+"    float4 c = src.sample(s, i.uv); float2 d = p.xy;\n"
+"    float3 a  = saturate(src.sample(s, i.uv + float2(-d.x, -d.y)).rgb);\n"
+"    float3 b  = saturate(src.sample(s, i.uv + float2( 0.0, -d.y)).rgb);\n"
+"    float3 cc = saturate(src.sample(s, i.uv + float2( d.x, -d.y)).rgb);\n"
+"    float3 l  = saturate(src.sample(s, i.uv + float2(-d.x,  0.0)).rgb);\n"
+"    float3 e  = saturate(c.rgb);\n"
+"    float3 r  = saturate(src.sample(s, i.uv + float2( d.x,  0.0)).rgb);\n"
+"    float3 g  = saturate(src.sample(s, i.uv + float2(-d.x,  d.y)).rgb);\n"
+"    float3 h  = saturate(src.sample(s, i.uv + float2( 0.0,  d.y)).rgb);\n"
+"    float3 k  = saturate(src.sample(s, i.uv + float2( d.x,  d.y)).rgb);\n"
+"    float3 mn = min(min(min(l, e), min(r, b)), h); mn += min(mn, min(min(a, cc), min(g, k)));\n"
+"    float3 mx = max(max(max(l, e), max(r, b)), h); mx += max(mx, max(max(a, cc), max(g, k)));\n"
+"    float3 amp = sqrt(saturate(min(mn, 2.0 - mx) / max(mx, 1e-5)));\n"
+"    float3 w = amp * (-1.0 / mix(8.0, 5.0, saturate(p.z)));\n"
+"    c.rgb = saturate((b * w + l * w + r * w + h * w + e) / (1.0 + 4.0 * w)); return c; }\n"
+"fragment float4 copy_fs(VOut i [[stage_in]], texture2d<float> src [[texture(0)]], sampler s [[sampler(0)]]) {\n"
+"    return src.sample(s, i.uv); }\n";
+
+/* kCasMSL compiled once (the CAS and the filtered copy share it). */
+static id<MTLLibrary> host_lib(void)
+{
+    if (!g.lib) {
+        NSError* err = nil;
+        g.lib = [g.dev newLibraryWithSource:kCasMSL options:nil error:&err];
+        if (!g.lib) fprintf(stderr, "[host window] shaders failed: %s\n", err.localizedDescription.UTF8String);
+    }
+    return g.lib;
+}
+
+/* src scaled into dst with a linear filter: the fallback when the reduction or
+ * MetalFX cannot run for a frame, so the drawable already taken is shown
+ * instead of dropped. 0 when it cannot be encoded. */
+static int scaled_copy(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst)
+{
+    if (!g.copy_pso) {
+        id<MTLLibrary> lib = host_lib();
+        if (!lib) return 0;
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction   = [lib newFunctionWithName:@"cas_vs"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"copy_fs"];
+        pd.colorAttachments[0].pixelFormat = dst.pixelFormat;
+        NSError* err = nil;
+        g.copy_pso = [g.dev newRenderPipelineStateWithDescriptor:pd error:&err];
+        MTLSamplerDescriptor* sd = [MTLSamplerDescriptor new];
+        sd.minFilter = sd.magFilter = MTLSamplerMinMagFilterLinear;
+        g.lin_samp = [g.dev newSamplerStateWithDescriptor:sd];
+        if (!g.copy_pso || !g.lin_samp) return 0;
+    }
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture     = dst;
+    rp.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+    if (!e) return 0;
+    [e setRenderPipelineState:g.copy_pso];
+    [e setFragmentTexture:src atIndex:0];
+    [e setFragmentSamplerState:g.lin_samp atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];
+    return 1;
+}
+
+/* The CAS pipeline, made once; sharpen_caps tells the game it may leave
+ * sharpening to us. Off (caps 0) when it cannot be made. */
+static void cas_setup(MTLPixelFormat fmt)
+{
+    if (!g.cas_after || g.cas_pso) return;
+    NSError* err = nil;
+    id<MTLLibrary> lib = host_lib();
+    MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction   = [lib newFunctionWithName:@"cas_vs"];
+    pd.fragmentFunction = [lib newFunctionWithName:@"cas_fs"];
+    pd.colorAttachments[0].pixelFormat = fmt;
+    g.cas_pso = lib ? [g.dev newRenderPipelineStateWithDescriptor:pd error:&err] : nil;
+    g.cas_samp = [g.dev newSamplerStateWithDescriptor:[MTLSamplerDescriptor new]];   /* nearest, clamp */
+    if (!g.cas_pso || !g.cas_samp) {
+        fprintf(stderr, "[host window] sharpening after the reduction unavailable (%s); the game sharpens\n",
+                err ? err.localizedDescription.UTF8String : "no pipeline");
+        g.cas_after = 0; g.cas_pso = nil;
+        return;
+    }
+    if (g.ctl) atomic_store(&g.ctl->sharpen_caps, 1u);
+}
+
+/* src sharpened (strength `sharp`) into dst, which is the same size. 0 if it
+ * cannot be encoded (the caller copies instead). */
+static int cas_into(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst, float sharp)
+{
+    if (!g.cas_pso || src.width != dst.width || src.height != dst.height) return 0;
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    rp.colorAttachments[0].texture     = dst;
+    rp.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+    rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+    if (!e) return 0;
+    const float p[4] = { 1.0f / (float)src.width, 1.0f / (float)src.height, sharp, 0.0f };
+    [e setRenderPipelineState:g.cas_pso];
+    [e setFragmentTexture:src atIndex:0];
+    [e setFragmentSamplerState:g.cas_samp atIndex:0];
+    [e setFragmentBytes:p length:sizeof p atIndex:0];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [e endEncoding];
+    if (g.cas_logged != sharp) {
+        g.cas_logged = sharp;
+        fprintf(stderr, "[host window] sharpening %.2f after the reduction, %lux%lu\n", (double)sharp,
+                (unsigned long)dst.width, (unsigned long)dst.height);
+    }
+    return 1;
+}
+
+/* Lanczos gave up: say why once and present at the surfaces' size. */
+static void downscale_fail(const char* why)
+{
+    if (!g.down_on) return;
+    g.down_on = 0;
+    g.ds_kernel = nil; g.ds_out = nil; g.ds_out_raw = nil;
+    fprintf(stderr, "[host window] supersampling downscale unavailable (%s); the layer shrinks the picture\n", why);
+    keep_drawable();
+}
+
+/* The Lanczos kernel (MPSImageLanczosScale), made once; nil when it cannot be.
+ * MPS is looked up when first needed. */
+static id lanczos_kernel(void)
+{
+#if HOST_HAVE_MPS
+    static Class lanczos;
+    if (!lanczos) {
+        dlopen("/System/Library/Frameworks/MetalPerformanceShaders.framework/MetalPerformanceShaders",
+               RTLD_LAZY | RTLD_LOCAL);
+        lanczos = NSClassFromString(@"MPSImageLanczosScale");
+        if (!lanczos) { downscale_fail("MetalPerformanceShaders is not on this system"); return nil; }
+    }
+    if (!g.ds_kernel) {
+        g.ds_kernel = [[lanczos alloc] initWithDevice:g.dev];
+        if (!g.ds_kernel) { downscale_fail("not supported on this GPU"); return nil; }
+        /* The filter's taps past the picture's edge read the edge pixel, not
+         * black: with MPS's default (zero) the outer row and column came out
+         * darker, a 1-pixel frame (a white picture gave 223..245 there). */
+        ((MPSImageLanczosScale*)g.ds_kernel).edgeMode = MPSImageEdgeModeClamp;
+    }
+    return g.ds_kernel;
+#else
+    downscale_fail("built without MetalPerformanceShaders");
+    return nil;
+#endif
+}
+
+/* src reduced with a Lanczos filter into a private texture of ow x oh: every
+ * source pixel is weighed into the result, which is what turns an internal
+ * resolution above the window's into supersampling. nil when it cannot.
+ *
+ * PS3_DOWNSCALE_LINEAR=1 (experimental, off): the source is read through an
+ * sRGB view and written to an sRGB target, so the filter averages light, not
+ * gamma-encoded values; thin bright lines keep more of their brightness (the
+ * game's frames measured no better overall, with 4x the overshoot). The
+ * returned texture is then a plain BGRA8 view of the encoded bytes. */
+static id<MTLTexture> downscale(id<MTLCommandBuffer> cb, id<MTLTexture> src, NSUInteger ow, NSUInteger oh)
+{
+#if HOST_HAVE_MPS
+    if (!lanczos_kernel()) return nil;
+    const int linear = g.down_linear && (src.usage & MTLTextureUsagePixelFormatView);
+    const MTLPixelFormat ofmt = linear ? MTLPixelFormatBGRA8Unorm_sRGB : src.pixelFormat;
+    if (!g.ds_out || g.ds_out.width != ow || g.ds_out.height != oh || g.ds_out.pixelFormat != ofmt) {
+        MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:ofmt
+                                                                                      width:ow height:oh
+                                                                                  mipmapped:NO];
+        td.usage       = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead |
+                         (linear ? MTLTextureUsagePixelFormatView : 0);
+        td.storageMode = MTLStorageModePrivate;
+        g.ds_out = [g.dev newTextureWithDescriptor:td];
+        if (!g.ds_out) { downscale_fail("no memory for its output"); return nil; }
+        g.ds_out_raw = linear ? [g.ds_out newTextureViewWithPixelFormat:MTLPixelFormatBGRA8Unorm] : nil;
+        fprintf(stderr, "[host window] supersampling: %lux%lu reduced to %lux%lu (Lanczos%s)\n",
+                (unsigned long)src.width, (unsigned long)src.height, (unsigned long)ow, (unsigned long)oh,
+                linear ? ", linear light" : "");
+    }
+    if (!(src.usage & MTLTextureUsageShaderRead)) { downscale_fail("the surfaces cannot be read by a shader"); return nil; }
+    id<MTLTexture> in = linear ? [src newTextureViewWithPixelFormat:MTLPixelFormatBGRA8Unorm_sRGB] : src;
+    [(MPSImageLanczosScale*)g.ds_kernel encodeToCommandBuffer:cb sourceTexture:in destinationTexture:g.ds_out];
+    return linear ? g.ds_out_raw : g.ds_out;
+#else
+    (void)cb; (void)src; (void)ow; (void)oh;
+    downscale_fail("built without MetalPerformanceShaders");
+    return nil;
+#endif
+}
+
+/* The reduction written straight into the drawable, when a shader may write
+ * it (and not in linear mode): no texture of its own and no copy after it.
+ * Checked once; 0 = use downscale() and copy. */
+static int downscale_direct(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst)
+{
+#if HOST_HAVE_MPS
+    if (!g.direct_checked) {
+        g.direct_checked = 1;
+        g.direct_ok = (dst.usage & MTLTextureUsageShaderWrite) != 0;
+        fprintf(stderr, "[host window] supersampling %s\n", g.direct_ok
+                ? "writes straight into the drawable (no copy)"
+                : "goes through its own texture (the drawables are not shader-writable), then a copy");
+    }
+    if (!g.direct_ok || g.down_linear || !lanczos_kernel()) return 0;
+    if (!(src.usage & MTLTextureUsageShaderRead)) return 0;
+    [(MPSImageLanczosScale*)g.ds_kernel encodeToCommandBuffer:cb sourceTexture:src destinationTexture:dst];
+    return 1;
+#else
+    (void)cb; (void)src; (void)dst;
+    return 0;
+#endif
+}
+
+/* src through a MetalFX spatial scaler into a private texture of ow x oh;
+ * nil when it cannot. MetalFX is looked up when first needed, so the window
+ * host links nothing new and runs where it is missing. */
+static id<MTLTexture> upscale(id<MTLCommandBuffer> cb, id<MTLTexture> src, NSUInteger ow, NSUInteger oh)
+{
+#if HOST_HAVE_METALFX
+    if (@available(macOS 13.0, *)) {
+        static Class desc_class;
+        if (!desc_class) {
+            dlopen("/System/Library/Frameworks/MetalFX.framework/MetalFX", RTLD_LAZY | RTLD_LOCAL);
+            desc_class = NSClassFromString(@"MTLFXSpatialScalerDescriptor");
+            if (!desc_class) { upscale_fail("MetalFX is not on this system"); return nil; }
+        }
+        const MTLPixelFormat fmt = src.pixelFormat;
+        id<MTLFXSpatialScaler> sc = (id<MTLFXSpatialScaler>)g.fx_scaler;
+        if (!sc || sc.inputWidth != src.width || sc.inputHeight != src.height ||
+            sc.outputWidth != ow || sc.outputHeight != oh) {
+            g.fx_scaler = nil; g.fx_out = nil;
+            if (![desc_class supportsDevice:g.dev]) { upscale_fail("not supported on this GPU"); return nil; }
+            MTLFXSpatialScalerDescriptor* d = [desc_class new];
+            d.inputWidth  = src.width;  d.inputHeight  = src.height;
+            d.outputWidth = ow;         d.outputHeight = oh;
+            d.colorTextureFormat  = fmt;
+            d.outputTextureFormat = fmt;
+            d.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;   /* gamma-encoded */
+            sc = [d newSpatialScalerWithDevice:g.dev];
+            if (!sc) { upscale_fail("could not create the spatial scaler"); return nil; }
+            MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:fmt
+                                                                                          width:ow height:oh
+                                                                                      mipmapped:NO];
+            td.usage       = sc.outputTextureUsage | MTLTextureUsageShaderRead;
+            td.storageMode = MTLStorageModePrivate;
+            id<MTLTexture> out = [g.dev newTextureWithDescriptor:td];
+            if (!out) { upscale_fail("no memory for its output"); return nil; }
+            fprintf(stderr, "[host window] MetalFX spatial upscaling %lux%lu -> %lux%lu\n",
+                    (unsigned long)src.width, (unsigned long)src.height,
+                    (unsigned long)ow, (unsigned long)oh);
+            g.fx_scaler = sc;
+            g.fx_out = out;
+        }
+        if ((src.usage & sc.colorTextureUsage) != sc.colorTextureUsage) {
+            upscale_fail("the surfaces' usage does not allow it");
+            return nil;
+        }
+        sc.colorTexture       = src;
+        sc.outputTexture      = g.fx_out;
+        sc.inputContentWidth  = src.width;
+        sc.inputContentHeight = src.height;
+        [sc encodeToCommandBuffer:cb];
+        return g.fx_out;
+    }
+    upscale_fail("needs macOS 13");
+    return nil;
+#else
+    (void)cb; (void)src; (void)ow; (void)oh;
+    upscale_fail("built without MetalFX");
+    return nil;
+#endif
+}
+
+/* The newest frame the game has finished, onto the window: one GPU copy from
+ * its surface into a drawable of the same size, which the layer letterboxes
+ * into the window (with PS3_UPSCALE, MetalFX to the window's pixel size
+ * first). At most one copy is in flight; its completion looks for a newer
+ * frame. */
+static void try_present(void)
+{
+    if (g.present_busy || !g.ctl) return;
+    uint64_t seq = 0;
+    const int slot = rsx_host_begin_read(g.ctl, g.shown_seq, &seq);
+    if (slot < 0) return;
+    @autoreleasepool {
+        id<MTLTexture> src = g.tex[slot];
+        id<CAMetalDrawable> drawable = nil;
+        const CGSize ds = g.layer.drawableSize;
+        const int same  = src.width == (NSUInteger)ds.width && src.height == (NSUInteger)ds.height;
+        const int scale = !same && g.upscale_on &&
+                          (NSUInteger)ds.width > src.width && (NSUInteger)ds.height > src.height;
+        const int down  = !same && g.down_on &&
+                          (NSUInteger)ds.width < src.width && (NSUInteger)ds.height < src.height;
+        if (same || scale || down) drawable = [g.layer nextDrawable];
+        id<MTLCommandBuffer> cb = drawable ? [g.queue commandBuffer] : nil;
+        /* the strength the game left to us for this frame (0: it sharpened it,
+         * or sharpening is off), applied whatever the path, so exactly once */
+        float sharp = 0.0f;
+        { const uint32_t bits = atomic_load(&g.ctl->slot_sharpen[slot]); memcpy(&sharp, &bits, sizeof sharp); }
+        id<MTLTexture> from = src;
+        int done_into = 0, fallback = 0;
+        if (cb && scale) {
+            from = upscale(cb, src, (NSUInteger)ds.width, (NSUInteger)ds.height);
+            if (!from) fallback = 1;            /* MetalFX is off now: this frame filtered, plain next time */
+        } else if (cb && down) {
+            if (!(sharp > 0.0f) && downscale_direct(cb, src, drawable.texture)) done_into = 1;
+            else {
+                from = downscale(cb, src, (NSUInteger)ds.width, (NSUInteger)ds.height);
+                if (!from) fallback = 1;        /* the reduction is off now: this frame filtered, plain next time */
+            }
+        }
+        if (cb && fallback && !scaled_copy(cb, src, drawable.texture)) cb = nil;
+        if (!cb) {                              /* no drawable now: show it next time */
+            uint32_t s = RSX_HOST_READING;
+            atomic_compare_exchange_strong(&g.ctl->state[slot], &s, RSX_HOST_READY);
+            return;
+        }
+        if (!done_into && !fallback && !(sharp > 0.0f && cas_into(cb, from, drawable.texture, sharp))) {
+            id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+            [blit copyFromTexture:from toTexture:drawable.texture];
+            [blit endEncoding];
+        }
+        /* a screenshot of exactly what goes to the screen */
+        id<MTLTexture> shot = nil;
+        if (g.shot_pending) {
+            MTLTextureDescriptor* sd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:drawable.texture.pixelFormat
+                width:drawable.texture.width height:drawable.texture.height mipmapped:NO];
+            sd.storageMode = MTLStorageModeShared;
+            shot = [g.dev newTextureWithDescriptor:sd];
+            if (shot) {
+                id<MTLBlitCommandEncoder> sb = [cb blitCommandEncoder];
+                [sb copyFromTexture:drawable.texture toTexture:shot];
+                [sb endEncoding];
+                g.shot_pending = 0;
+            }
+        }
+        const uint64_t published = atomic_load(&g.ctl->publish_time[slot]);
+        [drawable addPresentedHandler:^(id<MTLDrawable> d) { note_presented(d.presentedTime, published); }];
+        [cb presentDrawable:drawable];
+        const int path_down = down && !fallback, path_up = scale && !fallback, path_cas = sharp > 0.0f;
+        [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+            const MTLCommandBufferStatus st = done.status;
+            NSString* why = st == MTLCommandBufferStatusCompleted ? nil
+                          : (done.error.localizedDescription ?: @"no reason given");
+            const double copied = (double)mach_absolute_time() * g.tick_to_s - (double)published * g.tick_to_s;
+            dispatch_async(dispatch_get_main_queue(), ^{
+                rsx_host_end_read(g.ctl, slot);
+                g.present_busy = 0;
+                g.copies++;
+                if (published) { g.copy_sum += copied; g.copy_n++; }
+                /* A present that failed on the GPU: said (the first few, then
+                 * every 100th), and after three in a row on a reduced, upscaled
+                 * or sharpened frame that path is turned off. */
+                if (why) {
+                    g.gpu_errors++; g.gpu_fail_run++;
+                    if (g.gpu_errors <= 5 || g.gpu_errors % 100 == 0)
+                        fprintf(stderr, "[host window] a present failed on the GPU (%d so far%s%s%s): %s\n",
+                                g.gpu_errors, path_down ? ", reduced" : "", path_up ? ", MetalFX" : "",
+                                path_cas ? ", sharpened" : "", why.UTF8String);
+                    if (g.gpu_fail_run >= 3) {
+                        if (path_down) downscale_fail("3 failed presents in a row");
+                        if (path_up) upscale_fail("3 failed presents in a row");
+                        if (path_cas && g.cas_after) {
+                            g.cas_after = 0;
+                            atomic_store(&g.ctl->sharpen_caps, 0u);
+                            fprintf(stderr, "[host window] sharpening after the reduction off (3 failed presents in a row); the game sharpens\n");
+                        }
+                        g.gpu_fail_run = 0;
+                    }
+                } else {
+                    g.gpu_fail_run = 0;
+                    if (shot) save_screenshot(shot);
+                }
+                try_present();
+            });
+        }];
+        g.present_busy = 1;
+        g.shown_seq = seq;
+        [cb commit];
+    }
+}
+
+/* Screenshot: the frame as it went to the screen (shot: a shared copy of the
+ * drawable) as a PNG in ~/Pictures/<title>/. */
+static void save_screenshot(id<MTLTexture> shot)
+{
+    const NSUInteger w = shot.width, h = shot.height;
+    NSBitmapImageRep* rep = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:(NSInteger)w
+        pixelsHigh:(NSInteger)h bitsPerSample:8 samplesPerPixel:4 hasAlpha:YES isPlanar:NO
+        colorSpaceName:NSDeviceRGBColorSpace bytesPerRow:(NSInteger)w * 4 bitsPerPixel:32];
+    if (!rep) return;
+    uint8_t* px = rep.bitmapData;
+    [shot getBytes:px bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+    for (NSUInteger i = 0; i < w * h; i++) {          /* BGRA -> RGBA, opaque */
+        uint8_t* p = px + i * 4; const uint8_t b = p[0]; p[0] = p[2]; p[2] = b; p[3] = 255;
+    }
+    NSData* png = [rep representationUsingType:NSBitmapImageFileTypePNG properties:@{}];
+    NSString* title = g.title.length ? g.title : @"ps3recomp";
+    NSString* safe = [[title componentsSeparatedByCharactersInSet:
+                       [NSCharacterSet characterSetWithCharactersInString:@"/:"]] componentsJoinedByString:@"-"];
+    NSString* dir = [[NSHomeDirectory() stringByAppendingPathComponent:@"Pictures"] stringByAppendingPathComponent:safe];
+    [[NSFileManager defaultManager] createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil];
+    NSDateFormatter* f = [NSDateFormatter new];
+    f.dateFormat = @"yyyy-MM-dd 'at' HH.mm.ss";
+    NSString* path = [dir stringByAppendingPathComponent:
+                      [NSString stringWithFormat:@"%@ %@.png", safe, [f stringFromDate:[NSDate date]]]];
+    if ([png writeToFile:path atomically:YES])
+        fprintf(stderr, "[host window] screenshot %lux%lu: %s\n", (unsigned long)w, (unsigned long)h, path.UTF8String);
+    else
+        fprintf(stderr, "[host window] screenshot could not be written to %s\n", path.UTF8String);
+}
+
+static void request_screenshot(void)
+{
+    g.shot_pending = 1;
+    fprintf(stderr, "[host window] screenshot: the next frame shown\n");
+    try_present();
+}
+
+/* The window's occlusion changed: on screen or not (see "Off screen" at the
+ * top). Logged both ways, so a run of display=0 reads as what it is. */
+static void note_on_screen(int on, double now)
+{
+    const int off = !on;
+    if (off == g.off_screen) return;
+    g.off_screen = off;
+    if (!on) {
+        g.off_since = now;
+        fprintf(stderr, "[host window] window off screen (another app or Space in front, minimized or "
+                        "covered): its frames are not shown until it is back\n");
+        return;
+    }
+    fprintf(stderr, "[host window] window on screen again after %.1f s\n", now - g.off_since);
+    try_present();
+}
+
+/* Black until the game's first frame, rather than whatever the drawable held. */
+static void present_black(void)
+{
+    @autoreleasepool {
+        id<CAMetalDrawable> d = [g.layer nextDrawable];
+        if (!d) return;
+        MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.colorAttachments[0].texture     = d.texture;
+        rp.colorAttachments[0].loadAction  = MTLLoadActionClear;
+        rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        rp.colorAttachments[0].clearColor  = MTLClearColorMake(0, 0, 0, 1);
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        [[cb renderCommandEncoderWithDescriptor:rp] endEncoding];
+        [cb presentDrawable:d];
+        [cb commit];
+    }
+}
+
+/* ---- diagnostics --------------------------------------------------------- */
+
+static void stats_tick(void)
+{
+    const uint64_t guest = atomic_load(&g.ctl->guest_frames);
+    pthread_mutex_lock(&g.fps_lock);
+    g.fps.guest += guest - g.last_guest;
+    g.last_guest = guest;
+    const MetalFrameRateSample r = metal_frame_rate_sample(&g.fps, CACurrentMediaTime());
+    const double lat_avg = g.lat_n ? g.lat_sum / g.lat_n : 0, lat_max = g.lat_max;
+    const unsigned lat_n = g.lat_n;
+    g.lat_sum = g.lat_max = 0; g.lat_n = 0;
+    pthread_mutex_unlock(&g.fps_lock);
+    if (g.fps_on) {
+        g.window.title = [NSString stringWithFormat:
+            @"%@ | display %.1f FPS | guest %.1f FPS | %.1f ms avg / %.1f p95 / %.1f max | age %.1f s",
+            g.title, r.display_fps, r.guest_fps, r.average_ms, r.p95_ms, r.worst_ms, r.age_seconds];
+        fprintf(stderr, "[RSX FPS] display=%.2f guest=%.2f avg_ms=%.2f p95_ms=%.2f max_ms=%.2f age_s=%.2f%s\n",
+                r.display_fps, r.guest_fps, r.average_ms, r.p95_ms, r.worst_ms, r.age_seconds,
+                g.off_screen ? " hidden=1" : "");
+    }
+    if (g.stats_on) {
+        struct rusage ru;
+        getrusage(RUSAGE_SELF, &ru);
+        const double cpu = ru.ru_utime.tv_sec + ru.ru_utime.tv_usec / 1e6 +
+                           ru.ru_stime.tv_sec + ru.ru_stime.tv_usec / 1e6;
+        fprintf(stderr, "[host window] copies=%u published=%llu reclaimed=%llu skipped=%llu "
+                        "publish->copied avg %.2f ms, publish->on-screen avg %.2f max %.2f ms (%u), cpu %.2f s\n",
+                g.copies, (unsigned long long)atomic_load(&g.ctl->published),
+                (unsigned long long)atomic_load(&g.ctl->reclaimed),
+                (unsigned long long)atomic_load(&g.ctl->skipped),
+                g.copy_n ? g.copy_sum / g.copy_n * 1e3 : 0.0, lat_avg * 1e3, lat_max * 1e3, lat_n, cpu);
+        g.copy_sum = 0; g.copy_n = 0;
+    }
+}
+
+/* ---- the game process ---------------------------------------------------- */
+
+static void child_exited(void)
+{
+    /* DISPATCH_PROC_EXIT can fire a moment before the child becomes
+     * reapable, so a WNOHANG reap may see nothing and this handler never
+     * runs again: the host then stayed up with its window open after the
+     * game had gone. The child has exited (an exec does not raise EXIT),
+     * so a blocking reap returns at once. */
+    int st = 0;
+    pid_t r;
+    do r = waitpid(g.child, &st, 0); while (r < 0 && errno == EINTR);
+    if (r != g.child) {                     /* already reaped elsewhere: still done */
+        fprintf(stderr, "[host window] pid %d gone (%s)\n", g.child, strerror(errno));
+        exit(g.closing ? 0 : 1);
+    }
+    int code = WIFEXITED(st) ? WEXITSTATUS(st) : WIFSIGNALED(st) ? 128 + WTERMSIG(st) : 1;
+    fprintf(stderr, "[host window] pid %d %s %d\n", g.child,
+            WIFSIGNALED(st) ? "killed by signal" : "exited with", WIFSIGNALED(st) ? WTERMSIG(st) : code);
+    if (g.closing) code = 0;                /* the close was asked for here */
+    g.child = 0;
+    if (g.stats_on) stats_tick();
+    exit(code);
+}
+
+static void begin_close(const char* why)
+{
+    if (g.closing) return;
+    g.closing = 1;
+    fprintf(stderr, "[host window] closing (%s)\n", why);
+    if (g.input.in) hic_focus_lost(&g.input);
+    if (g.ctl) atomic_store(&g.ctl->closed, 1);
+    if (g.child <= 0) exit(0);
+    kill(g.child, SIGTERM);
+    const pid_t pid = g.child;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        if (g.child == pid) {
+            fprintf(stderr, "[host window] pid %d still running; SIGKILL\n", pid);
+            kill(pid, SIGKILL);
+            /* Last resort if the exit notification never reaps it. */
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+                if (g.child == pid) child_exited();
+            });
+        }
+    });
+}
+
+static pid_t spawn_child(char** argv)
+{
+    posix_spawnattr_t attr;
+    posix_spawn_file_actions_t fa;
+    posix_spawnattr_init(&attr);
+    posix_spawn_file_actions_init(&fa);
+    sigset_t def, none;
+    sigemptyset(&def);
+    sigaddset(&def, SIGINT); sigaddset(&def, SIGTERM); sigaddset(&def, SIGHUP); sigaddset(&def, SIGPIPE);
+    sigemptyset(&none);
+    posix_spawnattr_setsigdefault(&attr, &def);
+    posix_spawnattr_setsigmask(&attr, &none);
+    /* stdin/stdout/stderr and nothing else of ours. */
+    posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_CLOEXEC_DEFAULT);
+    for (int fd = 0; fd < 3; fd++) posix_spawn_file_actions_addinherit_np(&fa, fd);
+    pid_t pid = 0;
+    int rc = strchr(argv[0], '/') ? posix_spawn(&pid, argv[0], &fa, &attr, argv, environ)
+                                  : posix_spawnp(&pid, argv[0], &fa, &attr, argv, environ);
+    posix_spawn_file_actions_destroy(&fa);
+    posix_spawnattr_destroy(&attr);
+    if (rc != 0) {
+        fprintf(stderr, "[host window] cannot run %s: %s\n", argv[0], strerror(rc));
+        return -1;
+    }
+    return pid;
+}
+
+/* ---- AppKit -------------------------------------------------------------- */
+
+/* ---- window modes -------------------------------------------------------- */
+
+static int native_fullscreen(void)
+{
+    return g.window && (g.window.styleMask & NSWindowStyleMaskFullScreen) != 0;
+}
+
+static void enter_borderless(void)
+{
+    if (!g.window || g.borderless || native_fullscreen()) return;
+    NSScreen* scr = g.window.screen ? g.window.screen : [NSScreen mainScreen];
+    if (!scr) return;
+    g.saved_frame = g.window.frame;
+    g.saved_style = g.window.styleMask;
+    g.borderless  = 1;
+    [NSApp setPresentationOptions:(NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar)];
+    g.window.styleMask = NSWindowStyleMaskBorderless;
+    [g.window setFrame:scr.frame display:YES];
+    [g.window makeKeyAndOrderFront:nil];
+    keep_drawable();
+}
+
+static void leave_borderless(void)
+{
+    if (!g.window || !g.borderless) return;
+    g.borderless = 0;
+    g.window.styleMask = g.saved_style;
+    [g.window setFrame:g.saved_frame display:YES];
+    [NSApp setPresentationOptions:NSApplicationPresentationDefault];
+    [g.window makeKeyAndOrderFront:nil];
+    keep_drawable();
+}
+
+/* Leave whichever fullscreen is on, else enter the kind asked for. */
+static void toggle_fullscreen(int style)
+{
+    if (!g.window) return;
+    if (g.borderless)          { leave_borderless(); return; }
+    if (native_fullscreen())   { [g.window toggleFullScreen:nil]; return; }
+    if (style == HD_BORDERLESS) enter_borderless();
+    else                        [g.window toggleFullScreen:nil];
+}
+
+/* PS3_DISPLAY: by number (1 = the menu bar's screen) or by name. */
+static NSScreen* pick_screen(void)
+{
+    NSArray<NSScreen*>* screens = [NSScreen screens];
+    NSScreen* fallback = [NSScreen mainScreen];
+    const char* e = getenv("PS3_DISPLAY");
+    if (!e || !*e || !screens.count) return fallback;
+    char* end = NULL;
+    const long k = strtol(e, &end, 10);
+    if (end != e && *end == 0) {
+        if (k >= 1 && k <= (long)screens.count) return screens[(NSUInteger)(k - 1)];
+        fprintf(stderr, "[host window] PS3_DISPLAY=%s: there are %lu screen(s), using the main one\n",
+                e, (unsigned long)screens.count);
+        return fallback;
+    }
+    NSString* want = [NSString stringWithUTF8String:e];
+    for (int pass = 0; want && pass < 3; pass++)
+        for (NSScreen* sc in screens) {
+            NSString* n = sc.localizedName;
+            if (!n) continue;
+            if ((pass == 0 && [n isEqualToString:want]) ||
+                (pass == 1 && [n caseInsensitiveCompare:want] == NSOrderedSame) ||
+                (pass == 2 && [n rangeOfString:want options:NSCaseInsensitiveSearch].location != NSNotFound))
+                return sc;
+        }
+    fprintf(stderr, "[host window] PS3_DISPLAY=%s: no such screen, using the main one. Screens:\n", e);
+    int i = 1;
+    for (NSScreen* sc in screens)
+        fprintf(stderr, "[host window]   %d: %s\n", i++, sc.localizedName ? sc.localizedName.UTF8String : "?");
+    return fallback;
+}
+
+@interface HostWindowDelegate : NSObject <NSApplicationDelegate, NSWindowDelegate>
+@end
+@implementation HostWindowDelegate
+- (void)toggleNativeFullScreen:(id)sender { (void)sender; toggle_fullscreen(HD_FULLSCREEN); }
+- (void)toggleBorderless:(id)sender { (void)sender; toggle_fullscreen(HD_BORDERLESS); }
+- (void)toggleFullScreenStyle:(id)sender { (void)sender; toggle_fullscreen(g.fs_style); }
+- (void)saveScreenshot:(id)sender { (void)sender; request_screenshot(); }
+- (void)windowDidResize:(NSNotification*)note { (void)note; keep_drawable(); }
+- (void)windowDidChangeBackingProperties:(NSNotification*)note { (void)note; keep_drawable(); }
+- (void)windowDidEnterFullScreen:(NSNotification*)note { (void)note; keep_drawable(); }
+- (void)windowDidExitFullScreen:(NSNotification*)note { (void)note; keep_drawable(); }
+- (void)windowDidChangeOcclusionState:(NSNotification*)note
+{
+    (void)note;
+    note_on_screen((g.window.occlusionState & NSWindowOcclusionStateVisible) != 0, CACurrentMediaTime());
+}
+- (NSApplicationTerminateReply)applicationShouldTerminate:(NSApplication*)app
+{
+    (void)app;
+    begin_close("quit");
+    return NSTerminateCancel;               /* exit follows the game's */
+}
+- (void)windowWillClose:(NSNotification*)note
+{
+    (void)note;
+    if (g.borderless) [NSApp setPresentationOptions:NSApplicationPresentationDefault];
+    g.borderless = 0;
+    begin_close("window closed");
+}
+/* No key-up or mouse-up arrives once focus is elsewhere. */
+- (void)windowDidResignKey:(NSNotification*)note { (void)note; hic_focus_lost(&g.input); }
+- (void)applicationDidResignActive:(NSNotification*)note { (void)note; hic_focus_lost(&g.input); }
+@end
+
+static void build_menu(NSString* title, id target)
+{
+    NSMenu* bar = [NSMenu new];
+    NSMenuItem* app_item = [NSMenuItem new];
+    [bar addItem:app_item];
+    NSMenu* app_menu = [NSMenu new];
+    [app_menu addItemWithTitle:[@"Quit " stringByAppendingString:title]
+                        action:@selector(terminate:) keyEquivalent:@"q"];
+    app_item.submenu = app_menu;
+    NSMenuItem* view_item = [NSMenuItem new];
+    [bar addItem:view_item];
+    NSMenu* view_menu = [[NSMenu alloc] initWithTitle:@"View"];
+    NSMenuItem* fs = [view_menu addItemWithTitle:@"Toggle Full Screen"
+                                          action:@selector(toggleNativeFullScreen:) keyEquivalent:@"f"];
+    fs.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagControl;
+    fs.target = target;
+    NSMenuItem* bl = [view_menu addItemWithTitle:@"Toggle Borderless Full Screen"
+                                          action:@selector(toggleBorderless:) keyEquivalent:@"f"];
+    bl.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagOption;
+    bl.target = target;
+    /* Cmd+F: the kind PS3_WINDOW_MODE asked for (macOS's own otherwise) */
+    NSMenuItem* any = [view_menu addItemWithTitle:@"Full Screen"
+                                           action:@selector(toggleFullScreenStyle:) keyEquivalent:@"f"];
+    any.target = target;
+    [view_menu addItem:[NSMenuItem separatorItem]];
+    NSMenuItem* shot = [view_menu addItemWithTitle:@"Save Screenshot"
+                                            action:@selector(saveScreenshot:) keyEquivalent:@"s"];
+    shot.keyEquivalentModifierMask = NSEventModifierFlagCommand | NSEventModifierFlagShift;
+    shot.target = target;
+    view_item.submenu = view_menu;
+    NSApp.mainMenu = bar;
+}
+
+static void make_window(u_int32_t w, u_int32_t h, NSScreen* scr, int vsync)
+{
+    double cw = w, ch = h;
+    if (scr) {
+        const NSRect vis = [NSWindow contentRectForFrameRect:scr.visibleFrame styleMask:NSWindowStyleMaskTitled];
+        hd_shrink_to(vis.size.width, vis.size.height, &cw, &ch);
+    }
+    g.window = [[NSWindow alloc]
+        initWithContentRect:NSMakeRect(0, 0, cw, ch)
+                  styleMask:(NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                             NSWindowStyleMaskMiniaturizable | NSWindowStyleMaskResizable)
+                    backing:NSBackingStoreBuffered
+                      defer:NO];
+    g.window.releasedWhenClosed = NO;
+    g.window.title = g.title;
+    g.window.collectionBehavior |= NSWindowCollectionBehaviorFullScreenPrimary;
+    g.window.acceptsMouseMovedEvents = YES;    /* the mouse camera */
+    g.window.contentMinSize = NSMakeSize(320, 180);
+    g.window.backgroundColor = [NSColor blackColor];
+    [g.window center];
+    /* center goes by the main screen; the middle of the chosen one instead
+     * (fullscreen and borderless then cover that screen). */
+    if (scr && scr != g.window.screen) {
+        const NSRect vf = scr.visibleFrame, wf = g.window.frame;
+        [g.window setFrameOrigin:NSMakePoint(floor(NSMidX(vf) - wf.size.width / 2),
+                                             floor(NSMidY(vf) - wf.size.height / 2))];
+    }
+    g.layer = [CAMetalLayer layer];
+    g.layer.device          = g.dev;
+    g.layer.pixelFormat     = MTLPixelFormatBGRA8Unorm;
+    g.layer.framebufferOnly = NO;           /* a blit destination */
+    g.layer.drawableSize    = CGSizeMake(w, h);
+    /* letterbox: the picture keeps its shape, black bars around it */
+    g.layer.contentsGravity = kCAGravityResizeAspect;
+    g.layer.backgroundColor = CGColorGetConstantColor(kCGColorBlack);
+    g.layer.displaySyncEnabled = vsync ? YES : NO;   /* PS3_VSYNC */
+    NSView* view = g.window.contentView;
+    view.wantsLayer = YES;
+    view.layer = g.layer;
+    view.layerContentsPlacement = NSViewLayerContentsPlacementScaleProportionallyToFit;
+}
+
+static int usage(const char* self)
+{
+    fprintf(stderr, "usage: %s [--title T] [--size WxH] [--] <program> [args...]\n", self);
+    return 2;
+}
+
+int main(int argc, char** argv)
+{
+    @autoreleasepool {
+        const char* title = getenv("PS3_TITLE");
+        if (!title || !*title) title = HOST_WINDOW_TITLE;
+        u_int32_t w = 1280, h = 720;
+        { const char* e = getenv("PS3_WINDOW_SIZE");
+          if (e && *e && !hd_size_from(e, &w, &h))
+              fprintf(stderr, "[host window] PS3_WINDOW_SIZE=%s: expected <width>x<height>\n", e); }
+        int i = 1;
+        for (; i < argc; i++) {
+            if (!strcmp(argv[i], "--")) { i++; break; }
+            if (!strcmp(argv[i], "--title") && i + 1 < argc) { title = argv[++i]; continue; }
+            if (!strcmp(argv[i], "--size") && i + 1 < argc) {
+                if (sscanf(argv[++i], "%ux%u", &w, &h) != 2 || !w || !h ||
+                    w > RSX_HOST_MAX_DIM || h > RSX_HOST_MAX_DIM) return usage(argv[0]);
+                continue;
+            }
+            if (argv[i][0] == '-' && argv[i][1] == '-') return usage(argv[0]);
+            break;
+        }
+        if (i >= argc) return usage(argv[0]);
+        char** child_argv = argv + i;
+
+        mach_timebase_info_data_t tb;
+        mach_timebase_info(&tb);
+        g.tick_to_s = (double)tb.numer / tb.denom / 1e9;
+        const char* e = getenv("PS3RECOMP_METAL_FPS");
+        g.fps_on = e && !strcmp(e, "1");
+        e = getenv("PS3RECOMP_HOST_STATS");
+        g.stats_on = e && *e && *e != '0';
+        g.title = [NSString stringWithUTF8String:title];
+
+        snprintf(g.name, sizeof g.name, "org.ps3recomp.host-window.%d", getpid());
+        kern_return_t kr = bootstrap_check_in(bootstrap_port, g.name, &g.service);
+        g.dev = MTLCreateSystemDefaultDevice();
+        g.queue = [g.dev newCommandQueue];
+        if (kr != KERN_SUCCESS || !g.queue || make_control() != 0) {
+            fprintf(stderr, "[host window] cannot share a window (%s); running %s on its own\n",
+                    kr != KERN_SUCCESS ? bootstrap_strerror(kr) : "no Metal device or memory", child_argv[0]);
+            execvp(child_argv[0], child_argv);
+            fprintf(stderr, "[host window] cannot run %s: %s\n", child_argv[0], strerror(errno));
+            return 127;
+        }
+
+        [NSApplication sharedApplication];
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+        HostWindowDelegate* delegate = [HostWindowDelegate new];
+        NSApp.delegate = delegate;
+        build_menu(g.title, delegate);
+        const int mode = hd_window_mode_from(getenv("PS3_WINDOW_MODE"));
+        g.fs_style = mode == HD_BORDERLESS ? HD_BORDERLESS : HD_FULLSCREEN;
+        g.upscale_on = hd_upscale_from(getenv("PS3_UPSCALE"));
+        g.down_on = hd_downscale_from(getenv("PS3_DOWNSCALE"));
+        g.cas_after = hd_cas_after_from(getenv("PS3_CAS_AFTER"));
+        g.down_linear = hd_downscale_linear_from(getenv("PS3_DOWNSCALE_LINEAR"));
+        make_window(w, h, pick_screen(), hd_vsync_from(getenv("PS3_VSYNC")));
+        g.window.delegate = delegate;
+        if (make_surfaces(w, h) != 0) {
+            fprintf(stderr, "[host window] cannot make %ux%u surfaces\n", w, h);
+            return 1;
+        }
+        cas_setup(g.layer.pixelFormat);
+        /* Presenting is the whole job of this process: keep App Nap off it
+         * even while the window is covered. */
+        id activity = [[NSProcessInfo processInfo]
+            beginActivityWithOptions:NSActivityUserInitiatedAllowingIdleSystemSleep | NSActivityLatencyCritical
+                              reason:@"presenting the game"];
+        (void)activity;
+
+        dispatch_queue_t mq = dispatch_get_main_queue();
+        dispatch_source_t rx = dispatch_source_create(DISPATCH_SOURCE_TYPE_MACH_RECV, g.service, 0, mq);
+        dispatch_source_set_event_handler(rx, ^{ drain_messages(); });
+        dispatch_resume(rx);
+
+        static dispatch_source_t sigs[3];
+        const int signals[3] = { SIGINT, SIGTERM, SIGHUP };
+        for (int s = 0; s < 3; s++) {
+            signal(signals[s], SIG_IGN);
+            sigs[s] = dispatch_source_create(DISPATCH_SOURCE_TYPE_SIGNAL, (uintptr_t)signals[s], 0, mq);
+            const int sig = signals[s];
+            dispatch_source_set_event_handler(sigs[s], ^{ begin_close(strsignal(sig)); });
+            dispatch_resume(sigs[s]);
+        }
+        /* SIGUSR1: a screenshot of the next frame shown (scripts, tests) */
+        signal(SIGUSR1, SIG_IGN);
+        static dispatch_source_t usr1;
+        usr1 = dispatch_source_create(DISPATCH_SOURCE_TYPE_SIGNAL, SIGUSR1, 0, mq);
+        dispatch_source_set_event_handler(usr1, ^{ request_screenshot(); });
+        dispatch_resume(usr1);
+
+        setenv(RSX_HOST_SURFACE_ENV, g.name, 1);
+        g.child = spawn_child(child_argv);
+        if (g.child <= 0) return 127;
+        dispatch_source_t proc = dispatch_source_create(DISPATCH_SOURCE_TYPE_PROC, (uintptr_t)g.child,
+                                                        DISPATCH_PROC_EXIT, mq);
+        dispatch_source_set_event_handler(proc, ^{ child_exited(); });
+        dispatch_resume(proc);
+
+        /* Keys and mouse to the game (ctl->input); a key is swallowed, or
+         * AppKit beeps at every press. */
+        [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskAny handler:^NSEvent*(NSEvent* ev) {
+            return hic_event(&g.input, ev, g.window) ? nil : ev;
+        }];
+        dispatch_source_t input_tick = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, mq);
+        dispatch_source_set_timer(input_tick, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC),
+                                  100 * NSEC_PER_MSEC, 20 * NSEC_PER_MSEC);
+        dispatch_source_set_event_handler(input_tick, ^{ hic_tick(&g.input); });
+        dispatch_resume(input_tick);
+
+        metal_frame_rate_reset(&g.fps, CACurrentMediaTime());
+        dispatch_source_t timer = nil;
+        if (g.fps_on || g.stats_on) {
+            timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, mq);
+            dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
+                                      NSEC_PER_SEC, 50 * NSEC_PER_MSEC);
+            dispatch_source_set_event_handler(timer, ^{ stats_tick(); });
+            dispatch_resume(timer);
+        }
+
+        [g.window makeKeyAndOrderFront:nil];
+        [NSApp activateIgnoringOtherApps:YES];
+        if (mode == HD_BORDERLESS) enter_borderless();
+        else if (mode == HD_FULLSCREEN)        /* it animates: the window has to be up first */
+            dispatch_async(mq, ^{ if (!native_fullscreen()) [g.window toggleFullScreen:nil]; });
+        present_black();
+        fprintf(stderr, "[host window] '%s' pid %d window %ld, game pid %d (%s)\n",
+                title, getpid(), (long)g.window.windowNumber, g.child, g.name);
+        [NSApp run];
+    }
+    return 0;
+}
diff --git a/tools/host_window/test_host_display.c b/tools/host_window/test_host_display.c
new file mode 100644
index 0000000..680a505
--- /dev/null
+++ b/tools/host_window/test_host_display.c
@@ -0,0 +1,53 @@
+/* The window host's display options (host_display.h): PS3_WINDOW_MODE,
+ * PS3_WINDOW_SIZE, PS3_VSYNC, PS3_UPSCALE, and the drawable fitted for
+ * MetalFX upscaling.
+ *
+ *   cc -std=gnu17 -Wall -Wextra tools/host_window/test_host_display.c \
+ *      -o /tmp/test_host_display && /tmp/test_host_display
+ */
+#include "host_display.h"
+#include <assert.h>
+
+int main(void)
+{
+    assert(hd_window_mode_from(NULL) == HD_WINDOWED);
+    assert(hd_window_mode_from("") == HD_WINDOWED);
+    assert(hd_window_mode_from("Windowed") == HD_WINDOWED);
+    assert(hd_window_mode_from("fullscreen") == HD_FULLSCREEN);
+    assert(hd_window_mode_from("native") == HD_FULLSCREEN);
+    assert(hd_window_mode_from("BORDERLESS") == HD_BORDERLESS);
+    assert(hd_window_mode_from("kiosk") == HD_WINDOWED);       /* unknown: windowed, one line */
+
+    assert(hd_vsync_from(NULL) == 1 && hd_vsync_from("1") == 1 && hd_vsync_from("") == 1);
+    assert(hd_vsync_from("0") == 0);
+    assert(hd_vsync_from("00") == 1);                          /* only "0" turns it off */
+
+    assert(hd_upscale_from(NULL) == 0 && hd_upscale_from("off") == 0 && hd_upscale_from("0") == 0);
+    assert(hd_upscale_from("MetalFX") == 1);
+    assert(hd_upscale_from("fsr") == 0);
+
+    unsigned w = 1, h = 1;
+    assert(hd_size_from("1920x1080", &w, &h) && w == 1920 && h == 1080);
+    assert(!hd_size_from("1920x1080x2", &w, &h) && w == 1920);
+    assert(!hd_size_from("10x10", &w, &h));
+    assert(!hd_size_from("wide", &w, &h));
+    assert(!hd_size_from(NULL, &w, &h));
+
+    /* the drawable for MetalFX: the view's pixels fitted to 16:9 */
+    hd_fit(2560, 1440, 1280, 720, &w, &h); assert(w == 2560 && h == 1440);
+    hd_fit(3024, 1964, 1280, 720, &w, &h); assert(w == 3024 && h == 1701);   /* 16:10 screen: bars top and bottom */
+    hd_fit(3440, 1440, 1280, 720, &w, &h); assert(w == 2560 && h == 1440);   /* ultrawide: bars at the sides */
+    hd_fit(1280, 720, 1280, 720, &w, &h);  assert(w == 1280 && h == 720);    /* not larger: no upscale */
+    hd_fit(1000, 2000, 1280, 720, &w, &h); assert(w == 1280 && h == 720);    /* narrower than the source */
+    hd_fit(0, 0, 1280, 720, &w, &h);       assert(w == 1280 && h == 720);
+
+    assert(hd_cas_after_from(NULL) == 1 && hd_cas_after_from("") == 1 && hd_cas_after_from("1") == 1);
+    assert(hd_cas_after_from("0") == 0 && hd_cas_after_from("off") == 0);   /* the rollback */
+
+    double cw = 2560, ch = 1440;
+    hd_shrink_to(1512, 945, &cw, &ch); assert(cw == 1512 && ch == 850);
+    cw = 1280; ch = 720;
+    hd_shrink_to(1512, 945, &cw, &ch); assert(cw == 1280 && ch == 720);
+    printf("test_host_display: ok\n");
+    return 0;
+}
diff --git a/tools/host_window/test_host_window_downscale.m b/tools/host_window/test_host_window_downscale.m
new file mode 100644
index 0000000..611b532
--- /dev/null
+++ b/tools/host_window/test_host_window_downscale.m
@@ -0,0 +1,218 @@
+/* The window host's supersampling path (PS3_DOWNSCALE, host_window.m) with no
+ * window: a picture three times the window's size reduced through
+ * downscale(). A one-pixel checkerboard -- the finest detail a picture holds,
+ * the kind that shimmers on edges -- must come out as an even grey, every
+ * source pixel weighed in; a layer that samples instead (one source pixel per
+ * window pixel) shows black or white. Same sizes reuse the output; a source a
+ * shader may not read turns the path off.
+ *
+ *   clang -fobjc-arc -I libs/video tools/host_window/test_host_window_downscale.m \
+ *         -framework AppKit -framework Metal -framework QuartzCore -framework IOSurface \
+ *         -o /tmp/test_host_window_downscale && /tmp/test_host_window_downscale
+ */
+#define main host_window_main
+#include "host_window.m"
+#undef main
+#include <assert.h>
+
+static id<MTLTexture> checker(NSUInteger w, NSUInteger h, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:w height:h mipmapped:NO];
+    td.usage = usage;
+    td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [g.dev newTextureWithDescriptor:td];
+    uint8_t* px = malloc(w * h * 4);
+    for (NSUInteger y = 0; y < h; y++)
+        for (NSUInteger x = 0; x < w; x++) {
+            uint8_t* p = px + (y * w + x) * 4;
+            const uint8_t v = ((x ^ y) & 1) ? 255 : 0;
+            p[0] = p[1] = p[2] = v; p[3] = 255;
+        }
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        g.dev = MTLCreateSystemDefaultDevice();
+        if (!g.dev) { printf("test_host_window_downscale: no Metal device, skipped\n"); return 0; }
+        g.queue = [g.dev newCommandQueue];
+        g.layer = [CAMetalLayer layer];
+        g.width = 192; g.height = 108;
+        g.down_on = hd_downscale_from(NULL);
+        assert(g.down_on);
+
+        /* no window: the drawable stays the surfaces' size */
+        keep_drawable();
+        assert(g.layer.drawableSize.width == 192 && g.layer.drawableSize.height == 108);
+
+        id<MTLTexture> src = checker(192, 108, MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget);
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        id<MTLTexture> out = downscale(cb, src, 64, 36);
+        if (!out) {
+            assert(!g.down_on);
+            printf("test_host_window_downscale: MetalPerformanceShaders not available here, fallback checked\n");
+            return 0;
+        }
+        assert(out.width == 64 && out.height == 36 && out.storageMode == MTLStorageModePrivate);
+        id<MTLTexture> back = checker(64, 36, MTLTextureUsageShaderRead);
+        id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+        [b copyFromTexture:out toTexture:back];
+        [b endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        assert(cb.status == MTLCommandBufferStatusCompleted);
+        uint8_t* px = malloc(64 * 36 * 4);
+        [back getBytes:px bytesPerRow:64 * 4 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+        int lo = 255, hi = 0;
+        for (int y = 4; y < 32; y++)            /* away from the edges' clamping */
+            for (int x = 4; x < 60; x++) {
+                const int v = px[(y * 64 + x) * 4 + 1];
+                if (v < lo) lo = v;
+                if (v > hi) hi = v;
+            }
+        free(px);
+        printf("test_host_window_downscale: checkerboard 192x108 -> 64x36 gives %d..%d\n", lo, hi);
+        assert(lo > 80 && hi < 175);            /* grey, not black or white pixels */
+
+        /* a solid white picture stays white to the last row and column: the
+         * filter's taps past the edge read the edge (MPSImageEdgeModeClamp),
+         * not black, which left a darker 1-pixel frame */
+        {
+            const NSUInteger W = 192, H = 108, w = 64, h = 36;
+            MTLTextureDescriptor* wd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                          width:W height:H mipmapped:NO];
+            wd.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+            wd.storageMode = MTLStorageModeShared;
+            id<MTLTexture> white = [g.dev newTextureWithDescriptor:wd];
+            uint8_t* wp = malloc(W * H * 4);
+            memset(wp, 255, W * H * 4);
+            [white replaceRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0 withBytes:wp bytesPerRow:W * 4];
+            free(wp);
+            cb = [g.queue commandBuffer];
+            id<MTLTexture> wout = downscale(cb, white, w, h);
+            assert(wout);
+            id<MTLTexture> wback = checker(w, h, MTLTextureUsageShaderRead);
+            b = [cb blitCommandEncoder];
+            [b copyFromTexture:wout toTexture:wback];
+            [b endEncoding];
+            [cb commit];
+            [cb waitUntilCompleted];
+            uint8_t* o = malloc(w * h * 4);
+            [wback getBytes:o bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+            int lo = 255;
+            for (NSUInteger y = 0; y < h; y++)
+                for (NSUInteger x = 0; x < w; x++)
+                    for (int c = 0; c < 3; c++) {
+                        const int v = o[(y * w + x) * 4 + c];
+                        if (v < lo) lo = v;
+                    }
+            free(o);
+            printf("test_host_window_downscale: solid white 192x108 -> 64x36, darkest pixel %d (edges included)\n", lo);
+            assert(lo >= 254);
+            /* back to the checkerboard's size for the reuse check below */
+            cb = [g.queue commandBuffer];
+            out = downscale(cb, src, 64, 36);
+            [cb commit]; [cb waitUntilCompleted];
+        }
+
+        /* the same sizes reuse the output */
+        id<MTLTexture> again = out;
+        cb = [g.queue commandBuffer];
+        assert(downscale(cb, src, 64, 36) == again);
+        [cb commit]; [cb waitUntilCompleted];
+
+        /* the fallback when the reduction cannot run for a frame: the picture
+         * scaled with a linear filter into the target already taken (no
+         * dropped drawable); the checkerboard comes out grey-ish, not black */
+        {
+            MTLTextureDescriptor* fd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                          width:64 height:36 mipmapped:NO];
+            fd.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead; fd.storageMode = MTLStorageModeShared;
+            id<MTLTexture> fdst = [g.dev newTextureWithDescriptor:fd];
+            cb = [g.queue commandBuffer];
+            assert(scaled_copy(cb, src, fdst));
+            [cb commit]; [cb waitUntilCompleted];
+            uint8_t* fo = malloc(64 * 36 * 4);
+            [fdst getBytes:fo bytesPerRow:64 * 4 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+            long sum = 0; for (int i = 0; i < 64 * 36; i++) sum += fo[i * 4 + 1];
+            free(fo);
+            printf("test_host_window_downscale: filtered fallback copy, mean %ld\n", sum / (64 * 36));
+            assert(sum / (64 * 36) > 40 && sum / (64 * 36) < 215);
+        }
+
+        /* straight into a target a shader may write (no copy after); refused
+         * for one it may not, and in linear mode */
+        {
+            MTLTextureDescriptor* dd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                          width:64 height:36 mipmapped:NO];
+            dd.usage = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead; dd.storageMode = MTLStorageModeShared;
+            id<MTLTexture> dw = [g.dev newTextureWithDescriptor:dd];
+            g.direct_checked = 0;
+            cb = [g.queue commandBuffer];
+            assert(downscale_direct(cb, src, dw) == 1);
+            [cb commit]; [cb waitUntilCompleted];
+            uint8_t* o2 = malloc(64 * 36 * 4);
+            [dw getBytes:o2 bytesPerRow:64 * 4 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+            int lo2 = 255, hi2 = 0;
+            for (int y = 4; y < 32; y++) for (int x = 4; x < 60; x++) { const int v = o2[(y * 64 + x) * 4 + 1]; if (v < lo2) lo2 = v; if (v > hi2) hi2 = v; }
+            free(o2);
+            printf("test_host_window_downscale: straight into the target: %d..%d\n", lo2, hi2);
+            assert(lo2 > 80 && hi2 < 175);
+            dd.usage = MTLTextureUsageRenderTarget;
+            id<MTLTexture> dr = [g.dev newTextureWithDescriptor:dd];
+            g.direct_checked = 0;
+            cb = [g.queue commandBuffer];
+            assert(downscale_direct(cb, src, dr) == 0);
+            [cb commit]; [cb waitUntilCompleted];
+            g.direct_checked = 0;
+        }
+
+        /* PS3_DOWNSCALE_LINEAR: thin bright lines on dark keep more of their
+         * brightness than with the gamma-space reduction; white stays white */
+        {
+            const NSUInteger LW = 192, LH = 108;
+            MTLTextureDescriptor* ld = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                          width:LW height:LH mipmapped:NO];
+            ld.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget | MTLTextureUsagePixelFormatView;
+            ld.storageMode = MTLStorageModeShared;
+            id<MTLTexture> lines = [g.dev newTextureWithDescriptor:ld];
+            uint8_t* lp = malloc(LW * LH * 4);
+            for (NSUInteger i = 0; i < LW * LH; i++) { const uint8_t v = (i % LW) % 3 == 0 ? 255 : 10; lp[i*4] = lp[i*4+1] = lp[i*4+2] = v; lp[i*4+3] = 255; }
+            [lines replaceRegion:MTLRegionMake2D(0, 0, LW, LH) mipmapLevel:0 withBytes:lp bytesPerRow:LW * 4];
+            free(lp);
+            long mean[2];
+            for (int lin = 0; lin < 2; lin++) {
+                g.down_linear = lin; g.ds_out = nil; g.ds_out_raw = nil;
+                cb = [g.queue commandBuffer];
+                id<MTLTexture> r = downscale(cb, lines, 64, 36);
+                assert(r && r.pixelFormat == MTLPixelFormatBGRA8Unorm);
+                id<MTLTexture> rb = checker(64, 36, MTLTextureUsageShaderRead);
+                id<MTLBlitCommandEncoder> lb = [cb blitCommandEncoder]; [lb copyFromTexture:r toTexture:rb]; [lb endEncoding];
+                [cb commit]; [cb waitUntilCompleted];
+                uint8_t* ro = malloc(64 * 36 * 4);
+                [rb getBytes:ro bytesPerRow:64 * 4 fromRegion:MTLRegionMake2D(0, 0, 64, 36) mipmapLevel:0];
+                long sm = 0; for (int i = 0; i < 64 * 36; i++) sm += ro[i * 4 + 1];
+                free(ro); mean[lin] = sm / (64 * 36);
+            }
+            printf("test_host_window_downscale: 1-in-3 bright lines, mean %ld (gamma) vs %ld (linear light)\n", mean[0], mean[1]);
+            assert(mean[1] > mean[0] + 20);
+            g.down_linear = 0; g.ds_out = nil; g.ds_out_raw = nil;
+            cb = [g.queue commandBuffer];
+            out = downscale(cb, src, 64, 36);
+            [cb commit]; [cb waitUntilCompleted];
+        }
+
+        /* a source a shader may not read: it gives up, presents plain */
+        id<MTLTexture> bad = checker(192, 108, MTLTextureUsageRenderTarget);
+        cb = [g.queue commandBuffer];
+        assert(downscale(cb, bad, 64, 36) == nil);
+        assert(!g.down_on && g.ds_kernel == nil);
+        assert(g.layer.drawableSize.width == 192 && g.layer.drawableSize.height == 108);
+        printf("test_host_window_downscale: ok\n");
+    }
+    return 0;
+}
diff --git a/tools/host_window/test_host_window_offscreen.m b/tools/host_window/test_host_window_offscreen.m
new file mode 100644
index 0000000..d09d222
--- /dev/null
+++ b/tools/host_window/test_host_window_offscreen.m
@@ -0,0 +1,112 @@
+/* The window host off screen (host_window.m, "Off screen"): a window macOS
+ * does not show (another app or Space in front, minimized, covered) logs
+ * that it left and came back, its [RSX FPS] lines carry hidden=1 meanwhile,
+ * and coming back shows the newest frame the game published while it was
+ * away. No window: the layer is a bare CAMetalLayer.
+ *
+ *   clang -fobjc-arc -I libs/video tools/host_window/test_host_window_offscreen.m \
+ *         -framework AppKit -framework Metal -framework QuartzCore -framework IOSurface \
+ *         -o /tmp/test_host_window_offscreen && /tmp/test_host_window_offscreen
+ */
+#define main host_window_main
+#include "host_window.m"
+#undef main
+#include <assert.h>
+
+/* stderr into a file for the duration of fn; returns what was written */
+static char* capture(void (^fn)(void))
+{
+    char path[] = "/tmp/test_host_window_offscreen.XXXXXX";
+    const int fd = mkstemp(path);
+    assert(fd >= 0);
+    fflush(stderr);
+    const int saved = dup(2);
+    dup2(fd, 2);
+    fn();
+    fflush(stderr);
+    dup2(saved, 2);
+    close(saved);
+    const off_t n = lseek(fd, 0, SEEK_END);
+    char* out = calloc(1, (size_t)n + 1);
+    pread(fd, out, (size_t)n, 0);
+    close(fd);
+    unlink(path);
+    return out;
+}
+
+static int count(const char* s, const char* what)
+{
+    int n = 0;
+    for (const char* p = s; (p = strstr(p, what)); p += strlen(what)) n++;
+    return n;
+}
+
+/* what the game does for a finished frame */
+static uint64_t publish(void)
+{
+    const int slot = rsx_host_begin_render(g.ctl);
+    assert(slot >= 0);
+    rsx_host_end_render(g.ctl, slot, 1, mach_absolute_time());
+    return atomic_load(&g.ctl->seq[slot]);
+}
+
+/* the copy's completion comes back on the main queue */
+static void settle(void)
+{
+    for (int i = 0; i < 500 && g.present_busy; i++)
+        [[NSRunLoop currentRunLoop] runMode:NSDefaultRunLoopMode
+                                 beforeDate:[NSDate dateWithTimeIntervalSinceNow:0.01]];
+    assert(!g.present_busy);
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        g.dev = MTLCreateSystemDefaultDevice();
+        if (!g.dev) { printf("test_host_window_offscreen: no Metal device, skipped\n"); return 0; }
+        g.queue = [g.dev newCommandQueue];
+        g.layer = [CAMetalLayer layer];
+        g.layer.device = g.dev;
+        g.layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+        g.layer.framebufferOnly = NO;
+        assert(make_control() == 0 && make_surfaces(64, 36) == 0);
+        g.fps_on = 1;
+        metal_frame_rate_reset(&g.fps, CACurrentMediaTime());
+
+        /* on screen: a frame goes up, and the rate line is plain */
+        const uint64_t first = publish();
+        try_present();
+        settle();
+        assert(g.shown_seq == first);
+        char* line = capture(^{ stats_tick(); });
+        assert(strstr(line, "[RSX FPS] display=") && !strstr(line, "hidden"));
+        free(line);
+
+        /* off screen: said once, and every rate line says hidden=1 */
+        line = capture(^{ note_on_screen(0, 100.0); note_on_screen(0, 101.0); });
+        assert(count(line, "[host window] window off screen") == 1);
+        free(line);
+        assert(g.off_screen);
+        line = capture(^{ stats_tick(); });
+        assert(strstr(line, "[RSX FPS] display=") && strstr(line, " hidden=1\n"));
+        free(line);
+
+        /* the game goes on meanwhile; back on screen, the newest of its
+         * frames goes up at once, with how long the window was away */
+        settle();
+        publish();
+        const uint64_t newest = publish();
+        line = capture(^{ note_on_screen(1, 127.5); });
+        assert(strstr(line, "[host window] window on screen again after 27.5 s"));
+        free(line);
+        assert(!g.off_screen);
+        assert(g.present_busy);                 /* presented by the change itself */
+        settle();
+        assert(g.shown_seq == newest);
+        line = capture(^{ note_on_screen(1, 130.0); stats_tick(); });
+        assert(!strstr(line, "on screen again") && !strstr(line, "hidden"));
+        free(line);
+        printf("test_host_window_offscreen: ok\n");
+    }
+    return 0;
+}
diff --git a/tools/host_window/test_host_window_sharpen.m b/tools/host_window/test_host_window_sharpen.m
new file mode 100644
index 0000000..ca96dc4
--- /dev/null
+++ b/tools/host_window/test_host_window_sharpen.m
@@ -0,0 +1,120 @@
+/* The window host's sharpening after the reduction (PS3_CAS_AFTER,
+ * host_window.m cas_setup / cas_into) with no window: the pipeline is made
+ * and says so in the control page (sharpen_caps); a frame sharpened into a
+ * target matches the game's CAS formula (rsx_metal_backend.m eng_present_fs)
+ * computed here on the CPU, to within one level; a flat picture comes out
+ * unchanged; and PS3_CAS_AFTER=0 makes nothing and tells the game so.
+ *
+ *   clang -fobjc-arc -I libs/video tools/host_window/test_host_window_sharpen.m \
+ *         -framework AppKit -framework Metal -framework QuartzCore -framework IOSurface \
+ *         -o /tmp/test_host_window_sharpen && /tmp/test_host_window_sharpen
+ */
+#define main host_window_main
+#include "host_window.m"
+#undef main
+#include <assert.h>
+
+enum { W = 32, H = 24 };
+
+static id<MTLTexture> picture(const uint8_t* bgra, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:W height:H mipmapped:NO];
+    td.usage = usage;
+    td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [g.dev newTextureWithDescriptor:td];
+    if (bgra) [t replaceRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0 withBytes:bgra bytesPerRow:W * 4];
+    return t;
+}
+
+/* The game's CAS on one channel at (x, y), clamped at the edges as the
+ * nearest-clamp sampler is. */
+static float ref(const uint8_t* px, int x, int y, int c, float sharp)
+{
+#define P(dx, dy) (px[((size_t)(y + (dy) < 0 ? 0 : y + (dy) >= H ? H - 1 : y + (dy)) * W + \
+                       (size_t)(x + (dx) < 0 ? 0 : x + (dx) >= W ? W - 1 : x + (dx))) * 4 + c] / 255.0f)
+    const float a = P(-1, -1), b = P(0, -1), cc = P(1, -1), l = P(-1, 0), e = P(0, 0), r = P(1, 0),
+                g_ = P(-1, 1), h = P(0, 1), k = P(1, 1);
+#undef P
+    float mn = fminf(fminf(fminf(l, e), fminf(r, b)), h); mn += fminf(mn, fminf(fminf(a, cc), fminf(g_, k)));
+    float mx = fmaxf(fmaxf(fmaxf(l, e), fmaxf(r, b)), h); mx += fmaxf(mx, fmaxf(fmaxf(a, cc), fmaxf(g_, k)));
+    float q = fminf(mn, 2.0f - mx) / fmaxf(mx, 1e-5f);
+    q = q < 0 ? 0 : q > 1 ? 1 : q;
+    const float w = sqrtf(q) * (-1.0f / (8.0f + (5.0f - 8.0f) * sharp));
+    float o = (b * w + l * w + r * w + h * w + e) / (1.0f + 4.0f * w);
+    return o < 0 ? 0 : o > 1 ? 1 : o;
+}
+
+static void run(id<MTLTexture> src, id<MTLTexture> dst, float sharp, uint8_t* out)
+{
+    id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+    assert(cas_into(cb, src, dst, sharp));
+    [cb commit];
+    [cb waitUntilCompleted];
+    assert(cb.status == MTLCommandBufferStatusCompleted);
+    [dst getBytes:out bytesPerRow:W * 4 fromRegion:MTLRegionMake2D(0, 0, W, H) mipmapLevel:0];
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        g.dev = MTLCreateSystemDefaultDevice();
+        if (!g.dev) { printf("test_host_window_sharpen: no Metal device, skipped\n"); return 0; }
+        g.queue = [g.dev newCommandQueue];
+        rsx_host_control* ctl = calloc(1, RSX_HOST_CONTROL_BYTES);
+        g.ctl = ctl;
+
+        /* PS3_CAS_AFTER=0: no pipeline, and the game is told nothing */
+        g.cas_after = hd_cas_after_from("0");
+        cas_setup(MTLPixelFormatBGRA8Unorm);
+        assert(!g.cas_pso && atomic_load(&ctl->sharpen_caps) == 0);
+
+        /* default: made, and the game may leave sharpening to the window */
+        g.cas_after = hd_cas_after_from(NULL);
+        cas_setup(MTLPixelFormatBGRA8Unorm);
+        assert(g.cas_pso && atomic_load(&ctl->sharpen_caps) == 1);
+
+        /* a soft step and a ramp: what CAS works on */
+        uint8_t* px = malloc(W * H * 4);
+        for (int y = 0; y < H; y++)
+            for (int x = 0; x < W; x++) {
+                uint8_t* p = px + ((size_t)y * W + x) * 4;
+                p[0] = (uint8_t)(x < 14 ? 40 : x < 18 ? 40 + (x - 13) * 35 : 200);   /* B: a soft step */
+                p[1] = (uint8_t)(20 + y * 8);                                         /* G: a ramp */
+                p[2] = (uint8_t)(((x / 3) + (y / 3)) & 1 ? 180 : 70);                 /* R: 3x3 blocks */
+                p[3] = 255;
+            }
+        id<MTLTexture> src = picture(px, MTLTextureUsageShaderRead);
+        id<MTLTexture> dst = picture(NULL, MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead);
+        uint8_t* out = malloc(W * H * 4);
+        run(src, dst, 0.35f, out);
+        int worst = 0, changed = 0;
+        for (int y = 0; y < H; y++)
+            for (int x = 0; x < W; x++)
+                for (int c = 0; c < 3; c++) {
+                    const int want = (int)lroundf(ref(px, x, y, c, 0.35f) * 255.0f);
+                    const int got = out[((size_t)y * W + x) * 4 + c];
+                    if (abs(want - got) > worst) worst = abs(want - got);
+                    if (got != px[((size_t)y * W + x) * 4 + c]) changed++;
+                }
+        printf("test_host_window_sharpen: CAS 0.35 vs the game's formula: worst difference %d level(s), %d values sharpened\n",
+               worst, changed);
+        assert(worst <= 1 && changed > 0);
+
+        /* a flat picture: nothing to sharpen */
+        memset(px, 128, W * H * 4);
+        src = picture(px, MTLTextureUsageShaderRead);
+        run(src, dst, 1.0f, out);
+        for (int i = 0; i < W * H * 4; i++) if ((i & 3) != 3) assert(abs(out[i] - 128) <= 1);
+
+        /* a size mismatch is refused: the caller copies instead */
+        MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                      width:W / 2 height:H / 2 mipmapped:NO];
+        td.usage = MTLTextureUsageRenderTarget;
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        assert(!cas_into(cb, src, [g.dev newTextureWithDescriptor:td], 0.35f));
+        free(px); free(out); free(ctl);
+        printf("test_host_window_sharpen: ok\n");
+    }
+    return 0;
+}
diff --git a/tools/host_window/test_host_window_upscale.m b/tools/host_window/test_host_window_upscale.m
new file mode 100644
index 0000000..b5941e6
--- /dev/null
+++ b/tools/host_window/test_host_window_upscale.m
@@ -0,0 +1,89 @@
+/* The window host's MetalFX path (PS3_UPSCALE=metalfx, host_window.m) with
+ * no window: a surface-sized frame through upscale() to a larger size, the
+ * fallback when the source cannot be read, and the drawable staying at the
+ * surfaces' size without it.
+ *
+ *   clang -fobjc-arc -I libs/video tools/host_window/test_host_window_upscale.m \
+ *         -framework AppKit -framework Metal -framework QuartzCore -framework IOSurface \
+ *         -o /tmp/test_host_window_upscale && /tmp/test_host_window_upscale
+ */
+#define main host_window_main
+#include "host_window.m"
+#undef main
+#include <assert.h>
+
+static id<MTLTexture> frame(NSUInteger w, NSUInteger h, MTLTextureUsage usage)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:w height:h mipmapped:NO];
+    td.usage = usage;
+    td.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [g.dev newTextureWithDescriptor:td];
+    uint8_t* px = malloc(w * h * 4);
+    for (NSUInteger y = 0; y < h; y++)
+        for (NSUInteger x = 0; x < w; x++) {
+            uint8_t* p = px + (y * w + x) * 4;
+            p[0] = (uint8_t)(x * 255 / (w - 1)); p[1] = (uint8_t)(y * 255 / (h - 1)); p[2] = 128; p[3] = 255;
+        }
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        g.dev = MTLCreateSystemDefaultDevice();
+        if (!g.dev) { printf("test_host_window_upscale: no Metal device, skipped\n"); return 0; }
+        g.queue = [g.dev newCommandQueue];
+        g.layer = [CAMetalLayer layer];
+        g.width = 64; g.height = 36;
+
+        /* without PS3_UPSCALE the drawable is the surfaces' size */
+        g.upscale_on = 0;
+        keep_drawable();
+        assert(g.layer.drawableSize.width == 64 && g.layer.drawableSize.height == 36);
+
+        g.upscale_on = 1;
+        id<MTLTexture> src = frame(64, 36, MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget);
+        id<MTLCommandBuffer> cb = [g.queue commandBuffer];
+        id<MTLTexture> out = upscale(cb, src, 128, 72);
+        if (!out) {
+            /* MetalFX missing on this machine: the path turns itself off */
+            assert(!g.upscale_on);
+            printf("test_host_window_upscale: MetalFX not available here, fallback checked\n");
+            return 0;
+        }
+        assert(out.width == 128 && out.height == 72 && out.storageMode == MTLStorageModePrivate);
+        /* read it back through a shared copy, as the window's blit would */
+        id<MTLTexture> back = frame(128, 72, MTLTextureUsageShaderRead);
+        id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+        [b copyFromTexture:out toTexture:back];
+        [b endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];

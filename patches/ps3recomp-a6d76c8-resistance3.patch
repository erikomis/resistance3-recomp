+     * images, and a texture's bytes may be inside the moved block. */
+    for (u32 i = 0; i < g.n_textures; i++) {
+        eng_texture* e = &g.textures[i];
+        if (e->location != location || !eng_ranges_overlap(offset, bytes, e->offset, e->span))
+            continue;
+        e->last_hash_frame = g.frames - 1u;
+        e->last_full_frame = g.frames - ENG_TEXHASH_FULL_EVERY;
+        e->full_shift = 0;
+    }
+    /* A surface the range lands in: the rows it covers now hold the guest's
+     * bytes, pushed into the host target as a 2D transfer's would be. */
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        eng_surface* s = &g.surfaces[i];
+        const u32 len = eng_surface_guest_bytes(s);

+/* What waits in s_pa_pend into a new chunk. `compact`: it is everything the
+ * prewarm rebuilt, and written whole it replaces every older chunk. */
+static void pa_save(int compact)
+{
+    if (!s_pa_pend || !s_pa_pend.count) return;
+    if (@available(macOS 11.0, *)) {
+        NSArray<MTLRenderPipelineDescriptor*>* descs = s_pa_pend;
+        NSArray<NSNumber*>* keys = s_pa_pend_key;
+        s_pa_pend = [NSMutableArray new];
+        s_pa_pend_key = [NSMutableArray new];
+        if (s_pa_bytes >= s_pa_max_bytes && !compact) {
+            static int logged;
+            if (!logged++)
+                fprintf(stderr, "[pipeline cache] archive is %.0f MB, its limit (PS3_PIPELINE_ARCHIVE_MAX_MB):"
+                                " new pipelines are recorded but their binaries are not kept\n",
+                        (double)s_pa_bytes / 1048576.0);
+            return;
+        }
+        const uint64_t t0 = ps3_ft_now();
+        NSArray<NSString*>* older = compact ? [s_pa_files copy] : nil;
+        const uint64_t before = s_pa_bytes;
+        u32 written = 0;
+        const int whole = pa_write_chunk(descs, keys, 0, descs.count, &written);
+        if (compact && whole) {
+            for (NSString* f in older) {
+                s_pa_bytes -= pa_file_size([f UTF8String]);
+                unlink([f UTF8String]);
+                [s_pa_files removeObject:f];
+            }
+        }
+        __atomic_add_fetch(&s_pa_added, written, __ATOMIC_RELAXED);
+        fprintf(stderr, "[pipeline cache] archive saved: %u of %u binaries in %.0f ms%s; %u file(s), %.1f MB (was %.1f)\n",
+                written, (unsigned)descs.count, (double)(ps3_ft_now() - t0) / 1e6,
+                compact ? (whole ? ", all chunks merged into one" : ", merge incomplete: older chunks kept") : "",
+                (unsigned)s_pa_files.count, (double)s_pa_bytes / 1048576.0, (double)before / 1048576.0);
+    }
+}

+            const char* needle = needles[nidx];
+            const u32 nlen = (u32)strlen(needle);
+            for (;;) {
+                char* at = strstr(hlsl, needle);
+                if (!at) break;
+                char* open = at + nlen - 1;
+                while (open > at && *open != '(') open--;
+                if (*open != '(') break;
+                int depth = 0;
+                char* p = open;
+                for (; *p; p++) {
+                    if (*p == '(') depth++;
+                    else if (*p == ')') { depth--; if (!depth) break; }
+                }
+                if (*p != ')') break;
+                char scale[48];
+                snprintf(scale, sizeof scale, " * fp_unnorm[%u].%s", u,
+                         ((vol_mask >> u) & 1u) ? "xyz" : "xy");

diff --git a/libs/video/tests/test_metal_host_surface.m b/libs/video/tests/test_metal_host_surface.m
new file mode 100644
index 0000000..eb47420
--- /dev/null
+++ b/libs/video/tests/test_metal_host_surface.m
@@ -0,0 +1,265 @@
+/* clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_host_surface.m
+ * libs/video/rsx_texture_layout.c libs/video/rsx_vertex_fetch.c libs/video/rsx_vp_decompiler.c
+ * libs/video/rsx_fp_decompiler.c libs/video/rsx_shader_msl.cpp -lc++ -Wl,-dead_strip
+ * -framework Metal -framework Cocoa -framework QuartzCore -framework IOSurface
+ * -o /tmp/test_metal_host_surface
+ *
+ * Host-surface mode (PS3RECOMP_HOST_SURFACES, rsx_host_surface.h) against a
+ * launcher fixture in this process: a bootstrap service on a thread that
+ * hands out a control page and IOSurfaces the way tools/host_window does.
+ *   - the surface state machine on its own (take, publish, reclaim, read);
+ *   - init attaches and opens no window; an engine present lands in a
+ *     surface, is published with a FRAME message, and reads back right;
+ *   - presents nobody reads never stall: old frames are reclaimed;
+ *   - the vtable path renders into the surface, and a display resize asks
+ *     the launcher for surfaces of the new size;
+ *   - `closed` makes the pump report the window gone;
+ *   - a second init (the image an exec brings up) attaches again, frames the
+ *     old image left RENDERING are freed, and the sequence keeps rising;
+ *   - export_window_state hands nothing over. */
+#include "../rsx_metal_backend.m"
+#include <IOSurface/IOSurface.h>
+#include <assert.h>
+
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+void rsx_set_backend(rsx_backend* b) { (void)b; }
+void rsx_state_shadow_enable(int on) { (void)on; }
+void rsx_draw_engine_set_backend(const rsx_draw_backend* b) { (void)b; }
+void rsx_draw_engine_set_default(int on) { (void)on; }
+int  rsx_draw_engine_enabled(void) { return 1; }
+int  rsx_draw_engine_init(u32 w, u32 h) { return eng_init(NULL, w, h); }
+void rsx_draw_engine_shutdown(void) { eng_shutdown(NULL); }
+void rsx_draw_engine_present(void) {}
+u32  rsx_draw_engine_readback_center(void) { return 0; }
+u32  rsx_draw_engine_guest_draws(void) { return 0; }
+int  cellGcmOffsetIsDisplay(u32 off) { (void)off; return 1; }
+/* The vtable path is linked in; no draw reaches guest memory here. */
+u32  cellGcmResolveLocated(int location, u32 offset) { (void)location; return offset; }
+u32  cellGcmResolveOffset(u32 offset) { return offset; }
+u8*  vm_base;
+
+/* ---- the launcher fixture ------------------------------------------------ */
+
+static mach_port_t       f_service, f_entry;
+static rsx_host_control* f_ctl;
+static IOSurfaceRef      f_surf[RSX_HOST_SLOTS];
+static u32               f_w, f_h;
+static atomic_int        f_frames, f_attaches;
+
+static void f_make_surfaces(u32 w, u32 h)
+{
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+        if (f_surf[i]) CFRelease(f_surf[i]);
+        NSDictionary* p = @{ (id)kIOSurfaceWidth: @(w), (id)kIOSurfaceHeight: @(h),
+                             (id)kIOSurfaceBytesPerElement: @4,
+                             (id)kIOSurfacePixelFormat: @((u32)'BGRA') };
+        f_surf[i] = IOSurfaceCreate((__bridge CFDictionaryRef)p);
+        assert(f_surf[i]);
+        if (atomic_load(&f_ctl->state[i]) != RSX_HOST_READING)
+            atomic_store(&f_ctl->state[i], RSX_HOST_FREE);
+    }
+    f_w = w; f_h = h;
+    f_ctl->width = w; f_ctl->height = h;
+    f_ctl->generation++;
+}
+
+static void* f_thread(void* unused)
+{
+    (void)unused;
+    for (;;) {
+        struct { rsx_host_attach_msg m; mach_msg_trailer_t t; } in;
+        memset(&in, 0, sizeof in);
+        if (mach_msg(&in.m.header, MACH_RCV_MSG, 0, sizeof in, f_service, 0, MACH_PORT_NULL))
+            continue;
+        if (in.m.header.msgh_id == RSX_HOST_MSG_FRAME) { atomic_fetch_add(&f_frames, 1); continue; }
+        assert(in.m.header.msgh_id == RSX_HOST_MSG_ATTACH);
+        assert(in.m.pid == getpid());
+        if (in.m.width && (in.m.width != f_w || in.m.height != f_h)) f_make_surfaces(in.m.width, in.m.height);
+        else rsx_host_reset_rendering(f_ctl);
+        rsx_host_surfaces_msg r;
+        memset(&r, 0, sizeof r);
+        r.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_MOVE_SEND_ONCE, 0) | MACH_MSGH_BITS_COMPLEX;
+        r.header.msgh_size = sizeof r;
+        r.header.msgh_remote_port = in.m.header.msgh_remote_port;
+        r.header.msgh_id = RSX_HOST_MSG_SURFACES;
+        r.body.msgh_descriptor_count = 1 + RSX_HOST_SLOTS;
+        r.control.name = f_entry; r.control.disposition = MACH_MSG_TYPE_COPY_SEND;
+        r.control.type = MACH_MSG_PORT_DESCRIPTOR;
+        for (int i = 0; i < RSX_HOST_SLOTS; i++) {
+            r.surface[i].name = IOSurfaceCreateMachPort(f_surf[i]);
+            r.surface[i].disposition = MACH_MSG_TYPE_MOVE_SEND;
+            r.surface[i].type = MACH_MSG_PORT_DESCRIPTOR;
+        }
+        r.width = f_w; r.height = f_h; r.generation = f_ctl->generation; r.launcher_pid = getpid();
+        assert(mach_msg(&r.header, MACH_SEND_MSG, sizeof r, 0, MACH_PORT_NULL, 0, MACH_PORT_NULL) == KERN_SUCCESS);
+        atomic_fetch_add(&f_attaches, 1);
+    }
+    return NULL;
+}
+
+static void f_start(void)
+{
+    char name[128];
+    snprintf(name, sizeof name, "org.ps3recomp.test-host-surface.%d", getpid());
+    assert(bootstrap_check_in(bootstrap_port, name, &f_service) == KERN_SUCCESS);
+    vm_address_t a = 0;
+    assert(vm_allocate(mach_task_self(), &a, RSX_HOST_CONTROL_BYTES, VM_FLAGS_ANYWHERE) == KERN_SUCCESS);
+    memory_object_size_t sz = RSX_HOST_CONTROL_BYTES;
+    assert(mach_make_memory_entry_64(mach_task_self(), &sz, a, VM_PROT_READ | VM_PROT_WRITE,
+                                     &f_entry, MACH_PORT_NULL) == KERN_SUCCESS);
+    f_ctl = (rsx_host_control*)a;
+    f_ctl->magic = RSX_HOST_MAGIC; f_ctl->version = RSX_HOST_VERSION; f_ctl->launcher_pid = getpid();
+    f_make_surfaces(64, 32);
+    pthread_t t;
+    assert(pthread_create(&t, NULL, f_thread, NULL) == 0);
+    setenv(RSX_HOST_SURFACE_ENV, name, 1);
+}
+
+/* Wait until `n` frames are published (a FRAME wake may be dropped when the
+ * queue is full, so count publishes, not messages), then take the newest
+ * frame as the launcher would and return its centre pixel (BGRA, as a
+ * little-endian u32). */
+static u32 f_read_newest(int n, uint64_t* seq_out)
+{
+    for (int i = 0; i < 400 && atomic_load(&f_ctl->published) < (uint64_t)n; i++) usleep(5000);
+    assert(atomic_load(&f_ctl->published) >= (uint64_t)n);
+    for (int i = 0; i < 400 && atomic_load(&f_frames) == 0; i++) usleep(5000);
+    assert(atomic_load(&f_frames) > 0);
+    static uint64_t shown;
+    uint64_t seq = 0;
+    const int slot = rsx_host_begin_read(f_ctl, shown, &seq);
+    assert(slot >= 0 && seq > shown);
+    shown = seq;
+    IOSurfaceRef s = f_surf[slot];
+    IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL);
+    const u8* base = IOSurfaceGetBaseAddress(s);
+    u32 px;
+    memcpy(&px, base + (f_h / 2) * IOSurfaceGetBytesPerRow(s) + (f_w / 2) * 4, 4);
+    IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+    rsx_host_end_read(f_ctl, slot);
+    if (seq_out) *seq_out = seq;
+    return px;
+}
+
+static id<MTLTexture> solid(u32 w, u32 h, u32 bgra)
+{
+    MTLTextureDescriptor* d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm
+                                                                                  width:w height:h mipmapped:NO];
+    d.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+    d.storageMode = MTLStorageModeShared;
+    id<MTLTexture> t = [s_dev newTextureWithDescriptor:d];
+    u32* px = malloc((size_t)w * h * 4);
+    for (u32 i = 0; i < w * h; i++) px[i] = bgra;
+    [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4];
+    free(px);
+    return t;
+}
+
+/* ---- the state machine alone --------------------------------------------- */
+
+static void check_states(void)
+{
+    static rsx_host_control c;
+    memset(&c, 0, sizeof c);
+    int r[RSX_HOST_SLOTS];
+    for (int i = 0; i < RSX_HOST_SLOTS; i++) { r[i] = rsx_host_begin_render(&c); assert(r[i] == i); }
+    assert(rsx_host_begin_render(&c) == -1 && c.skipped == 1);      /* all rendering */
+    rsx_host_end_render(&c, r[0], 1, 1);
+    rsx_host_end_render(&c, r[1], 1, 2);
+    rsx_host_end_render(&c, r[2], 0, 3);                            /* failed frame: back to FREE */
+    assert(c.state[2] == RSX_HOST_FREE && c.published == 2);
+    assert(rsx_host_begin_render(&c) == 2);
+    assert(rsx_host_begin_render(&c) == 0 && c.reclaimed == 1);     /* oldest READY taken back */
+    uint64_t q = 0;
+    assert(rsx_host_begin_read(&c, 0, &q) == 1 && q == c.seq[1]);
+    assert(rsx_host_begin_read(&c, q, &q) == -1);                   /* nothing newer */
+    rsx_host_end_read(&c, 1);
+    assert(c.state[1] == RSX_HOST_FREE);
+    /* Several READY: the newest is read and the older ones are freed. */
+    memset(&c, 0, sizeof c);
+    for (int i = 0; i < 3; i++) { assert(rsx_host_begin_render(&c) == i); }
+    for (int i = 0; i < 3; i++) rsx_host_end_render(&c, i, 1, 10 + i);
+    assert(rsx_host_begin_read(&c, 0, &q) == 2 && q == 3);
+    assert(c.state[0] == RSX_HOST_FREE && c.state[1] == RSX_HOST_FREE && c.state[2] == RSX_HOST_READING);
+    /* A reader never takes a frame at or below the one it last showed. */
+    rsx_host_end_read(&c, 2);
+    assert(rsx_host_begin_render(&c) == 0);
+    atomic_store(&c.seq[0], 2); atomic_store(&c.state[0], RSX_HOST_READY);
+    assert(rsx_host_begin_read(&c, 3, &q) == -1);
+    rsx_host_reset_rendering(&c);
+    puts("state machine: ok");
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        check_states();
+        f_start();
+
+        assert(rsx_metal_backend_init(64, 32, "test") == 0);
+        assert(s_host && !s_headless && s_window == nil && NSApp == nil);
+        assert(s_host_w == 64 && s_host_h == 32 && s_eng_active);
+        assert(atomic_load(&f_ctl->producer_pid) == getpid());
+
+        /* Engine present: the source lands in a host surface. */
+        eng_encode_and_commit(solid(64, 32, 0xFF3366CCu));
+        assert(f_read_newest(1, NULL) == 0xFF3366CCu);
+        puts("engine present: ok");
+
+        /* Nobody reading: no stall, older frames reclaimed. */
+        id<MTLTexture> red = solid(64, 32, 0xFFFF0000u);
+        for (int i = 0; i < 40; i++) eng_encode_and_commit(red);
+        host_drain();
+        assert(atomic_load(&f_ctl->published) == 41 && atomic_load(&f_ctl->skipped) == 0);
+        assert(atomic_load(&f_ctl->reclaimed) > 0);
+        uint64_t seq1 = 0;
+        assert(f_read_newest(41, &seq1) == 0xFFFF0000u && seq1 == 41);
+        printf("40 unread presents: published 41, reclaimed %llu\n",
+               (unsigned long long)atomic_load(&f_ctl->reclaimed));
+
+        /* Guest frames reach the launcher's counter. */
+        rsx_metal_backend_note_guest_frame();
+        assert(atomic_load(&f_ctl->guest_frames) == 1);
+
+        /* The vtable path: the frame's first pass clears to the guest colour,
+         * straight into the surface. Then a display resize. */
+        s_eng_active = 0;
+        s_clear_argb = 0xFF00FF00u;
+        rsx_metal_backend_present();
+        assert(f_read_newest(42, NULL) == 0xFF00FF00u);
+        s_width = 128; s_height = 64;
+        assert(create_depth() == 0);
+        rsx_metal_backend_present();
+        assert(s_host_w == 128 && s_host_h == 64 && f_w == 128 && f_ctl->generation == 2);
+        assert(f_read_newest(43, NULL) == 0xFF00FF00u);
+        puts("vtable present and resize: ok");
+
+        /* The launcher closing its window. */
+        assert(rsx_metal_backend_pump_messages() == 0);
+        atomic_store(&f_ctl->closed, 1);
+        rsx_metal_backend_present();
+        assert(rsx_metal_backend_pump_messages() == -1);
+        atomic_store(&f_ctl->closed, 0);
+        puts("closed -> pump -1: ok");
+
+        /* What an exec brings up: shutdown (the old image is gone), a frame
+         * it left RENDERING, a fresh init that attaches again. */
+        rsx_metal_backend_export_window_state();
+        assert(getenv("PS3RECOMP_WINDOW_STATE") == NULL);
+        rsx_metal_backend_shutdown();
+        assert(!s_host && !s_host_ctl);
+        assert(rsx_host_begin_render(f_ctl) >= 0);          /* left behind */
+        const int before = atomic_load(&f_attaches);
+        assert(rsx_metal_backend_init(128, 64, "test") == 0);
+        assert(s_host && atomic_load(&f_attaches) == before + 1);
+        for (int i = 0; i < RSX_HOST_SLOTS; i++)
+            assert(atomic_load(&f_ctl->state[i]) != RSX_HOST_RENDERING);
+        eng_encode_and_commit(solid(128, 64, 0xFF0000FFu));
+        uint64_t seq2 = 0;
+        assert(f_read_newest(45, &seq2) == 0xFF0000FFu && seq2 == 45 && seq2 > seq1);   /* 44: the present that saw `closed` */
+        puts("re-attach after exec: ok");
+        rsx_metal_backend_shutdown();
+        puts("test_metal_host_surface: ok");
+    }
+    return 0;
+}
diff --git a/libs/video/tests/test_metal_image_io.m b/libs/video/tests/test_metal_image_io.m
new file mode 100644
index 0000000..bcfafc1
--- /dev/null
+++ b/libs/video/tests/test_metal_image_io.m
@@ -0,0 +1,61 @@
+/* The Metal backend's image files for texture packs (eng_image_load /
+ * eng_image_save, PS3_MODS and PS3_MODS_DUMP): what the dump writes reads
+ * back byte for byte, straight alpha included; a grey PNG and a file that is
+ * not an image.
+ *
+ *   clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_image_io.m \
+ *     -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore \
+ *     -o /tmp/test_metal_image_io && /tmp/test_metal_image_io
+ */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+int main(void)
+{
+    @autoreleasepool {
+        char dir[] = "/tmp/metal_image_io_XXXXXX";
+        assert(mkdtemp(dir));
+        char path[256];
+        snprintf(path, sizeof path, "%s/sub.png", dir);
+
+        /* 3x2 with a padded source row, translucent texels and alpha 0 */
+        enum { W = 3, H = 2, ROW = 16 };
+        u8 src[ROW * H];
+        memset(src, 0xEE, sizeof src);
+        for (u32 y = 0; y < H; y++)
+            for (u32 x = 0; x < W; x++) {
+                u8* p = src + y * ROW + x * 4;
+                p[0] = (u8)(40 * x + 7); p[1] = (u8)(90 * y + 3); p[2] = 200; p[3] = (u8)(x == 0 ? 0 : x == 1 ? 0x80 : 0xFF);
+            }
+        assert(eng_image_save(NULL, path, src, W, H, ROW));
+        for (int i = 0; i < 200 && access(path, F_OK) != 0; i++) usleep(10 * 1000);   /* written later */
+        usleep(50 * 1000);
+        u8* back = NULL; u32 w = 0, h = 0;
+        assert(eng_image_load(NULL, path, &back, &w, &h) && back && w == W && h == H);
+        for (u32 y = 0; y < H; y++)
+            assert(!memcmp(back + y * W * 4, src + y * ROW, W * 4));   /* exact, alpha 0 too */
+        free(back);
+
+        /* a grey PNG reads as grey RGBA */
+        NSBitmapImageRep* g = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:2 pixelsHigh:1
+            bitsPerSample:8 samplesPerPixel:1 hasAlpha:NO isPlanar:NO colorSpaceName:NSDeviceWhiteColorSpace
+            bytesPerRow:2 bitsPerPixel:8];
+        g.bitmapData[0] = 17; g.bitmapData[1] = 250;
+        snprintf(path, sizeof path, "%s/grey.png", dir);
+        assert([[g representationUsingType:NSBitmapImageFileTypePNG properties:@{}] writeToFile:@(path) atomically:YES]);
+        assert(eng_image_load(NULL, path, &back, &w, &h) && w == 2 && h == 1);
+        assert(back[0] == 17 && back[1] == 17 && back[2] == 17 && back[3] == 255 && back[4] == 250);
+        free(back);
+
+        /* not an image */
+        snprintf(path, sizeof path, "%s/notes.png", dir);
+        FILE* f = fopen(path, "w"); fputs("hello", f); fclose(f);
+        assert(!eng_image_load(NULL, path, &back, &w, &h) && back == NULL);
+        snprintf(path, sizeof path, "rm -rf '%s'", dir);
+        if (system(path) != 0) fprintf(stderr, "could not remove %s\n", dir);
+        puts("test_metal_image_io: ok");
+    }
+    return 0;
+}
diff --git a/libs/video/tests/test_metal_occlusion.m b/libs/video/tests/test_metal_occlusion.m
new file mode 100644
index 0000000..6e9c096
--- /dev/null
+++ b/libs/video/tests/test_metal_occlusion.m
@@ -0,0 +1,168 @@
+/* The Metal backend's ZPASS counting and polygon offset, on the GPU, with
+ * synthetic programs and no title data: samples counted per query, nothing
+ * reported before the draws are submitted, a query that drew nothing behind
+ * the depth buffer reports 0, scissored draws count only their pixels, and
+ * the depth bias (set_depth_bias) moves a coplanar draw in front of or behind
+ * the depth it is tested against.
+ *
+ * clang -fobjc-arc -I include -I libs/video
+ *   libs/video/tests/test_metal_occlusion.m libs/video/rsx_texture_layout.c libs/video/rsx_shader_msl.cpp -lc++
+ *   -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore
+ *   -o /tmp/test_metal_occlusion && /tmp/test_metal_occlusion
+ */
+#include "../rsx_metal_backend.m"
+#include <stdio.h>
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+static int failures, checks;
+#define CHECK(v, name) do { checks++; if (!(v)) { failures++; fprintf(stderr, "FAIL %s\n", name); } \
+                            else printf("[PASS] %s\n", name); } while (0)
+
+/* A full-viewport triangle at a fixed depth per vertex function. */
+static const char* fixture =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"struct V { float4 p [[position]]; };\n"
+"static V at(uint i, float z) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return {float4(p[i],z,1)}; }\n"
+"vertex V vs_front(uint i [[vertex_id]]) { return at(i, 0.25f); }\n"
+"vertex V vs_mid(uint i [[vertex_id]])   { return at(i, 0.5f); }\n"
+"vertex V vs_back(uint i [[vertex_id]])  { return at(i, 0.75f); }\n"
+"vertex V vs_step(uint i [[vertex_id]])  { return at(i, 0.5f + 100.0f / 16777216.0f); }\n"
+"fragment float4 fs(V v [[stage_in]]) { return float4(1,0,0,1); }\n";
+
+static id<MTLLibrary> s_lib;
+
+/* Put a pipeline straight into the backend's table: the HLSL translator is
+ * not linked into this test, and what is under test is the encoding. */
+static u32 add_pipeline(const char* vs, MTLCompareFunction cmp, BOOL write)
+{
+    MTLRenderPipelineDescriptor* p = [MTLRenderPipelineDescriptor new];
+    p.vertexFunction = [s_lib newFunctionWithName:[NSString stringWithUTF8String:vs]];
+    p.fragmentFunction = [s_lib newFunctionWithName:@"fs"];
+    p.colorAttachments[0].pixelFormat = MTLPixelFormatRGBA8Unorm;
+    p.depthAttachmentPixelFormat = MTL_DEPTH_FORMAT;
+    p.stencilAttachmentPixelFormat = MTL_DEPTH_FORMAT;
+    NSError* err = nil;
+    id<MTLRenderPipelineState> pso = [s_dev newRenderPipelineStateWithDescriptor:p error:&err];
+    if (!pso) { fprintf(stderr, "%s\n", err.localizedDescription.UTF8String); return 0; }
+    MTLDepthStencilDescriptor* ds = [MTLDepthStencilDescriptor new];
+    ds.depthCompareFunction = cmp;
+    ds.depthWriteEnabled = write;
+    EngPipeline* e = &s_eng_pipe[s_eng_pipe_count++];
+    e->pso = pso;
+    e->ds = [s_dev newDepthStencilStateWithDescriptor:ds];
+    e->cull = MTLCullModeNone;
+    e->winding = MTLWindingCounterClockwise;
+    e->building = 0;
+    return s_eng_pipe_count;
+}
+
+static void draw(u32 pipeline, u32 query, float slope, float units, u32 bits)
+{
+    static const float verts[3][4];
+    eng_bind_pipeline(NULL, pipeline);
+    eng_set_depth_bias(NULL, slope, units, bits);
+    eng_set_occlusion(NULL, query);
+    eng_draw(NULL, RSX_TOPOLOGY_TRIANGLES, verts, 3, 16, NULL, 0);
+}
+
+static int result(u32 query, u64* n) { *n = ~0ull; return eng_occlusion_result(NULL, query, n); }
+
+int main(void)
+{
+    @autoreleasepool {
+        s_dev = MTLCreateSystemDefaultDevice(); CHECK(s_dev != nil, "Metal device"); if (!s_dev) return 1;
+        s_queue = [s_dev newCommandQueue];
+        CHECK(eng_init(NULL, 8, 8) == 0, "backend helpers");
+        NSError* err = nil;
+        s_lib = [s_dev newLibraryWithSource:[NSString stringWithUTF8String:fixture] options:nil error:&err];
+        if (!s_lib) { fprintf(stderr, "%s\n", err.localizedDescription.UTF8String); return 1; }
+        const u32 color = eng_color_target_create(NULL, RSX_BE_FMT_R8G8B8A8, 8, 8, NULL, 0);
+        const u32 depth = eng_depth_target_create(NULL, 8, 8);
+        CHECK(color && depth, "targets");
+        const u32 mid_write = add_pipeline("vs_mid", MTLCompareFunctionLess, YES);
+        const u32 back_test = add_pipeline("vs_back", MTLCompareFunctionLess, NO);
+        const u32 front_test = add_pipeline("vs_front", MTLCompareFunctionLess, NO);
+        const u32 mid_less = add_pipeline("vs_mid", MTLCompareFunctionLess, NO);
+        const u32 mid_lequal = add_pipeline("vs_mid", MTLCompareFunctionLessEqual, NO);
+        CHECK(mid_write && back_test && front_test && mid_less && mid_lequal, "pipelines");
+
+        eng_bind_targets(NULL, &color, 1, depth);
+        eng_set_viewport(NULL, 0, 0, 8, 8);
+        eng_set_scissor(NULL, 0, 0, 8, 8);
+        eng_set_stencil_ref(NULL, 0);
+        eng_clear_depth_stencil(NULL, depth, RSX_BE_CLEAR_DEPTH | RSX_BE_CLEAR_STENCIL, 1.0f, 0);
+
+        u64 n;
+        /* 1: the whole 8x8 target at 0.5, writing depth. */
+        draw(mid_write, 1, 0, 0, 24);
+        /* 2: everything behind it. */
+        draw(back_test, 2, 0, 0, 24);
+        /* 3: in front of it, but scissored to 4x2. */
+        eng_set_scissor(NULL, 2, 3, 4, 2);
+        draw(front_test, 3, 0, 0, 24);
+        eng_set_scissor(NULL, 0, 0, 8, 8);
+        /* 4: two draws into one query: 64 + 64. */
+        draw(front_test, 4, 0, 0, 24);
+        draw(front_test, 4, 0, 0, 24);
+        /* A draw that is not counted. */
+        draw(front_test, 0, 0, 0, 24);
+        /* 5, 6: coplanar with the depth it tests against, LESS: rejected
+         * without a bias, passes when pulled toward the viewer (-1 slope,
+         * -256 units, Resistance's decal offset). 7: LEQUAL pushed away. */
+        draw(mid_less, 5, 0, 0, 24);
+        draw(mid_less, 6, -1.0f, -256.0f, 24);
+        draw(mid_lequal, 7, 0, 256.0f, 24);
+
+        CHECK(result(1, &n) == 2, "a recorded, unsubmitted query says so");
+        CHECK(result(99, &n) == -1, "an unknown query is unknown");
+        eng_submit_and_wait(NULL, 0);
+        CHECK(result(1, &n) == 1 && n == 64, "full-target draw counts every sample");
+        CHECK(result(2, &n) == 1 && n == 0, "a draw behind the depth buffer counts 0");
+        CHECK(result(3, &n) == 1 && n == 8, "a scissored draw counts its pixels only");
+        CHECK(result(4, &n) == 1 && n == 128, "two draws in one query add up");
+        CHECK(result(5, &n) == 1 && n == 0, "coplanar LESS without bias is rejected");
+        CHECK(result(6, &n) == 1 && n == 64, "negative polygon offset pulls the draw in front");
+        CHECK(result(7, &n) == 1 && n == 0, "positive polygon offset pushes it behind (LEQUAL)");
+
+
+        /* A Z16 unit is 256 of Z24's. Against a depth 100 Z24 units behind
+         * 0.5, a draw at 0.5 pushed back one Z24 unit still passes LESS; one
+         * pushed back one Z16 unit (256 Z24 units) does not. */
+        const u32 depth2 = eng_depth_target_create(NULL, 8, 8);
+        const u32 step_write = add_pipeline("vs_step", MTLCompareFunctionAlways, YES);
+        eng_bind_targets(NULL, &color, 1, depth2);
+        eng_clear_depth_stencil(NULL, depth2, RSX_BE_CLEAR_DEPTH | RSX_BE_CLEAR_STENCIL, 1.0f, 0);
+        draw(step_write, 0, 0, 0, 24);
+        draw(mid_less, 11, 0, 1.0f, 24);
+        draw(mid_less, 12, 0, 1.0f, 16);
+        eng_submit_and_wait(NULL, 0);
+        CHECK(result(11, &n) == 1 && n == 64, "one Z24 unit of bias stays in front of a 100-unit step");
+        CHECK(result(12, &n) == 1 && n == 0, "one Z16 unit of bias is 256 Z24 units");
+        eng_bind_targets(NULL, &color, 1, depth);
+
+        /* Queries across commits: the slots of the first commit are free. */
+        draw(front_test, 9, 0, 0, 24);
+        eng_submit_and_wait(NULL, 0);
+        CHECK(result(9, &n) == 1 && n == 64, "a later commit counts again");
+        CHECK(result(1, &n) == 1 && n == 64, "an earlier result stays readable");
+
+        /* An asynchronous commit (a windowed present): the count is pending
+         * while the command buffer runs and harvested once it has completed. */
+        draw(front_test, 13, 0, 0, 24);
+        {
+            id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+            eng_encode_records(cb, s_eng_slot >= 0 ? s_eng_slot_buf[s_eng_slot] : nil);
+            [cb commit];
+            eng_vis_committed(cb, 0);
+            s_eng_rec_count = 0; s_eng_stage_used = 0; s_eng_slot = -1;
+            const int r = result(13, &n);
+            CHECK(r == 0 || r == 1, "an in-flight query is pending, never 'unsubmitted'");
+            [cb waitUntilCompleted];
+            CHECK(result(13, &n) == 1 && n == 64, "harvested once its command buffer completes");
+        }
+
+        printf("%d checks, %d failures\n", checks, failures);
+        eng_shutdown(NULL);
+        return failures ? 1 : 0;
+    }
+}
diff --git a/libs/video/tests/test_metal_present_post.m b/libs/video/tests/test_metal_present_post.m
index 357ec01..a8820fc 100644
--- a/libs/video/tests/test_metal_present_post.m

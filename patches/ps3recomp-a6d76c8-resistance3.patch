+            { 0x1A00, 0x1BFC },   /* fragment texture units          */
+            { 0x1C00, 0x1CFC },   /* SET_VERTEX_DATA4F               */
+            { 0x1EFC, 0x1EFC },   /* SET_TRANSFORM_CONSTANT_LOAD     */

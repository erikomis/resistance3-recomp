+ * there is nothing to settle yet. */
+static void gcm_sh_walker_idle(u32 put, u32 calloff)
+{
+    if (!gcm_sh_on()) return;
+    AcquireSRWLockExclusive(&s_sh_lock);
+    gcm_sh_advance();
+    if (s_sh_put == put) {
+        if (!s_sh_valid || s_sh_pos != put) {
+            s_sh_valid = 1; s_sh_pos = put; s_sh_call = calloff; s_sh_cur = 0;
+        }
+        if (!s_rd_known || s_rd_seq != s_sh_nrec) {
+            s_rd_on = 0; s_rd_known = 1; s_rd_seq = s_sh_nrec;
+        }
+        s_sl_head = atomic_load(&s_sl_tail);
+    }
+    gcm_rd_refresh();
+    ReleaseSRWLockExclusive(&s_sh_lock);
+}
+
+/* The walker left the path (resync, teleport): forget what it was reading. */
+static void gcm_sh_walker_reset(void)
+{
+    if (!gcm_sh_on()) return;
+    AcquireSRWLockExclusive(&s_sh_lock);
+    s_rd_on = 0; s_rd_known = 0;
+    s_sh_valid = 0;                 /* revalidated at the walker's next rest */
+    s_sl_head = atomic_load(&s_sl_tail);
+    ReleaseSRWLockExclusive(&s_sh_lock);
+}

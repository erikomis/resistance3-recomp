+    /* Labels queued behind a report would land after -- and over -- these. */
+    gcm_dq_pump(RSX_ZPASS_WAIT);
+    const u32 tail = atomic_load(&s_sl_tail);
+    if (tail - s_sl_head > GCM_SL_N) s_sl_head = tail - GCM_SL_N;

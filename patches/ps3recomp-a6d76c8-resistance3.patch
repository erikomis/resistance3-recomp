+                    gcm_sl_push(s_sh_pos, m, vm_read32(dea), w);
+                }
+            }
+            s_sh_pos += 4u + count * 4u;
+            continue;
+        }
+        s_sh_pos += 4;
+    }
+    if (budget <= 0) s_sh_valid = 0;
+    if (s_sh_valid) gcm_sh_extend();

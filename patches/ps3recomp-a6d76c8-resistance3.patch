+static int audio_block_is_zero(const float* src, u32 nch)
+{
+    const u32* w = (const u32*)src;
+    for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * nch; i++)
+        if (w[i] & 0x7FFFFFFFu) return 0;
+    return 1;
+}

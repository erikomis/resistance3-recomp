+        rsx_draw_engine_present();
+    }
+    rsx_draw_engine_vcache_stats s = stats();
+    CHECK(s.created == 0 && s.resting >= 1,
+          "no buffer is made, and the key rests after three changes (%llu resting)",
+          (unsigned long long)s.resting);
+    engine_down();
+}

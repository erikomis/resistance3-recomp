+{
+    if (!s_pc_on) return nil;
+    id<MTLRenderPipelineState> pso = nil;
+    os_unfair_lock_lock(&s_pc_lock);
+    const int i = pc_find_locked(r->key);
+    if (i >= 0 && s_pc[i].state == PC_READY) pso = s_pc[i].pso;
+    os_unfair_lock_unlock(&s_pc_lock);
+    if (pso) __atomic_add_fetch(&s_pc_served, 1, __ATOMIC_RELAXED);
+    return pso;
+}
+
+/* A pipeline state the game built: into the table, the record and (unless it
+ * came out of it) the archive. RSX thread or the async build queue. */
+static void pc_built(const PcRec* r, id<MTLRenderPipelineState> pso,
+                     MTLRenderPipelineDescriptor* pd, int from_archive)
+{
+    if (!s_pc_on) return;
+    PcRec rec = *r;
+    rec.t_ms  = (u32)((ps3_ft_now() - s_pc_t0) / 1000000ull);
+    rec.check = pc_check(&rec);
+    int isnew = 0;
+    os_unfair_lock_lock(&s_pc_lock);
+    int i = pc_find_locked(rec.key);
+    if (i < 0) { i = pc_add_locked(&rec); isnew = i >= 0; }
+    if (i >= 0 && s_pc[i].state != PC_READY) { s_pc[i].pso = pso; s_pc[i].state = PC_READY; }
+    os_unfair_lock_unlock(&s_pc_lock);
+    if (isnew) {
+        __atomic_add_fetch(&s_pc_new, 1, __ATOMIC_RELAXED);
+        if (s_pc_record_on)
+            dispatch_async(s_pc_io, ^{
+                if (s_pc_fd >= 0 && write(s_pc_fd, &rec, sizeof rec) != (ssize_t)sizeof rec) {
+                    fprintf(stderr, "[pipeline cache] %s: write failed (%s); recording stops\n",
+                            s_pc_path, strerror(errno));
+                    close(s_pc_fd);
+                    s_pc_fd = -1;
+                }
+            });
+    }
+    /* Not in the archive, or the archive is being rewritten whole. */
+    if (!from_archive || __atomic_load_n(&s_pa_compact, __ATOMIC_ACQUIRE)) {
+        if (!from_archive) __atomic_add_fetch(&s_pa_new, 1, __ATOMIC_RELAXED);
+        pa_add(pd, rec.key);
+    }
+}
+
+/* The record file into the table; what is past the last whole record is cut
+ * off, and a file of another version starts again. */
+static void pc_load(void)
+{
+    u8 head[16];
+    memcpy(head, kPcMagic, 8);
+    const u32 ver = PC_VERSION, rsz = (u32)sizeof(PcRec);
+    memcpy(head + 8, &ver, 4);
+    memcpy(head + 12, &rsz, 4);
+    u32 dup = 0, bad = 0;
+    off_t good = 0;
+    FILE* f = fopen(s_pc_path, "rb");
+    if (f) {
+        u8 h[16];
+        if (fread(h, 1, sizeof h, f) == sizeof h && !memcmp(h, head, sizeof h)) {
+            good = sizeof h;
+            PcRec r;
+            while (fread(&r, 1, sizeof r, f) == sizeof r) {
+                if (r.check != pc_check(&r) || r.key != pc_key(&r)) { bad = 1; break; }
+                good += (off_t)sizeof r;
+                if (pc_find_locked(r.key) >= 0) { dup++; continue; }    /* two instances appended it */
+                (void)pc_add_locked(&r);                                /* full: kept on disk, not rebuilt */
+            }
+        }
+        fclose(f);
+    }
+    s_pc_loaded = s_pc_count;
+    if (!s_pc_record_on) return;
+    struct stat st;
+    const int exists = stat(s_pc_path, &st) == 0;
+    if (!exists || good == 0) {
+        const int fd = open(s_pc_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+        if (fd >= 0) { if (write(fd, head, sizeof head) != (ssize_t)sizeof head) bad = 1; close(fd); }
+    } else if (st.st_size != good) {
+        if (truncate(s_pc_path, good) != 0) bad = 1;
+        fprintf(stderr, "[pipeline cache] %s: %lld byte(s) after the last whole record dropped\n",
+                s_pc_path, (long long)(st.st_size - good));
+    }
+    (void)dup; (void)bad;
+    s_pc_fd = open(s_pc_path, O_WRONLY | O_APPEND);
+    if (s_pc_fd < 0)
+        fprintf(stderr, "[pipeline cache] cannot append to %s (%s): nothing is recorded\n", s_pc_path, strerror(errno));
+}
+
+/* A recorded program: the engine's function if it has it, else compiled from
+ * its cached MSL and given to the engine's memo. nil: no MSL, or it failed. */
+static id<MTLFunction> pc_function(u64 hash, u64 sc_key, const char* what)
+{
+    id<MTLFunction> fn = nil;
+    int found = 0;
+    pthread_mutex_lock(&s_eng_func_lock);
+    for (u32 i = 0; i < s_eng_func_count; i++)
+        if (s_eng_func[i].hash == hash) { fn = s_eng_func[i].fn; found = 1; break; }
+    pthread_mutex_unlock(&s_eng_func_lock);
+    if (found) return fn;
+    char path[1300], name[64];
+    sc_msl_path(path, sizeof path, sc_key);
+    NSString* src = [NSString stringWithContentsOfFile:[NSString stringWithUTF8String:path]
+                                              encoding:NSUTF8StringEncoding error:nil];
+    if (!src.length) return nil;
+    snprintf(name, sizeof name, "%s %016llx (prewarm)", what, (unsigned long long)hash);
+    fn = compile_guest_function([src UTF8String], name);
+    if (!fn || __atomic_load_n(&s_pc_cancel, __ATOMIC_ACQUIRE)) return fn;
+    pthread_mutex_lock(&s_eng_func_lock);
+    found = 0;
+    for (u32 i = 0; i < s_eng_func_count; i++)
+        if (s_eng_func[i].hash == hash) { if (s_eng_func[i].fn) fn = s_eng_func[i].fn; found = 1; break; }
+    /* Half the table at most: the game's own programs must always fit. */
+    if (!found && s_eng_func_count < eng_func_cap() / 2u) {
+        s_eng_func[s_eng_func_count].hash = hash;
+        s_eng_func[s_eng_func_count].fn   = fn;
+        s_eng_func_count++;
+    }
+    pthread_mutex_unlock(&s_eng_func_lock);
+    return fn;
+}
+
+static void pc_prewarm_one(u32 idx)
+{
+    const PcRec rec = s_pc[idx].rec;    /* a loaded record: never written again */
+    id<MTLFunction> vs = pc_function(rec.vs_hash, rec.vs_sc, "vp");
+    id<MTLFunction> fs = vs ? pc_function(rec.fs_hash, rec.fs_sc, "fp") : nil;
+    MTLRenderPipelineDescriptor* pd = (vs && fs) ? pc_descriptor(&rec, vs, fs) : nil;
+    int hit = 0;
+    id<MTLRenderPipelineState> pso = pd ? pc_build_pso(pd, &hit, NULL) : nil;
+    int mine = 0;
+    os_unfair_lock_lock(&s_pc_lock);
+    if (s_pc[idx].state == PC_BUILDING) {       /* else the game built it meanwhile */
+        mine = 1;
+        if (pso) s_pc[idx].pso = pso;
+        s_pc[idx].state = pso ? PC_READY : PC_FAILED;
+    }
+    os_unfair_lock_unlock(&s_pc_lock);
+    if (pso && (!hit || __atomic_load_n(&s_pa_compact, __ATOMIC_ACQUIRE))) {
+        if (!hit) __atomic_add_fetch(&s_pa_new, 1, __ATOMIC_RELAXED);
+        pa_add(pd, rec.key);
+    }
+    __atomic_add_fetch(!mine ? &s_pcw_already : pso ? &s_pcw_built : &s_pcw_failed, 1, __ATOMIC_RELAXED);
+}
+
+static int pc_order_cmp(const void* a, const void* b)
+{
+    const u32 ia = *(const u32*)a, ib = *(const u32*)b;
+    const u32 ta = s_pc[ia].rec.t_ms, tb = s_pc[ib].rec.t_ms;
+    return ta != tb ? (ta < tb ? -1 : 1) : (ia < ib ? -1 : ia > ib);
+}
+
+static void pc_prewarm(void)
+{
+    const u32 n = s_pc_loaded;
+    int jobs = 3;
+    { const char* e = getenv("PS3_PIPELINE_PREWARM_JOBS"); if (e) jobs = atoi(e); }
+    if (jobs < 1) jobs = 1;
+    if (jobs > 8) jobs = 8;
+    dispatch_group_enter(s_pc_group);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        dispatch_sync(s_pc_io, ^{});            /* the archive is loaded (or there is none) */
+        const uint64_t t0 = ps3_ft_now();
+        const u32 hits0 = __atomic_load_n(&s_pa_hits, __ATOMIC_RELAXED);
+        u32* order = (u32*)malloc((size_t)n * sizeof(u32));
+        if (order) {
+            for (u32 i = 0; i < n; i++) order[i] = i;
+            qsort(order, n, sizeof(u32), pc_order_cmp);
+            dispatch_semaphore_t gate = dispatch_semaphore_create(jobs);
+            dispatch_group_t group = dispatch_group_create();
+            for (u32 k = 0; k < n && !__atomic_load_n(&s_pc_cancel, __ATOMIC_ACQUIRE); k++) {
+                const u32 idx = order[k];
+                os_unfair_lock_lock(&s_pc_lock);
+                const int st = s_pc[idx].state;
+                if (st == PC_NONE) s_pc[idx].state = PC_BUILDING;
+                os_unfair_lock_unlock(&s_pc_lock);
+                if (st != PC_NONE) { __atomic_add_fetch(&s_pcw_already, 1, __ATOMIC_RELAXED); continue; }
+                dispatch_semaphore_wait(gate, DISPATCH_TIME_FOREVER);
+                dispatch_group_async(group, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                    @autoreleasepool { pc_prewarm_one(idx); }
+                    dispatch_semaphore_signal(gate);
+                });
+            }
+            dispatch_group_wait(group, DISPATCH_TIME_FOREVER);
+            free(order);
+        }
+        const int cancelled = __atomic_load_n(&s_pc_cancel, __ATOMIC_ACQUIRE);
+        /* The rebuild alone: with macOS's cache or the archive behind it a
+         * pipeline is well under a millisecond, so hundreds in 0.1 s is real.
+         * The archive's save is timed in its own line. */
+        const double secs = (double)(ps3_ft_now() - t0) / 1e9;
+        dispatch_sync(s_pc_io, ^{               /* after the additions queued so far */
+            const u32 from_archive = __atomic_load_n(&s_pa_hits, __ATOMIC_RELAXED) - hits0;
+            const u32 fresh = __atomic_load_n(&s_pa_new, __ATOMIC_RELAXED);
+            fprintf(stderr, "[pipeline cache] %u recorded pipelines, %u rebuilt at boot in %.2f s"
+                            " (%u already in table), archive: %u binaries",
+                    n, s_pcw_built, secs, s_pcw_already, s_pc_archive_on ? from_archive + fresh : 0u);
+            if (s_pc_archive_on) fprintf(stderr, " (%u loaded from it, %u compiled and to be added)", from_archive, fresh);
+            if (s_pcw_failed) fprintf(stderr, "; %u not rebuilt (no cached MSL, or the build failed)", s_pcw_failed);
+            fprintf(stderr, "%s\n", cancelled ? "; stopped early" : "");
+            /* A merge needs every pipeline: a prewarm cut short leaves the
+             * chunks as they are, and the next boot tries again. */
+            const int merging = __atomic_load_n(&s_pa_compact, __ATOMIC_ACQUIRE);
+            if (merging && cancelled) pa_drop();    /* mostly binaries the chunks already hold */
+            pa_save(merging && !cancelled);
+            __atomic_store_n(&s_pa_compact, 0, __ATOMIC_RELEASE);
+        });
+        if (!cancelled) sc_prewarm();           /* the MSL the records do not name */
+        dispatch_group_leave(s_pc_group);
+    });
+}
+
+static void pc_session_line(void)
+{
+    fprintf(stderr, "[pipeline cache] session: %u pipeline(s) served from the table, %u new recorded"
+                    " (%u in the table), archive: %u hits, %u added\n",
+            __atomic_load_n(&s_pc_served, __ATOMIC_RELAXED), __atomic_load_n(&s_pc_new, __ATOMIC_RELAXED),
+            s_pc_count, __atomic_load_n(&s_pa_hits, __ATOMIC_RELAXED),
+            __atomic_load_n(&s_pa_added, __ATOMIC_RELAXED));
+}
+
+/* Exit: the pipelines still waiting for the archive are saved. */
+static void pc_atexit(void)
+{
+    if (!s_pc_on) return;
+    __atomic_store_n(&s_pc_cancel, 1, __ATOMIC_RELEASE);
+    dispatch_sync(s_pc_io, ^{
+        if (__atomic_load_n(&s_pa_compact, __ATOMIC_ACQUIRE)) pa_drop();    /* a merge in progress: the next boot's */
+        pa_save(0);
+        pc_session_line();
+    });
+}
+
+/* eng_shutdown: the prewarm writes the function memo, which is reset there. */
+static void pc_shutdown(void)
+{
+    if (!s_pc_on) return;
+    __atomic_store_n(&s_pc_cancel, 1, __ATOMIC_RELEASE);
+    dispatch_group_wait(s_pc_group, DISPATCH_TIME_FOREVER);
+    dispatch_sync(s_pc_io, ^{ pa_save(0); pc_session_line(); });
+    __atomic_store_n(&s_pc_cancel, 0, __ATOMIC_RELEASE);
+}
+
+/* From sc_on, once the cache directory is open. 1: the pipeline prewarm runs
+ * and starts sc_prewarm itself when it is done (two prewarms at once would be
+ * six compiler threads during the boot). */
+static int pc_boot(void)
+{
+    const char* e;
+    const int rec = !((e = getenv("PS3_PIPELINE_RECORD"))  && e[0] == '0');
+    const int pre = !((e = getenv("PS3_PIPELINE_PREWARM")) && e[0] == '0');
+    int arc       = !((e = getenv("PS3_PIPELINE_ARCHIVE")) && e[0] == '0');
+    if (@available(macOS 11.0, *)) { /* MTLBinaryArchive */ } else { arc = 0; }
+    if ((!rec && !pre && !arc) || !s_dev) return 0;
+    s_pc_t0 = ps3_ft_now();
+    s_pc_record_on = rec;
+    s_pc_archive_on = arc;
+    s_pc_prewarm_on = pre;
+    if ((e = getenv("PS3_PIPELINE_ARCHIVE_FLUSH")) && atoi(e) > 0) s_pa_flush_n = (u32)atoi(e);
+    if ((e = getenv("PS3_PIPELINE_ARCHIVE_MAX_MB")) && atoi(e) > 0) s_pa_max_bytes = (uint64_t)atoi(e) << 20;
+    if ((e = getenv("PS3_PIPELINE_ARCHIVE_CHUNKS")) && atoi(e) > 0) s_pa_max_chunks = (u32)atoi(e);
+    snprintf(s_pc_path, sizeof s_pc_path, "%s/pipelines.rec", s_sc_dir);
+    pc_load();
+    s_pc_io = dispatch_queue_create("ps3recomp.pipelines",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0));
+    s_pc_group = dispatch_group_create();
+    s_pc_on = 1;
+    atexit(pc_atexit);
+    fprintf(stderr, "[pipeline cache] %s: %u pipeline(s) recorded (record %d, prewarm %d, archive %d)\n",
+            s_pc_path, s_pc_loaded, rec, pre, arc);
+    if (arc) dispatch_async(s_pc_io, ^{ pa_load(); });
+    if (pre && s_pc_loaded) { pc_prewarm(); return 1; }
+    return 0;
+}
+
+/* PS3_SHADER_ASYNC_SYNC_HIT (default 2 again, now under the budget and the
+ * prewarm above; the text below is why 2 was dropped without them): with
+ * PS3_SHADER_ASYNC, a pipeline
+ * whose two functions are already in memory is built at once instead of on
+ * the queue: that is only the PSO, 0.1-0.2 ms, and the frames its draws would
+ * otherwise be skipped for show as an object flashing in and out. 2 also
+ * builds at once when the MSL translations are on disk, but that still runs
+ * the Metal compile on the RSX thread, 20-60 ms each and over 200 ms for a
+ * big fragment program when the OS cache does not have it: in a player's
+ * session 53, 127 and 95 such builds in a row stalled the RSX for 3 s each
+ * and the game reported "GPU sit and spin timeout". 0 = always queue. */
+/* Builds made at once from the disk cache (mode 2) are charged to a budget:
+ * PS3_SHADER_SYNC_BUDGET_MS (default 8) of compile time per 100 ms of wall
+ * clock. Past it the rest go to the queue, so a burst of them whose Metal
+ * compile is not cached cannot stall the RSX thread for seconds (it did: 53,
+ * 127 and 95 in a row, 3 s each, "GPU sit and spin timeout"); with the
+ * prewarm above they are 0.3 ms each and dozens fit. */
+static uint64_t s_disk_win_t0, s_disk_win_spent;
+static uint64_t sb_disk_budget_ns(void)
+{
+    static int64_t ns = -1;
+    if (ns < 0) { const char* e = getenv("PS3_SHADER_SYNC_BUDGET_MS"); ns = (int64_t)((e ? atof(e) : 8.0) * 1e6); if (ns < 0) ns = 0; }
+    return (uint64_t)ns;
+}
+/* A leaky bucket rather than a window that empties every 100 ms: what was
+ * spent drains at the budget's rate (8 ms per 100 ms by default), so after one
+ * expensive build (a pipeline macOS had never seen, 60-90 ms) the next ones go
+ * to the queue for about a second instead of one such stall per 100 ms
+ * (a player's session had an 87 ms build every ~0.2 s while new effects
+ * streamed in). PS3_SHADER_BUDGET_WINDOW=1 restores the emptying window. */
+static int sb_disk_budget_left(void)
+{
+    static int s_window = -1;
+    if (s_window < 0) { const char* e = getenv("PS3_SHADER_BUDGET_WINDOW"); s_window = e && atoi(e) > 0; }
+    const uint64_t now = ps3_ft_now();
+    if (s_window) {
+        if (now - s_disk_win_t0 >= 100000000ull) { s_disk_win_t0 = now; s_disk_win_spent = 0; }
+        return s_disk_win_spent < sb_disk_budget_ns();
+    }
+    if (s_disk_win_t0) {
+        const uint64_t drained = (uint64_t)((double)(now - s_disk_win_t0) * (double)sb_disk_budget_ns() / 1e8);
+        s_disk_win_spent = s_disk_win_spent > drained ? s_disk_win_spent - drained : 0;
+    }
+    s_disk_win_t0 = now;
+    return s_disk_win_spent < sb_disk_budget_ns();
+}
+static void sb_disk_budget_spend(uint64_t ns) { s_disk_win_spent += ns; }
+
+static int sb_sync_hit_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) { const char* e = getenv("PS3_SHADER_ASYNC_SYNC_HIT"); mode = e ? atoi(e) : 2; if (mode < 0) mode = 0; }
+    return mode;
+}
+
+static int eng_function_ready(const char* hlsl, int stage, int mode)
+{
+    const u64 hash = fnv1a64(hlsl, (u32)strlen(hlsl), 1469598103934665603ull);
+    int found = 0;
+    pthread_mutex_lock(&s_eng_func_lock);
+    for (u32 i = 0; i < s_eng_func_count && !found; i++)
+        if (s_eng_func[i].hash == hash) found = 1;
+    pthread_mutex_unlock(&s_eng_func_lock);
+    if (found) return 1;
+    if (mode < 2 || !sc_on()) return 0;
+    const u64 sc_key = fnv1a64(&stage, sizeof stage, fnv1a64(hlsl, (u32)strlen(hlsl), s_sc_salt));
+    char path[1300];
+    sc_msl_path(path, sizeof path, sc_key);
+    return access(path, R_OK) == 0;
+}
+
+static u32 eng_pipeline_create(void* user, const char* vs_hlsl, const char* ps_hlsl,
+                               const rsx_be_render_state* rs,
+                               const rsx_vertex_layout_plan* layout,
+                               u32 vertex_stride, rsx_be_format rt_fmt,
+                               u32 rt_count)
+{
+    (void)user;
+    if (!s_dev || !s_guest_shaders || !vertex_stride) return 0;
+    if (!rt_count) rt_count = 1;
+    if (rt_count > RSX_BE_MAX_COLOR_TARGETS) rt_count = RSX_BE_MAX_COLOR_TARGETS;
+    if (s_eng_pipe_count >= eng_pipe_cap()) {
+        static u32 logged;
+        if (!logged++) fprintf(stderr, "[RSX metal] pipeline table full (%u): new pipelines fail"
+                                       " (PS3RECOMP_METAL_MAX_PIPES)\n", eng_pipe_cap());
         return 0;
     }
+    if (s_eng_pipe_count && (s_eng_pipe_count & 511u) == 0u)
+        fprintf(stderr, "[RSX metal] %u pipelines, %u functions\n", s_eng_pipe_count, s_eng_func_count);
+    const uint64_t sb_t0 = sb_on() ? ps3_ft_now() : 0;   /* PS3_SHADER_TIMING */
+    /* The persistent pipelines (above): what is asked for in its canonical
+     * form, and the state the boot prewarm or an earlier request already
+     * built for it. A hit needs no function, no compile and no budget. */
+    (void)sc_on();
+    PcRec pc;
+    pc_fill(&pc, vs_hlsl, ps_hlsl, rs, layout, vertex_stride, rt_fmt, rt_count);
+    MTLRenderPipelineDescriptor* pd = pc_descriptor(&pc, nil, nil);
+    if (!pd) return 0;          /* a vertex layout Metal cannot be given */
+    id<MTLRenderPipelineState> pso = pc_lookup(&pc);
+    /* PS3_SHADER_ASYNC: the functions and the state are built on the queue --
+     * unless both are cheap to have now (sb_sync_hit_mode). */
+    int async = pso ? 0 : sc_async();
+    uint64_t disk_t0 = 0;        /* a build at once from the disk cache: charged to the budget */
+    /* PS3_SHADER_SYNC_BUDGET_ALL (default 1; =0 the old rule): every build made
+     * at once is charged to the budget, functions AND pipeline state, not only
+     * the disk-cache functions. The PSO is the expensive half when the OS has
+     * not seen that pipeline (60-90 ms each in Resistance 3's new areas), and
+     * builds whose functions were already in memory were never charged: a
+     * player's session had passes of 800 ms with 12 such builds in a row. Past
+     * the budget the rest go to the queue, their draws skipped for a frame or
+     * two instead of the whole game stalling. */
+    static int s_budget_all = -1;
+    if (s_budget_all < 0) { const char* e = getenv("PS3_SHADER_SYNC_BUDGET_ALL"); s_budget_all = e ? atoi(e) != 0 : 1; }
+    if (async) {
+        const int mode = sb_sync_hit_mode();
+        if (mode > 0 && (!s_budget_all || sb_disk_budget_left()) &&
+            eng_function_ready(vs_hlsl, RSX_SHADER_STAGE_VERTEX, 1) &&
+            eng_function_ready(ps_hlsl, RSX_SHADER_STAGE_FRAGMENT, 1)) {
+            async = 0;
+            if (s_budget_all) disk_t0 = ps3_ft_now();
+        } else if (mode >= 2 && sb_disk_budget_left() &&
+                 eng_function_ready(vs_hlsl, RSX_SHADER_STAGE_VERTEX, 2) &&
+                 eng_function_ready(ps_hlsl, RSX_SHADER_STAGE_FRAGMENT, 2)) {
+            async = 0;
+            disk_t0 = ps3_ft_now();
+        }
+    }
+    id<MTLFunction> vs = nil, fs = nil;
+    char* vs_copy = NULL;
+    char* ps_copy = NULL;
+    if (pso) {
+        /* prebuilt */
+    } else if (!async) {
+        vs = eng_function(vs_hlsl, RSX_SHADER_STAGE_VERTEX, "vp");
+        if (!vs) return 0;
+        fs = eng_function(ps_hlsl, RSX_SHADER_STAGE_FRAGMENT, "fp");
+        if (disk_t0 && !s_budget_all) sb_disk_budget_spend(ps3_ft_now() - disk_t0);
+        if (!fs) { if (disk_t0 && s_budget_all) sb_disk_budget_spend(ps3_ft_now() - disk_t0); return 0; }
+    } else {

+    m(0x1EA0, 0);                                    /* TRANSFORM_PROGRAM_START */
+    rsx_test_fp_instr(vm_base + WPOS_FP_OFFSET,
+                      RSX_TEST_FP_OPC(RSX_TEST_FP_OP_MOV) | RSX_TEST_FP_MASK_XYZW |
+                      RSX_TEST_FP_INSRC(0) | RSX_TEST_FP_END,

+    const int keep = (e && atoi(e) != 0) || getenv("RSX_TRACE") || getenv("TCONST_DBG") ||
+                     getenv("SEQ_DBG") || getenv("VDATA_DBG") || getenv("LOAD_DBG") ||
+                     getenv("MVPDBG");

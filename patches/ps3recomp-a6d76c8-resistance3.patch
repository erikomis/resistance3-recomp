+/* Binaries are the GPU's and the system's: the chunks are named after both,
+ * and the others' files are removed. One that does not load is removed too. */
+static void pa_load(void)
+{
+    if (@available(macOS 11.0, *)) {
+        @autoreleasepool {
+            NSString* os = [[NSProcessInfo processInfo] operatingSystemVersionString];
+            NSString* id_s = [NSString stringWithFormat:@"%@|%@", os, s_dev.name];
+            const char* idc = [id_s UTF8String];
+            const u64 tag = fnv1a64(idc, (u32)strlen(idc), 1469598103934665603ull);
+            snprintf(s_pa_prefix, sizeof s_pa_prefix, "pipelines-%016llx", (unsigned long long)tag);
+            const size_t plen = strlen(s_pa_prefix);
+            const uint64_t t0 = ps3_ft_now();
+            NSMutableArray<id<MTLBinaryArchive>>* loaded = [NSMutableArray new];
+            NSMutableArray<NSString*>* names = [NSMutableArray new];
+            s_pa_files = [NSMutableArray new];
+            DIR* d = opendir(s_sc_dir);
+            if (d) {
+                struct dirent* de;
+                while ((de = readdir(d))) {
+                    const char* nm = de->d_name;
+                    const size_t len = strlen(nm);
+                    if (strncmp(nm, "pipelines-", 10) || !strstr(nm, ".metalarchive")) continue;
+                    const int chunk = len > 13 && !strcmp(nm + len - 13, ".metalarchive");
+                    /* Another system's, a save that never finished, or the
+                     * first version's single file (mostly empty: see above). */
+                    if (!chunk || strncmp(nm, s_pa_prefix, plen) || nm[plen] != '-') {
+                        char old[1700];
+                        snprintf(old, sizeof old, "%s/%s", s_sc_dir, nm);
+                        unlink(old);
+                        continue;
+                    }
+                    [names addObject:[NSString stringWithUTF8String:nm]];
+                }
+                closedir(d);
+            }
+            [names sortUsingSelector:@selector(compare:)];
+            for (NSString* nm in names) {
+                NSString* path = [[NSString stringWithUTF8String:s_sc_dir] stringByAppendingPathComponent:nm];
+                const u32 seq = (u32)atoi([nm UTF8String] + plen + 1);
+                if (seq >= s_pa_seq) s_pa_seq = seq + 1;
+                NSError* err = nil;
+                MTLBinaryArchiveDescriptor* ad = [MTLBinaryArchiveDescriptor new];
+                ad.url = [NSURL fileURLWithPath:path];
+                id<MTLBinaryArchive> ar = [s_dev newBinaryArchiveWithDescriptor:ad error:&err];
+                if (!ar) {
+                    fprintf(stderr, "[pipeline cache] archive %s discarded (it did not load: %s)\n",
+                            [nm UTF8String], [[err localizedDescription] UTF8String]);
+                    unlink([path UTF8String]);
+                    continue;
+                }
+                [loaded addObject:ar];
+                [s_pa_files addObject:path];
+                s_pa_bytes += pa_file_size([path UTF8String]);
+            }
+            s_pa_pend = [NSMutableArray new];
+            s_pa_pend_key = [NSMutableArray new];
+            if (loaded.count) {
+                s_pa_read = [loaded copy];
+                /* Too many chunks: this boot's prewarm writes them as one. */
+                if (loaded.count > s_pa_max_chunks && s_pc_prewarm_on && s_pc_loaded)
+                    __atomic_store_n(&s_pa_compact, 1, __ATOMIC_RELEASE);
+                __atomic_store_n(&s_pa_ready, 1, __ATOMIC_RELEASE);
+                fprintf(stderr, "[pipeline cache] archive loaded: %u file(s), %.1f MB in %.0f ms%s\n",
+                        (unsigned)loaded.count, (double)s_pa_bytes / 1048576.0, (double)(ps3_ft_now() - t0) / 1e6,
+                        s_pa_compact ? " (to be merged into one)" : "");
+            }
+        }
+    }
+}

+ * the sweep. */
+static int gcm_sl_replay(u32 put)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GCM_RESYNC_REPLAY"); on = !(e && e[0] == '0'); }
+    if (!on || !gcm_sh_on()) return 0;
+    (void)put;
+    AcquireSRWLockExclusive(&s_sh_lock);
+    gcm_sh_advance();

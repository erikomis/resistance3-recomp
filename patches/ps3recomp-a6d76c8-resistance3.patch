+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+int np_psnr_enabled(void) { return 0; }
+const char* np_psnr_online_id(void) { return "Resident_01"; }
+void edat_add_klicensee(const uint8_t klic[16]) { (void)klic; }
+
+static int s_queued;
+static u64 s_args[8];
+static u32 s_opd;
+s32 cellSysutilQueueGuestCallbackArgs(u32 opd, const u64 args[8])
+{
+    s_opd = opd; memcpy(s_args, args, sizeof s_args); s_queued++;
+    return 0;
+}
+
+#define NPID   0x1000u
+#define SVC    0x2000u
+#define SIZE   0x3000u
+#define PARAM  0x3100u
+#define TICKET 0x4000u
+#define CB     0x5000u
+#define CBARG  0x6000u
+
+static u32 be32(const u8* p) { return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3]; }
+
+int main(void)
+{
+    vm_base = calloc(1, 0x10000); assert(vm_base);
+    memcpy(vm_base + SVC, "UP9000-BCUS98107_00", 20);
+    assert(sceNpInit(0, NULL) == CELL_OK);
+
+    /* PS3_NP_SIGNIN alone is not enough: still offline. */
+    setenv("PS3_NP_SIGNIN", "1", 1);
+    unsetenv("PS3_NET_ONLINE");
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, (const char*)(uintptr_t)SVC,
+                                     NULL, 0, NULL, 0) == (s32)SCE_NP_ERROR_OFFLINE);
+    assert(sceNpManagerGetStatus((s32*)(uintptr_t)SIZE) == CELL_OK);
+    assert((s32)vm_read32(SIZE) == SCE_NP_MANAGER_STATUS_OFFLINE);
+
+    setenv("PS3_NET_ONLINE", "1", 1);
+    assert(sceNpManagerGetStatus((s32*)(uintptr_t)SIZE) == CELL_OK);
+    assert((s32)vm_read32(SIZE) == SCE_NP_MANAGER_STATUS_ONLINE);
+
+    /* Registering tells the title it is signed in. */
+    assert(sceNpManagerRegisterCallback((SceNpManagerCallback)(uintptr_t)CB, (void*)(uintptr_t)CBARG) == CELL_OK);
+    assert(s_queued == 1 && s_opd == CB && (s32)s_args[0] == SCE_NP_MANAGER_STATUS_ONLINE);
+
+    /* No ticket yet. */
+    assert(sceNpManagerGetTicketParam(5, (void*)(uintptr_t)PARAM) == (s32)SCE_NP_ERROR_INVALID_STATE);
+    vm_write32(SIZE, 0);
+    assert(sceNpManagerGetTicket(NULL, (u32*)(uintptr_t)SIZE) == CELL_OK && vm_read32(SIZE) == 0);
+
+    /* The request: GOT_TICKET with the size, then the ticket itself. */
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, (const char*)(uintptr_t)SVC,
+                                     NULL, 0, NULL, 0) == CELL_OK);
+    assert(s_queued == 2 && s_opd == CB);
+    assert(s_args[0] == 255 && s_args[2] == CBARG);
+    const u32 n = (u32)s_args[1];
+    assert(n > 140 && n <= NP_TICKET_MAX);
+
+    vm_write32(SIZE, 0);
+    assert(sceNpManagerGetTicket(NULL, (u32*)(uintptr_t)SIZE) == CELL_OK && vm_read32(SIZE) == n);
+    vm_write32(SIZE, n - 1);
+    assert(sceNpManagerGetTicket((void*)(uintptr_t)TICKET, (u32*)(uintptr_t)SIZE) == (s32)SCE_NP_ERROR_INVALID_ARGUMENT);
+    vm_write32(SIZE, 1024);
+    assert(sceNpManagerGetTicket((void*)(uintptr_t)TICKET, (u32*)(uintptr_t)SIZE) == CELL_OK && vm_read32(SIZE) == n);
+
+    const u8* t = vm_base + TICKET;
+    assert(be32(t) == 0x21010000u && be32(t + 4) == n - 8);       /* version 2.1, size of the rest */
+    assert(t[8] == 0x30 && t[9] == 0x00);                          /* the body section */
+    assert(be32(t + 80) == 0x00040020u);                           /* online ID: string, 32 bytes */
+    assert(!strcmp((const char*)t + 84, "Resident_01"));
+    assert(be32(t + 132) == 0x00080018u);                          /* service ID: binary, 24 bytes */
+    assert(!strcmp((const char*)t + 136, "UP9000-BCUS98107_00"));
+    const u32 body = ((u32)t[10] << 8) | t[11];
+    assert(t[12 + body] == 0x30 && t[13 + body] == 0x02);          /* then the footer */
+    assert(12 + body + 4 + (((u32)t[14 + body] << 8) | t[15 + body]) == n);
+
+    /* The fields a title can ask for. */
+    assert(sceNpManagerGetTicketParam(5, (void*)(uintptr_t)PARAM) == CELL_OK);
+    assert(!strcmp((const char*)vm_base + PARAM, "Resident_01"));
+    assert(sceNpManagerGetTicketParam(8, (void*)(uintptr_t)PARAM) == CELL_OK);
+    assert(!strcmp((const char*)vm_base + PARAM, "UP9000-BCUS98107_00"));
+    assert(sceNpManagerGetTicketParam(1, (void*)(uintptr_t)PARAM) == CELL_OK && vm_read32(PARAM) == 0x100);
+    assert(sceNpManagerGetTicketParam(12, (void*)(uintptr_t)PARAM) == (s32)SCE_NP_ERROR_INVALID_ARGUMENT);
+
+    printf("test_np_ticket_local: all passed (%u-byte ticket)\n", n);
+    return 0;
+}
diff --git a/libs/network/tests/test_np_ticket_offline.c b/libs/network/tests/test_np_ticket_offline.c
new file mode 100644
index 0000000..7835583
--- /dev/null
+++ b/libs/network/tests/test_np_ticket_offline.c
@@ -0,0 +1,79 @@
+/* sceNpManagerRequestTicket and friends with no PSN: offline the request fails
+ * with SCE_NP_ERROR_OFFLINE (it used to fake CELL_OK as an unresolved import,
+ * and Resistance then waited for a ticket for ever), arguments are checked
+ * first, and the ticket getters report that there is no ticket.
+ *
+ *   cc -std=gnu17 -I include -o /tmp/test_np_ticket_offline \
+ *      libs/network/tests/test_np_ticket_offline.c && /tmp/test_np_ticket_offline
+ */
+#include "../sceNp.c"
+#include <assert.h>
+#include <stdlib.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+
+static int s_online;
+int np_psnr_enabled(void) { return s_online; }
+const char* np_psnr_online_id(void) { return "PS3Player"; }
+s32 cellSysutilQueueGuestCallbackArgs(u32 opd, const u64 args[8]) { (void)opd; (void)args; return 0; }
+void edat_add_klicensee(const uint8_t klic[16]) { (void)klic; }
+
+#define NPID   0x1000u
+#define SVC    0x2000u
+#define SIZE   0x3000u
+#define PARAM  0x3100u
+
+int main(void)
+{
+    vm_base = calloc(1, 0x10000); assert(vm_base);
+    memcpy(vm_base + SVC, "IV0001-NPXS00001_00", 20);
+
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, (const char*)(uintptr_t)SVC,
+                                     NULL, 0, NULL, 0) == (s32)SCE_NP_ERROR_NOT_INITIALIZED);
+    assert(sceNpInit(0, NULL) == CELL_OK);
+
+    /* Arguments before state, as on the console. */
+    assert(sceNpManagerRequestTicket(NULL, (const char*)(uintptr_t)SVC, NULL, 0, NULL, 0)
+           == (s32)SCE_NP_AUTH_EINVALID_ARGUMENT);
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, NULL, NULL, 0, NULL, 0)
+           == (s32)SCE_NP_AUTH_EINVALID_ARGUMENT);
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, (const char*)(uintptr_t)SVC,
+                                     NULL, SCE_NP_COOKIE_MAX_SIZE + 1, NULL, 0)
+           == (s32)SCE_NP_AUTH_EINVALID_ARGUMENT);
+
+    /* Offline: refused, and the status the title can read agrees. */
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, (const char*)(uintptr_t)SVC,
+                                     NULL, 0, NULL, 0) == (s32)SCE_NP_ERROR_OFFLINE);
+    assert(sceNpManagerRequestTicket2((const SceNpId*)(uintptr_t)NPID, NULL,
+                                      (const char*)(uintptr_t)SVC, NULL, 0, NULL, 0)
+           == (s32)SCE_NP_ERROR_OFFLINE);
+    assert(sceNpManagerGetStatus((s32*)(uintptr_t)SIZE) == CELL_OK);
+    assert((s32)vm_read32(SIZE) == SCE_NP_MANAGER_STATUS_OFFLINE);
+
+    /* No ticket: zero bytes, and no parameter can be read from it. */
+    vm_write32(SIZE, 1234);
+    assert(sceNpManagerGetTicket(NULL, (u32*)(uintptr_t)SIZE) == CELL_OK);
+    assert(vm_read32(SIZE) == 0);
+    assert(sceNpManagerGetTicket(NULL, NULL) == (s32)SCE_NP_ERROR_INVALID_ARGUMENT);
+    assert(sceNpManagerGetTicketParam(0, (void*)(uintptr_t)PARAM) == (s32)SCE_NP_ERROR_INVALID_STATE);
+    assert(sceNpManagerGetTicketParam(12, (void*)(uintptr_t)PARAM) == (s32)SCE_NP_ERROR_INVALID_ARGUMENT);
+    assert(sceNpManagerGetTicketParam(0, NULL) == (s32)SCE_NP_ERROR_INVALID_ARGUMENT);
+
+    /* With a psnr server the request is accepted as before. */
+    s_online = 1;
+    assert(sceNpManagerRequestTicket((const SceNpId*)(uintptr_t)NPID, (const char*)(uintptr_t)SVC,
+                                     NULL, 0, NULL, 0) == CELL_OK);
+
+    free(vm_base);
+    puts("test_np_ticket_offline: all passed");
+    return 0;
+}
